; pcode_vm.s45 — research/pcode: the core of a p-code interpreter for the
; 45GS02 (ZP convention). The dispatch loop and the handlers LD, ST, ADD,
; BGEU (compare and branch), with SET, BR and RET to run whole functions.
;
; unsigned pcode_run1(const unsigned char *code, void *frame);
;   Runs p-code from code with its frame at frame; RET returns its value
;   (A, or A/X for a word) to the caller.
;
; Registers of the machine (base page, the program's scratch $08-$0F: no C
; code runs while it does):
;   IP   $08/$09  the p-code: the instruction stream is (IP),Z
;   FP   $0A/$0B  the frame: a variable is (FP),Y, Y its byte offset
;   PTR  $0C/$0D  an address being loaded / stored through
;   T0   $0E      a destination's offset;  T1 $0F an operand's offset
;   Z             the byte of the stream after IP being read: it runs on over
;                 instructions; IP is moved up only when Z reaches $E0 (at
;                 `next`), or at a branch (IP = target, Z = 0)
;
; Instructions: an opcode byte, then its operands, each a frame byte offset
; (a variable; a word is the offset and the next byte), an immediate or a
; target (the target's address, 2 bytes):
;   bit 7 of the opcode  the width: 0 a byte, 1 a word
;   bits 6-0             the operation: the handler (the table's entry)
; The dispatch (lda (IP),z; asl; tax; jmp (handlers,x)) shifts bit 7 into
; the carry, which tax and jmp leave alone: every handler starts with C set
; for the word form, and one handler serves both widths (a bcs to its word
; half). The table has 128 entries: bits 6-0.
;
;   $01 / $81  LD   d, a        d = *(a)            (a: a word, the address)
;   $02 / $82  ST   a, v        *(a) = v
;   $03 / $83  ADD  d, a, b     d = a + b
;   $04 / $84  BGEU a, b, t     if a >= b (unsigned): go to t
;   $05 / $85  SET  d, #imm     d = imm             (1 or 2 bytes)
;   $06        BR   t           go to t
;   $07 / $87  RET  a           return a

; no calls through pointers here (ln45's call graph)
.weak cc45.icallinfo
cc45.icallinfo = 1

IP  = $08
FP  = $0A
PTR = $0C
T0  = $0E
T1  = $0F

.global _pcode_run1
.segment "code"

proc _pcode_run1
    .zp_uses $10, $11, $12, $13
    .zp_clobbers $08, $09, $0A, $0B, $0C, $0D, $0E, $0F
    .zp_release $10, $11, $12, $13
    .reg_clobbers A, X, Y, Z
    .flag_clobbers C, N, Z, V
    lda $10
    sta IP
    lda $11
    sta IP+1
    lda $12
    sta FP
    lda $13
    sta FP+1
    ldz #0
    bra dispatch

; --- the dispatch loop -----------------------------------------------------
next:
    cpz #$E0                ; Z near its end: move IP up to it
    bcs @advance
dispatch:
    lda (IP),z              ; the opcode
    inz
    asl                     ; bit 7 (the width) -> C; x2 for the table
    tax
    jmp (handlers,x)
@advance:
    tza
    clc
    adc IP
    sta IP
    bcc @nc
    inc IP+1
@nc:
    ldz #0
    bra dispatch

; --- LD d, a: d = *(a) -------------------------------------------------------
op_ld:
    lda (IP),z              ; d
    inz
    sta T0
    lda (IP),z              ; a: the address, a word variable
    inz
    tay
    lda (FP),y
    sta PTR
    iny
    lda (FP),y
    sta PTR+1
    ldy #0
    lda (PTR),y
    bcs @ld_w
    ldy T0
    sta (FP),y
    jmp next
@ld_w:
    tax                     ; the low byte
    iny
    lda (PTR),y
    ldy T0
    iny
    sta (FP),y
    dey
    txa
    sta (FP),y
    jmp next

; --- ST a, v: *(a) = v -----------------------------------------------------
op_st:
    lda (IP),z              ; a: the address
    inz
    tay
    lda (FP),y
    sta PTR
    iny
    lda (FP),y
    sta PTR+1
    lda (IP),z              ; v
    inz
    tay
    lda (FP),y
    bcs @st_w
    ldy #0
    sta (PTR),y
    jmp next
@st_w:
    tax                     ; the low byte
    iny
    lda (FP),y
    ldy #1
    sta (PTR),y
    dey
    txa
    sta (PTR),y
    jmp next

; --- ADD d, a, b: d = a + b ------------------------------------------------
op_add:
    lda (IP),z              ; d
    inz
    sta T0
    lda (IP),z              ; a
    inz
    sta T1
    lda (IP),z              ; b
    inz
    sta PTR
    bcs @add_w
    ldy T1
    lda (FP),y
    ldy PTR
    clc
    adc (FP),y
    ldy T0
    sta (FP),y
    jmp next
@add_w:
    ldy T1
    lda (FP),y
    ldy PTR
    clc
    adc (FP),y
    ldy T0
    sta (FP),y              ; (the low byte first: d may be a or b, whose
    ldy T1                  ; high bytes are read after it)
    iny
    lda (FP),y
    ldy PTR
    iny
    adc (FP),y
    ldy T0
    iny
    sta (FP),y
    jmp next

; --- BGEU a, b, t: if a >= b (unsigned) go to t ----------------------------
op_bgeu:
    lda (IP),z              ; a
    inz
    sta T1
    lda (IP),z              ; b
    inz
    sta PTR
    bcs @bgeu_w
    ldy T1
    lda (FP),y
    ldy PTR
    cmp (FP),y              ; C = a >= b
    bcs take
    bra skip
@bgeu_w:
    ldy T1
    lda (FP),y
    ldy PTR
    cmp (FP),y              ; the low bytes' borrow into the high ones
    ldy T1
    iny
    lda (FP),y
    ldy PTR
    iny
    sbc (FP),y              ; C = a >= b
    bcs take
skip:
    inz                     ; past the target
    inz
    jmp next
take:
    lda (IP),z              ; the target
    inz
    tax
    lda (IP),z
    sta IP+1
    stx IP
    ldz #0
    jmp dispatch

; --- SET d, #imm -----------------------------------------------------------
op_set:
    lda (IP),z              ; d
    inz
    tay
    lda (IP),z              ; the immediate's low byte
    inz
    sta (FP),y
    bcs @set_w
    jmp next
@set_w:
    iny
    lda (IP),z
    inz
    sta (FP),y
    jmp next

; --- BR t ------------------------------------------------------------------
op_br:
    lda (IP),z
    inz
    tax
    lda (IP),z
    sta IP+1
    stx IP
    ldz #0
    jmp dispatch

; --- RET a: return a to pcode_run's caller ----------------------------------
op_ret:
    lda (IP),z              ; a
    tay
    lda (FP),y
    bcs @ret_w
    ldx #0
    rts
@ret_w:
    tax
    iny
    lda (FP),y
    pha
    txa
    plx
    rts

op_bad:
    lda #$FF                ; an opcode with no handler: return $FFFF
    tax
    rts

; the handlers by opcode bits 6-0 (in the proc: its labels are its own)
handlers:
    .word op_bad, op_ld, op_st, op_add, op_bgeu, op_set, op_br, op_ret
    ; $08-$7F: none yet
    .word op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad
    .word op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad
    .word op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad
    .word op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad
    .word op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad
    .word op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad
    .word op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad
    .word op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad
    .word op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad
    .word op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad
    .word op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad
    .word op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad
    .word op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad
    .word op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad
    .word op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad, op_bad

    .func_flags zp_call
    endproc
