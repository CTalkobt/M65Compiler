; pcode_jit_abs.s45 — research/pcode: option B, the first prototype (variables at
; absolute addresses; pcode_jit.s45 has them in the base page). The p-code of a
; block is translated, the first time it runs, into 45GS02 code in a cache
; (a template per instruction, its variables at fixed addresses: the frame
; is the same at every run, as a function's static block is), and run from
; there. A branch leaves its block through a stub (jsr jit_miss; .word
; target): the first time it is taken, jit_miss finds or translates the
; target's block and makes the stub a jmp to it (chaining), so code that runs
; again runs from the cache alone.
;
; unsigned pcode_jit(const unsigned char *code, void *frame);
;   As pcode_run (pcode_vm.s45), for the instructions translated here:
;   SET.w, ADD2.w, INC.w, LDE.w (s 0 or 1), BGEU.w, BLTU.w, BR, RET.w
;   (another: returns $FFFF). The cache is 1 KB, 32 blocks: when full it is
;   emptied. pcode_jit_flush() empties it.
;
; Base page (the program's scratch, and the library's temps):
;   IP  $08/$09  the p-code being translated: (IP),Z
;   FP  $0A/$0B  the frame (the templates' variables: FP + their offset)
;   PTR $0C/$0D  the templates' element address
;   CP  $0E/$0F  where the block being translated goes: (CP),Y
;   (jt, the native address to jump to, is absolute: jmp (abs) has no
;   base-page mode, jmp ($F6) would read page 0)
;   SA  $F8/$F9  a stub's address (jit_miss)

; no calls through pointers here (ln45's call graph)
.weak cc45.icallinfo
cc45.icallinfo = 1

IP  = $08
FP  = $0A
PTR = $0C
CP  = $0E
SA  = $F8

NBLOCKS = 32
CACHE   = 1024
MAXBLK  = 120                   ; the largest block translated (bytes of code)

.global _pcode_jita, _pcode_jita_flush, _pcode_jita_used
.segment "code"

; emit a byte: (CP),Y = v; Y++
.macro EMIT v
    lda #(v)
    sta (CP),y
    iny
.endmacro

proc _pcode_jita
    .zp_uses $10, $11, $12, $13
    .zp_clobbers $08, $09, $0A, $0B, $0C, $0D, $0E, $0F, $F8, $F9
    .zp_release $10, $11, $12, $13
    .reg_clobbers A, X, Y, Z
    .flag_clobbers C, N, Z, V
    lda $10
    sta IP
    lda $11
    sta IP+1
    lda $12
    sta FP
    lda $13
    sta FP+1
    lda used                    ; (first use: the cache empty)
    ora used+1
    bne go
    jsr flush
go:
    jsr block_at                ; jt = the native code of the block at IP
    jmp (jt)

; jit_miss: a stub's jsr: the target (the word after the jsr) found or
; translated, the stub made a jmp to it, and run
jit_miss:
    pla                         ; the return address: the stub + 2
    sec
    sbc #2
    sta SA
    pla
    sbc #0
    sta SA+1
    ldy #3                      ; the target: the stub + 3
    lda (SA),y
    sta IP
    iny
    lda (SA),y
    sta IP+1
    jsr block_at
    ldy #0                      ; the stub: jmp jt
    lda #$4C
    sta (SA),y
    iny
    lda jt
    sta (SA),y
    iny
    lda jt+1
    sta (SA),y
    jmp (jt)

; block_at: jt = the native code of the block at IP (translated if new)
block_at:
    ldx #0
@find:
    cpx nblk
    beq @new
    lda tag_lo,x
    cmp IP
    bne @next
    lda tag_hi,x
    cmp IP+1
    bne @next
    lda nat_lo,x
    sta jt
    lda nat_hi,x
    sta jt+1
    rts
@next:
    inx
    bra @find
@new:
    ; room for one more (a block, and an entry): else the cache emptied
    lda nblk
    cmp #NBLOCKS
    bcs @full
    lda used
    clc
    adc #MAXBLK
    lda used+1
    adc #0
    cmp #>(CACHE - MAXBLK)
    bcc @room
@full:
    jsr flush
@room:
    ldx nblk
    lda IP
    sta tag_lo,x
    lda IP+1
    sta tag_hi,x
    lda #<cache                 ; CP = cache + used
    clc
    adc used
    sta CP
    sta nat_lo,x
    sta jt
    lda #>cache
    adc used+1
    sta CP+1
    sta nat_hi,x
    sta jt+1
    inc nblk
    jsr translate               ; Y = the block's bytes
    tya
    clc
    adc used
    sta used
    bcc @done
    inc used+1
@done:
    rts

flush:
    lda #0
    sta nblk
    sta used
    sta used+1
    rts

; translate: the block at IP into (CP),Y; returns Y = its bytes
translate:
    ldy #0
    ldz #0
@inst:
    lda (IP),z                  ; the opcode
    inz
    cmp #$85
    beq @set
    cmp #$89
    beq @add2
    cmp #$8A
    beq @inc
    cmp #$8B
    beq @lde
    cmp #$84
    beq @bgeu
    cmp #$8C
    beq @bltu
    cmp #$06
    beq @br
    cmp #$87
    beq @ret
    ; not translated: the block returns $FFFF
    EMIT $A9                    ; lda #$FF
    EMIT $FF
    EMIT $AA                    ; tax
    EMIT $60                    ; rts
    rts

@set:                           ; SET.w d, #imm: lda #lo; sta d; lda #hi; sta d+1
    lda (IP),z
    inz
    tax                         ; d
    EMIT $A9
    lda (IP),z
    inz
    sta (CP),y
    iny
    EMIT $8D
    txa
    jsr emit_var
    EMIT $A9
    lda (IP),z
    inz
    sta (CP),y
    iny
    EMIT $8D
    txa
    inc a
    jsr emit_var
    jmp @inst

@add2:                          ; ADD2.w d, a: d = d + a
    lda (IP),z
    inz
    sta t_d
    lda (IP),z
    inz
    sta t_a
    EMIT $AD                    ; lda d
    lda t_d
    jsr emit_var
    EMIT $18                    ; clc
    EMIT $6D                    ; adc a
    lda t_a
    jsr emit_var
    EMIT $8D                    ; sta d
    lda t_d
    jsr emit_var
    EMIT $AD                    ; lda d+1
    lda t_d
    inc a
    jsr emit_var
    EMIT $6D                    ; adc a+1
    lda t_a
    inc a
    jsr emit_var
    EMIT $8D                    ; sta d+1
    lda t_d
    inc a
    jsr emit_var
    jmp @inst

@inc:                           ; INC.w d: inc d; bne +3; inc d+1
    lda (IP),z
    inz
    sta t_d
    EMIT $EE
    lda t_d
    jsr emit_var
    EMIT $D0
    EMIT 3
    EMIT $EE
    lda t_d
    inc a
    jsr emit_var
    jmp @inst

@lde:                           ; LDE.w d, b, i, s (s 0 or 1)
    lda (IP),z
    inz
    sta t_d
    lda (IP),z
    inz
    sta t_a                     ; b
    lda (IP),z
    inz
    sta t_b                     ; i
    lda (IP),z
    inz
    sta t_s
    EMIT $AD                    ; lda i
    lda t_b
    jsr emit_var
    lda t_s
    beq @l0
    EMIT $0A                    ; asl
@l0:
    EMIT $AA                    ; tax
    EMIT $AD                    ; lda i+1
    lda t_b
    inc a
    jsr emit_var
    lda t_s
    beq @l1
    EMIT $2A                    ; rol
@l1:
    EMIT $A8                    ; tay
    EMIT $8A                    ; txa
    EMIT $18                    ; clc
    EMIT $6D                    ; adc b
    lda t_a
    jsr emit_var
    EMIT $85                    ; sta PTR
    EMIT PTR
    EMIT $98                    ; tya
    EMIT $6D                    ; adc b+1
    lda t_a
    inc a
    jsr emit_var
    EMIT $85                    ; sta PTR+1
    EMIT PTR+1
    EMIT $A0                    ; ldy #0
    EMIT 0
    EMIT $B1                    ; lda (PTR),y
    EMIT PTR
    EMIT $8D                    ; sta d
    lda t_d
    jsr emit_var
    EMIT $C8                    ; iny
    EMIT $B1                    ; lda (PTR),y
    EMIT PTR
    EMIT $8D                    ; sta d+1
    lda t_d
    inc a
    jsr emit_var
    jmp @inst

@bgeu:                          ; BGEU.w a, b, t: taken when C is set
    lda #$90                    ; bcc: over the taken stub
    bra @cmpbr
@bltu:                          ; BLTU.w a, b, t: taken when C is clear
    lda #$B0                    ; bcs: over the taken stub
@cmpbr:
    sta t_s
    lda (IP),z
    inz
    sta t_a
    lda (IP),z
    inz
    sta t_b
    EMIT $AD                    ; lda a
    lda t_a
    jsr emit_var
    EMIT $CD                    ; cmp b
    lda t_b
    jsr emit_var
    EMIT $AD                    ; lda a+1
    lda t_a
    inc a
    jsr emit_var
    EMIT $ED                    ; sbc b+1
    lda t_b
    inc a
    jsr emit_var
    lda t_s                     ; bcc / bcs +5: the not-taken way
    sta (CP),y
    iny
    EMIT 5
    jsr emit_stub_target        ; the taken stub: the target in the p-code
    jsr emit_stub_next          ; the not-taken stub: the next instruction
    rts

@br:                            ; BR t: the stub
    jsr emit_stub_target
    rts

@ret:                           ; RET.w a: lda a; ldx a+1; rts
    lda (IP),z
    inz
    sta t_a
    EMIT $AD
    lda t_a
    jsr emit_var
    EMIT $AE                    ; ldx a+1
    lda t_a
    inc a
    jsr emit_var
    EMIT $60
    rts

; the address of a variable: FP + A, at (CP),Y (2 bytes)
emit_var:
    clc
    adc FP
    sta (CP),y
    iny
    lda FP+1
    adc #0
    sta (CP),y
    iny
    rts

; a stub to the target at (IP),Z (Z past it): jsr jit_miss; .word target
emit_stub_target:
    jsr emit_jsr
    lda (IP),z
    inz
    sta (CP),y
    iny
    lda (IP),z
    inz
    sta (CP),y
    iny
    rts

; a stub to the next instruction (IP + Z)
emit_stub_next:
    jsr emit_jsr
    tza
    clc
    adc IP
    sta (CP),y
    iny
    lda IP+1
    adc #0
    sta (CP),y
    iny
    rts

emit_jsr:
    EMIT $20
    lda #<jit_miss
    sta (CP),y
    iny
    lda #>jit_miss
    sta (CP),y
    iny
    rts

    .func_flags zp_call
    endproc

; void pcode_jit_flush(void): empty the cache
proc _pcode_jita_flush
    .reg_clobbers A
    .flag_clobbers N, Z
    lda #0
    sta nblk
    sta used
    sta used+1
    rts
    .func_flags zp_call
    endproc

; unsigned pcode_jit_used(void): the cache's bytes in use
proc _pcode_jita_used
    .reg_clobbers A, X
    .flag_clobbers N, Z
    lda used
    ldx used+1
    rts
    .func_flags zp_call
    endproc

.segment "bss"
jt:     .res 2
nblk:   .res 1
used:   .res 2
t_d:    .res 1
t_a:    .res 1
t_b:    .res 1
t_s:    .res 1
tag_lo: .res NBLOCKS
tag_hi: .res NBLOCKS
nat_lo: .res NBLOCKS
nat_hi: .res NBLOCKS
.global _pcode_jita_cache
_pcode_jita_cache:
cache:  .res CACHE
