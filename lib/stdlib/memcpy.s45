; memcpy.s — Copy memory area
;
; void *memcpy(void *dest, void *src, int n);
;   Copies n bytes from src to dest. Areas must not overlap.
;   Returns dest.

.global _memcpy
.extern __sp_base

.segment "code"

proc _memcpy, W#_p_dest, W#_p_src, W#_p_n
    .var _fp = 0
    ; Load all params into ZP (same pattern as memset)
    tsx
    lda __sp_base+_p_dest, x     ; dest lo
    sta $02
    lda __sp_base+_p_dest+1, x   ; dest hi
    sta $03
    lda __sp_base+_p_src, x      ; src lo
    sta $04
    lda __sp_base+_p_src+1, x    ; src hi
    sta $05
    lda __sp_base+_p_n, x        ; count lo
    sta $06
    lda __sp_base+_p_n+1, x      ; count hi
    sta $07

    ldy #0
@loop:
    lda $07
    bne @do_copy
    lda $06
    beq @done
@do_copy:
    lda ($04),y         ; load from src
    sta ($02),y         ; store to dest
    iny
    bne @no_inc
    inc $03             ; dest page
    inc $05             ; src page
@no_inc:
    lda $06
    bne @dec_lo
    dec $07
@dec_lo:
    dec $06
    bra @loop
@done:
    ; return dest (lo in A, hi in X)
    lda $03             ; hi
    pha
    lda $02             ; lo
    plx                 ; X = hi
    rtn #0
    endproc
