; atoi.s — Convert string to integer
;
; int atoi(char *s);
;   Parses a decimal integer from a NUL-terminated string.
;   Skips leading whitespace ($20, $09-$0D).
;   Recognizes optional leading '-' for negative values.
;   Returns the 16-bit integer value in .AX.

.global _atoi
.extern __sp_base

.segment "code"

proc _atoi, W#_p_s
    .var _fp = 0
    ; Load string pointer to ZP via TSX
    tsx
    lda __sp_base+_p_s, x
    sta $02
    lda __sp_base+_p_s+1, x
    sta $03
    ; $04 = sign flag, $05 = digit scratch
    ldy #0

    ; --- Skip leading whitespace ---
@skipws:
    lda ($02),y
    cmp #$20
    beq @skipnext
    cmp #$09
    bcc @checksign
    cmp #$0e
    bcc @skipnext
    bra @checksign
@skipnext:
    iny
    bne @skipws
    bra @retzero

    ; --- Check for sign ---
@checksign:
    stz $04
    cmp #$2d            ; '-'
    bne @checkplus
    inc $04
    iny
    bra @startnum
@checkplus:
    cmp #$2b            ; '+'
    bne @startnum
    iny
@startnum:
    lda #0
    sta $06
    sta $07             ; $06/$07 = result (lo/hi)

    ; --- Parse digits ---
@digit:
    lda ($02),y
    sec
    sbc #$30
    bcc @done
    cmp #10
    bcs @done
    sta $05

    ; result = result * 10 via hardware multiplier
    lda $06
    sta $d770
    lda $07
    sta $d771
    lda #0
    sta $d772
    sta $d773
    lda #10
    sta $d774
    lda #0
    sta $d775
    sta $d776
    sta $d777
    lda $d778
    sta $06
    lda $d779
    sta $07

    ; result += digit
    lda $06
    clc
    adc $05
    sta $06
    lda $07
    adc #0
    sta $07

    iny
    bne @digit

@done:
    lda $04
    beq @positive
    sec
    lda #0
    sbc $06
    pha
    lda #0
    sbc $07
    tax
    pla
    rtn #0
@positive:
    lda $06
    ldx $07
    rtn #0
@retzero:
    lda #0
    ldx #0
    rtn #0
    endproc
