; putchar.s — Write a character to screen via KERNAL CHROUT
;
; int putchar(int c);
;   Writes the low byte of c to the screen using KERNAL $FFD2.
;   Returns c.
;
; The kernal clobbers A, X, Y, Z and flags. We save/restore Z
; because the compiler uses it as a temp register (TAZ/TZA pattern).

.global _putchar
.extern __sp_base

.segment "code"

proc _putchar, W#_p_c
    .var _fp = 0
    ; Load param via TSX + absolute addressing
    tsx
    lda __sp_base+_p_c, x        ; c lo (character)
    phz
    jsr $FFD2
    plz
    ; return c (lo in A, hi in X)
    tsx
    lda __sp_base+_p_c+1, x      ; hi
    pha
    lda __sp_base+_p_c, x        ; lo
    plx                           ; X = hi
    rtn #0
    endproc
