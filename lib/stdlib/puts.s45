; puts.s — Write a NUL-terminated string to screen
;
; int puts(char *s);
;   Writes string s to the screen via KERNAL CHROUT, then a newline.
;   Returns 0 on success.

.global _puts
.extern __sp_base

.segment "code"

proc _puts, W#_p_s
    .var _fp = 0
    ; Load string pointer from stack into $FB/$FC
    tsx
    lda __sp_base+_p_s, x
    sta $FB
    lda __sp_base+_p_s+1, x
    sta $FC
    ; Print each character via KERNAL CHROUT
    ldy #0
@loop:
    lda ($FB),y
    beq @done
    phz
    phy
    jsr $FFD2
    ply
    plz
    iny
    bne @loop
@done:
    ; Print newline
    lda #$0D
    phz
    jsr $FFD2
    plz
    lda #0
    tax
    rtn #0
    endproc
