; clock.s — Return jiffy clock ticks (16-bit)
;
; clock_t clock(void);
;   Returns low 16 bits of the 24-bit KERNAL jiffy clock.
;   KERNAL RDTIM ($FFDE) returns A=hi, X=mid, Y=lo.

.global _clock
.extern __bp_rom
.extern __bp_prog

.segment "code"

proc _clock
    jsr __bp_rom
    jsr $FFDE       ; RDTIM: A=hi, X=mid, Y=lo
    jsr __bp_prog
    tya             ; A = lo byte
                    ; X = mid byte (already set)
    rtn #0
    endproc
