; strcpy.s — Copy string
;
; char *strcpy(char *dest, char *src);
;   Copies src including NUL terminator to dest. Returns dest.

.global _strcpy
.extern __sp_base

.segment "code"

proc _strcpy, W#_p_dest, W#_p_src
    .var _fp = 0
    ; Load all params via TSX + absolute addressing
    tsx
    lda __sp_base+_p_dest, x     ; dest lo
    sta $02
    lda __sp_base+_p_dest+1, x   ; dest hi
    sta $03
    lda __sp_base+_p_src, x      ; src lo
    sta $04
    lda __sp_base+_p_src+1, x    ; src hi
    sta $05

    ldy #0
@loop:
    lda ($04),y
    sta ($02),y
    beq @done
    iny
    bne @loop
    inc $03
    inc $05
    bra @loop
@done:
    ; return dest (lo in A, hi in X)
    tsx
    lda __sp_base+_p_dest+1, x   ; hi
    pha
    lda __sp_base+_p_dest, x     ; lo
    plx                           ; X = hi
    rtn #0
    endproc
