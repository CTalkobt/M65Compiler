; abs.s — Integer absolute value
;
; int abs(int value);
;   Returns the absolute value of a 16-bit signed integer.

.global _abs
.extern __sp_base

.segment "code"

proc _abs, W#_p_value
    .var _fp = 0
    ; Load param via TSX into ZP
    tsx
    lda __sp_base+_p_value, x
    sta $02
    lda __sp_base+_p_value+1, x
    sta $03
    ; Check sign bit
    lda $03
    bpl @pos
    ; Negate: complement and add 1
    lda $02
    eor #$FF
    clc
    adc #1
    pha
    lda $03
    eor #$FF
    adc #0
    tax
    pla
    rtn #0
@pos:
    lda $02
    ldx $03
    rtn #0
    endproc
