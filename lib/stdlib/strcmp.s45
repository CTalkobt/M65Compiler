; strcmp.s — Compare two strings
;
; int strcmp(char *s1, char *s2);
;   Returns 0 if equal, <0 if s1 < s2, >0 if s1 > s2.

.global _strcmp
.extern __sp_base

.segment "code"

proc _strcmp, W#_p_s1, W#_p_s2
    .var _fp = 0
    ; Load both pointers to ZP via TSX
    tsx
    lda __sp_base+_p_s1, x
    sta $02
    lda __sp_base+_p_s1+1, x
    sta $03
    lda __sp_base+_p_s2, x
    sta $04
    lda __sp_base+_p_s2+1, x
    sta $05
    ldy #0
@loop:
    lda ($02),y
    cmp ($04),y
    bne @diff
    cmp #0
    beq @equal
    iny
    bne @loop
    inc $03
    inc $05
    bra @loop
@equal:
    lda #0
    ldx #0
    rtn #0
@diff:
    bcs @greater
    lda #$FF
    ldx #$FF
    rtn #0
@greater:
    lda #1
    ldx #0
    rtn #0
    endproc
