; ltoa.s — Convert 32-bit long to string
;
; char *ltoa(long value, char *str, int base);
;   Converts a 32-bit integer to a NUL-terminated string in the
;   given base (2-36). For base 10, negative values get a '-' prefix.
;   Returns str.
;
;   Strategy: divide repeatedly by base using MEGA65 hardware divider
;   (full 32-bit), push digit chars onto hardware stack in reverse,
;   then pop them into the output buffer in correct order.
;
;   Uses MEGA65 hardware divider (VHDL): $D770/$D774 inputs, $D76C quotient.
;   ZP usage: $02-$08 (saved/restored to stack)

.global _ltoa
.extern __sp_base

.segment "code"

proc _ltoa, D#_p_value, W#_p_str, W#_p_base
    .var _fp = 0
    ; Save ZP $02-$0A (9 bytes)
    lda $02
    pha
    lda $03
    pha
    lda $04
    pha
    lda $05
    pha
    lda $06
    pha
    lda $07
    pha
    lda $08
    pha
    lda $09
    pha
    lda $0A
    pha

    ; Load params via TSX (+9 for the 9 PHA saves)
    tsx
    lda __sp_base+_p_value+9, x
    sta $02
    lda __sp_base+_p_value+10, x
    sta $03
    lda __sp_base+_p_value+11, x
    sta $04
    lda __sp_base+_p_value+12, x
    sta $05
    lda __sp_base+_p_base+9, x
    sta $06
    lda __sp_base+_p_base+10, x
    sta $07
    lda __sp_base+_p_str+9, x
    sta $09
    lda __sp_base+_p_str+10, x
    sta $0A

    lda #0
    sta $08             ; digit count (NOT stz — STZ stores Z reg, not zero)
    ldy #0              ; Y = write index into output

    ; --- Validate base (2-36) ---
    lda $07
    bne @valid          ; high byte nonzero => base >= 256, ok
    lda $06
    cmp #2
    bcs @valid
    ; base < 2: write "0\0" and return
    lda #$30
    sta ($09),y
    iny
    lda #0
    sta ($09),y
    lda $09
    ldx $0A
    bra @restore

@valid:
    ; --- Handle negative for base 10 only ---
    lda $06
    cmp #10
    bne @poscheck
    lda $07
    bne @poscheck
    ; base == 10: check sign bit (byte 3)
    lda $05
    bpl @poscheck
    ; Negative: write '-' and negate 32-bit value
    lda #$2d
    sta ($09),y
    iny
    sec
    lda #0
    sbc $02
    sta $02
    lda #0
    sbc $03
    sta $03
    lda #0
    sbc $04
    sta $04
    lda #0
    sbc $05
    sta $05
@poscheck:

    ; --- Check for zero ---
    lda $02
    ora $03
    ora $04
    ora $05
    bne @extract
    lda #$30
    sta ($09),y
    iny
    bra @nulterm

    ; --- Extract digits: divide 32-bit value by base ---
    ; MEGA65 VHDL: dividend $D770, divisor $D774, quotient $D76C
    ; Remainder = value - quotient * base (computed in software)
@extract:
    ; Save value lo byte for remainder calculation
    lda $02
    pha

    ; Dividend ($D770-$D773)
    lda $02
    sta $d770
    lda $03
    sta $d771
    lda $04
    sta $d772
    lda $05
    sta $d773
    ; Divisor ($D774-$D777) — base, 16-bit zero-extended
    lda $06
    sta $d774
    lda $07
    sta $d775
    lda #0
    sta $d776
    sta $d777

@waitdiv:
    bit $d70f
    bne @waitdiv

    ; Compute remainder = value - quotient * base
    ; Write quotient to $D770, base still in $D774
    lda $d76c
    sta $d770
    lda $d76d
    sta $d771
    lda $d76e
    sta $d772
    lda $d76f
    sta $d773
    ; Product lo byte at $D778 (combinational)
    ; Remainder = saved_value_lo - product_lo (single digit fits in byte)
    pla                     ; saved value lo
    sec
    sbc $d778               ; A = remainder (0-35)
    cmp #10
    bcs @hexdig
    clc
    adc #$30            ; '0'
    bra @pushdig
@hexdig:
    sec
    sbc #10
    clc
    adc #$41            ; PETSCII lowercase 'a'
@pushdig:
    pha                 ; push digit char onto hardware stack
    inc $08             ; count it

    ; Quotient ($D76C-$D76F) becomes new value
    lda $d76c
    sta $02
    lda $d76d
    sta $03
    lda $d76e
    sta $04
    lda $d76f
    sta $05

    ; Continue while value != 0
    ora $02
    ora $03
    ora $04
    bne @extract

    ; --- Pop digits into output buffer (correct order) ---
@poploop:
    pla
    sta ($09),y
    iny
    dec $08
    bne @poploop

@nulterm:
    lda #0
    sta ($09),y

    lda $09
    ldx $0A
@restore:
    ; Return value in AX preserved (PLZ doesn't touch A/X).
    plz
    stz $0A
    plz
    stz $09
    plz
    stz $08
    plz
    stz $07
    plz
    stz $06
    plz
    stz $05
    plz
    stz $04
    plz
    stz $03
    plz
    stz $02
    rts
    endproc
