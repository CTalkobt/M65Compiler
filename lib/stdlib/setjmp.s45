; setjmp.s — Non-local jumps
;
; int setjmp(jmp_buf env);
;   Saves return address and stack pointer into env[0..3].
;   Returns 0.
;
; void longjmp(jmp_buf env, int val);
;   Restores SP and jumps to saved return address.
;   setjmp appears to return val (or 1 if val==0).
;
; jmp_buf layout:
;   [0] PC low
;   [1] PC high
;   [2] SPL
;   [3] SPH

.global _setjmp
.global _longjmp
.extern __sp_base
.extern __zp_scratch

.segment "code"

; --- setjmp ---

proc _setjmp, W#_p_env
    .var _fp = 0

    ; Get pointer to jmp_buf via TSX
    tsx
    lda __sp_base+_p_env, x
    sta __zp_scratch
    lda __sp_base+_p_env+1, x
    sta __zp_scratch+1

    ; Save return address from hardware stack
    ; After JSR: SP+1=PCL, SP+2=PCH. __sp_base+X = SP+1.
    ; But params were pushed before JSR, so ret addr is at different offset.
    ; With proc _setjmp, W#_p_env: _p_env=2 means ret at offset 0-1.
    ; __sp_base+0+X = SP+1 = PCL, __sp_base+1+X = SP+2 = PCH
    lda __sp_base, x         ; PCL (at SP+1)
    ldy #0
    sta (__zp_scratch), y
    lda __sp_base+1, x       ; PCH (at SP+2)
    iny
    sta (__zp_scratch), y

    ; Save stack pointer
    txa                      ; A = SPL
    ldy #2
    sta (__zp_scratch), y    ; SPL
    tsy
    tya                      ; A = SPH
    ldy #3
    sta (__zp_scratch), y    ; SPH

    ; Return 0
    lda #0
    tax
    rtn #0
    endproc

; --- longjmp ---

proc _longjmp, W#_p_env, W#_p_val
    .var _fp = 0

    ; Load val via TSX
    tsx
    lda __sp_base+_p_val, x
    sta __zp_scratch+2
    lda __sp_base+_p_val+1, x
    sta __zp_scratch+3

    ; Check if val == 0 -> force to 1
    lda __zp_scratch+2
    ora __zp_scratch+3
    bne @nonzero
    lda #1
    sta __zp_scratch+2
    lda #0
    sta __zp_scratch+3
@nonzero:

    ; Load jmp_buf pointer via TSX
    tsx
    lda __sp_base+_p_env, x
    sta __zp_scratch
    lda __sp_base+_p_env+1, x
    sta __zp_scratch+1

    ; Restore SP
    ldy #3
    lda (__zp_scratch), y   ; SPH
    tay
    tys                     ; restore SPH
    ldy #2
    lda (__zp_scratch), y   ; SPL
    tax
    txs                     ; restore SPL

    ; Push saved return address back onto hardware stack
    ldy #1
    lda (__zp_scratch), y   ; PCH
    pha
    ldy #0
    lda (__zp_scratch), y   ; PCL
    pha

    ; Load return value into AX
    lda __zp_scratch+2
    ldx __zp_scratch+3

    ; RTS will jump to saved return address + 1
    rts
    endproc
