; div.s — Integer division with quotient and remainder
;
; div_t div(int numer, int denom);
;   Returns div_t { int quot; int rem; } via hidden return pointer.
;   Uses MEGA65 hardware divider (VHDL register layout).
;   Dividend/divisor at $D770/$D774, quotient at $D76C.
;   Remainder computed as: numer - quot * denom (no hw remainder register).

.global _div
.extern __sp_base
.extern __zp_scratch

.segment "code"

proc _div, W#_p___ret_ptr, W#_p_numer, W#_p_denom
    .var _fp = 0

    ; Load all params via TSX
    tsx
    lda __sp_base+_p___ret_ptr, x
    sta $02                     ; $02/$03 = return pointer
    lda __sp_base+_p___ret_ptr+1, x
    sta $03
    lda __sp_base+_p_numer, x
    sta $04                     ; $04/$05 = numer
    lda __sp_base+_p_numer+1, x
    sta $05
    lda __sp_base+_p_denom, x
    sta $06                     ; $06/$07 = denom
    lda __sp_base+_p_denom+1, x
    sta $07

    ; Track signs: $08 = numer_neg, $09 = quot_sign_xor
    lda #0
    sta $08
    sta $09

    ; --- abs(numer) ---
    lda $05                     ; high byte
    bpl @numer_pos
    inc $08                     ; numer was negative
    inc $09                     ; flip result sign
    sec
    lda #0
    sbc $04
    sta $04
    lda #0
    sbc $05
    sta $05
@numer_pos:

    ; Store abs(numer) to dividend ($D770) and save for remainder
    lda $04
    sta $D770
    sta __zp_scratch
    lda $05
    sta $D771
    sta __zp_scratch+1
    lda #0
    sta $D772
    sta $D773

    ; --- abs(denom) ---
    lda $07
    bpl @denom_pos
    lda $09
    eor #1
    sta $09
    sec
    lda #0
    sbc $06
    sta $06
    lda #0
    sbc $07
    sta $07
@denom_pos:

    ; Store abs(denom) to divisor ($D774)
    lda $06
    sta $D774
    lda $07
    sta $D775
    lda #0
    sta $D776
    sta $D777

    ; Wait for hardware divider
@wait:
    bit $D70F
    bne @wait

    ; --- Quotient ---
    lda $D76C
    ldx $D76D
    ; Apply sign
    ldy $09
    beq @quot_pos
    eor #$FF
    clc
    adc #1
    pha
    txa
    eor #$FF
    adc #0
    tax
    pla
@quot_pos:
    ; Store quot via return pointer ($02/$03)
    ldy #0
    sta ($02),y
    iny
    txa
    sta ($02),y

    ; --- Remainder = abs(numer) - abs(quot) * abs(denom) ---
    ; Write abs(quotient) to $D770 for multiply
    lda $D76C
    sta $D770
    lda $D76D
    sta $D771
    lda #0
    sta $D772
    sta $D773
    ; Product at $D778 (combinational)
    lda __zp_scratch
    sec
    sbc $D778
    pha
    lda __zp_scratch+1
    sbc $D779
    tax
    pla
    ; Apply numer sign to remainder
    ldy $08
    beq @rem_pos
    eor #$FF
    clc
    adc #1
    pha
    txa
    eor #$FF
    adc #0
    tax
    pla
@rem_pos:
    ; Store rem via return pointer
    ldy #2
    sta ($02),y
    iny
    txa
    sta ($02),y

    ; Return pointer in AX
    lda $02
    ldx $03
    rtn #0
    endproc
