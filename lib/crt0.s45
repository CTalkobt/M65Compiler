; crt0.s — Default C Runtime Startup for cc45
;
; This is the entry point for all C programs. The linker's -basic
; stub (or direct-compile wrapper) calls __init, which:
;   1. Saves the stack pointer (for clean return to caller/BASIC)
;   2. Calls _init_features (weak — overridable for platform setup)
;   3. Calls _main
;   4. Restores SP and returns to caller
;
; To override the init hook, provide a strong _init_features in another
; object file (e.g., crt0_mega65.s) and link it before or after crt0.
;
; Usage (relocatable):
;   ln45 -prg crt0.o45 main.o45 -o program.prg

.global __init
.global __exit
.global __abort
.global __sp_base
.global __bp_rom
.global __bp_prog
.extern __zp_page
.extern __zp_page_isr
.global __isr_depth
.extern __stack_top
.weak _init_features
.extern _main

.segment "init"

__sp_base = $0101

; Exit status, left in the ROM's zero page at $FD/$FE (BASIC 65 leaves these
; alone; a BASIC caller can PEEK(253)+256*PEEK(254), test harnesses read it
; from a memory dump): main's return value / exit()'s argument, $FFFE after
; abort(), and $FFFF (set at startup) if the program never reached __exit.
__exit_status = $FD

__init:
    ; Save caller's stack pointer for clean return
    tsx
    stx __saved_spl + 1
    tsy
    sty __saved_sph + 1

    ; Enable MEGA65 I/O — GS knock must precede hardware register access
    lda #$47            ; 'G'
    sta $D02F
    lda #$53            ; 'S'
    sta $D02F

    ; "Never reached __exit" until the program exits (B is still 0 here)
    lda #$FF
    sta __exit_status
    sta __exit_status + 1

    ; Move the base page (zero page) to a private page-aligned block at the
    ; end of BSS. The program never touches the ROM's zero page, so nothing
    ; needs saving; ROM calls switch back to page 0 via __bp_rom/__bp_prog.
    lda #>__zp_page
    tab

    ; Move the CPU stack to a 16-bit stack at __stack_top (E flag clear).
    ; Interrupts are masked while SPH/SPL change, then the caller's I flag
    ; is restored (PLP would also reload E, so it isn't used here).
    php
    pla
    sta __saved_p + 1
    ldy #>__stack_top
    beq @stack8
    sei
    cle
    tys
    ldx #<__stack_top
    txs
    and #$04            ; caller's I flag
    bne @stack8
    cli
@stack8:

    jsr _init_features
    jsr _main

    ; Fall through to __exit
__exit:
    ; Back to the ROM's zero page, then record the exit status (A:X) there
    tay
    lda #0
    tab
    sty __exit_status
    stx __exit_status + 1

    ; Restore the caller's 8-bit stack (E set; SPH still selects the page),
    ; its flags (I) and return.
    sei
    see
__saved_spl:
    ldx #$FF
    txs
__saved_sph:
    ldy #$01
    tys
__saved_p:
    lda #$00
    pha
    plp
    rts

; Default init_features — does nothing. Override with a strong definition
; to set up hardware (16-bit stack, I/O mapping, DMA, etc.)
_init_features:
    rts

; __abort — abnormal termination. Non-overridable core implementation.
; abort() (weak) calls this. Users override abort() for pre-abort hooks,
; then call __abort for the actual termination.
__abort:
    ; Return to the caller (BASIC's READY. prompt) like exit(), marked as an
    ; abort, rather than stopping in the monitor with BRK
    lda #$FE            ; exit status $FFFE
    ldx #$FF
    bra __exit

; __bp_rom — switch to the ROM's base page (0) before calling KERNAL/BASIC.
; Preserves A, X, Y and Z.
__bp_rom:
    pha
    lda #0
    tab
    pla
    rts

; __bp_prog — switch back to the program's base page after a ROM call: the
; interrupt handlers' page (__zp_page_isr) while an __interrupt handler runs.
; Preserves A, X, Y, Z and the flags (ROM routines return status in C).
__bp_prog:
    php
    pha
    lda __isr_depth
    bne @isr
    lda #>__zp_page
    bra @set
@isr:
    lda #>__zp_page_isr
@set:
    tab
    pla
    plp
    rts

; Nesting depth of running __interrupt handlers (their prologue increments
; it). Kept in the init code (RAM) so crt0 adds nothing to the data segment.
__isr_depth:
    .byte 0
