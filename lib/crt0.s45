; crt0.s — Default C Runtime Startup for cc45
;
; This is the entry point for all C programs. The linker's -basic
; stub (or direct-compile wrapper) calls __init, which:
;   1. Saves the stack pointer (for clean return to caller/BASIC)
;   2. Calls _init_features (weak — overridable for platform setup)
;   3. Calls _main
;   4. Restores SP and returns to caller
;
; To override the init hook, provide a strong _init_features in another
; object file (e.g., crt0_mega65.s) and link it before or after crt0.
;
; Usage (relocatable):
;   ln45 -prg crt0.o45 main.o45 -o program.prg

; ln45's call graph: no calls through pointers (__basic_call and __rom_call
; are library members of their own: basic_call.s45, rom_call.s45)
.weak cc45.icallinfo
cc45.icallinfo = 1

.global __init
.global __start, __bc_mode, __bc_done, __saved_spl, __saved_sph, __saved_p
.weak __bc_run
.global __exit
.global __abort
.global __sp_base
.global __bp_rom
.global __bp_prog
.extern __zp_page
.extern __zp_page_isr
.global __isr_depth
.extern __stack_top
.extern __bss_start
.extern __bss_end
.extern __bss_fill
.weak _init_features
.weak __ovl_init
.weak __zp_init
.weak __ovl_rom_leave
.weak __ovl_exit
.weak __ovl_jsave
.weak __ovl_dma_fix
.weak __dma_job
.weak __ovl_jrestore
.weak ___ovl_store_bank
.weak ___ovl_store_first
.weak ___ovl_store_last
.weak ___ovl_store2_bank
.weak ___ovl_store2_first
.weak ___ovl_store2_last
.weak ___ovl_attic_bank
.weak ___ovl_attic_first
.weak ___ovl_attic_last_bank
.weak ___ovl_attic_last
.weak ___mainargs
.weak ___atexit_run
.extern _main

.segment "init"

__sp_base = $0101

; Where code overlays are kept in far memory (C: __ovl_store_bank, _first,
; _last; __ovl_store2_*: a second bank's; __ovl_attic_bank, _first,
; _last_bank, _last: attic RAM's): ln45 defines them for a program with
; overlays, far_malloc and far_attic_init leave that memory alone. Without
; overlays (or a second bank, attic RAM): bank 0, nothing.
___ovl_store_bank = 0
___ovl_store_first = 0
___ovl_store_last = 0
___ovl_store2_bank = 0
___ovl_store2_first = 0
___ovl_store2_last = 0
___ovl_attic_bank = 0
___ovl_attic_first = 0
___ovl_attic_last_bank = 0
___ovl_attic_last = 0
; (ovl.s45's __ovl_dma_fix names memcpy's DMA job: none without it)
__dma_job = 0

; Exit status, left in the ROM's zero page at $FD/$FE (BASIC 65 leaves these
; alone; a BASIC caller can PEEK(253)+256*PEEK(254), test harnesses read it
; from a memory dump): main's return value / exit()'s argument, $FFFE after
; abort(), and $FFFF (set at startup) if the program never reached __exit.
__exit_status = $FD

__init:
    lda #0
    sta __bc_mode       ; started as a program (not by __basic_call)
__start:
    ; Save caller's stack pointer for clean return
    tsx
    stx __saved_spl + 1
    tsy
    sty __saved_sph + 1

    ; Enable MEGA65 I/O — GS knock must precede hardware register access
    lda #$47            ; 'G'
    sta $D02F
    lda #$53            ; 'S'
    sta $D02F

    ; "Never reached __exit" until the program exits (B is still 0 here)
    lda #$FF
    sta __exit_status
    sta __exit_status + 1

    ; Move the base page (zero page) to a private page-aligned block at the
    ; end of BSS. The program never touches the ROM's zero page, so nothing
    ; needs saving; ROM calls switch back to page 0 via __bp_rom/__bp_prog.
    lda #>__zp_page
    tab

    ; Move the CPU stack to a 16-bit stack at __stack_top (E flag clear).
    ; Interrupts are masked while SPH/SPL change, then the caller's I flag
    ; is restored (PLP would also reload E, so it isn't used here).
    php
    pla
    sta __saved_p + 1
    ldy #>__stack_top
    beq @stack8
    sei
    cle
    tys
    ldx #<__stack_top
    txs
    and #$04            ; caller's I flag
    bne @stack8
    cli
@stack8:

    ; __basic_call fills BSS on its first call only (globals keep their
    ; values from one SYS to the next)
    lda __bc_mode
    beq @do_fill
    lda __bc_done
    bne @bss_done
@do_fill:

    ; Fill BSS (__bss_start..__bss_end, which includes the private base
    ; page) with __bss_fill: 0, or ln45 --bss-fill=V / cc45 -fbss-fill=V.
    ; A DMA fill job, built on the stack (any page: SP+1 is computed in 16
    ; bits); nothing crt0 keeps is in BSS.
    sec
    lda #<__bss_end
    sbc #<__bss_start
    tax                 ; X = size low
    lda #>__bss_end
    sbc #>__bss_start
    tay                 ; Y = size high
    bne @bss_fill
    txa
    beq @bss_done       ; no BSS
@bss_fill:
    lda #0
    pha                 ; modulo high
    pha                 ; modulo low
    pha                 ; command high
    pha                 ; destination bank
    lda #>__bss_start
    pha
    lda #<__bss_start
    pha                 ; destination
    lda #0
    pha                 ; source bank
    pha                 ; source high
    lda #<__bss_fill
    pha                 ; fill value (source low)
    tya
    pha                 ; count high
    txa
    pha                 ; count low
    lda #$03
    pha                 ; command: fill
    tsx                 ; the job list at SP+1 into Y:X
    tsy
    txa
    clc
    adc #1
    tax
    tya
    adc #0
    tay
    php                 ; (no interrupt between the DMA register writes)
    sei
    lda #0
    sta $D702           ; list bank
    sty $D701           ; list address high
    stx $D700           ; list address low: starts the job
    plp
    ldx #12
@bss_drop:
    pla
    dex
    bne @bss_drop
    jsr __zp_init       ; __zp variables' initial values (ln45; weak: none)
@bss_done:

    lda __bc_mode
    beq @program
    jmp __bc_run        ; (basic_call.s45: started by __basic_call)
@program:
    jsr _init_features
    jsr __ovl_init      ; code overlays: load their file (weak: none)
    ; main(argc, argv): __mainargs returns a pointer to { int argc; char
    ; **argv; } -- the weak default below gives argc 0, argv NULL; the
    ; library's (mainargs.c, linked when main takes parameters) parses the
    ; BASIC line. They go in the ZP parameter block and, for the stack
    ; convention, on the stack as two words (__exit restores the caller's
    ; stack pointer, so they are never popped)
    jsr ___mainargs
    sta $08
    stx $09
    ldy #0              ; (base-page stores: the block is in __zp_page)
    lda ($08),y
    sta $10
    iny
    lda ($08),y
    sta $11
    iny
    lda ($08),y
    sta $12
    iny
    lda ($08),y
    sta $13
    pha                 ; argv, then argc: low bytes at the lower address
    lda $12
    pha
    lda $11
    pha
    lda $10
    pha
    jsr _main

    ; Returning from main runs the atexit handlers as exit() does
    pha
    phx
    jsr ___atexit_run
    plx
    pla

    ; Fall through to __exit
__exit:
    jsr __ovl_exit      ; (mapped code overlays: the ROM's map back)
    ; Back to the ROM's zero page, then record the exit status (A:X) there
    tay
    lda #0
    tab
    sty __exit_status
    stx __exit_status + 1

    ; Restore the caller's 8-bit stack (E set; SPH still selects the page),
    ; its flags (I) and return.
    sei
    see
__saved_spl:
    ldx #$FF
    txs
__saved_sph:
    ldy #$01
    tys
__saved_p:
    lda #$00
    pha
    plp
    rts

; Default init_features — does nothing. Override with a strong definition
; to set up hardware (16-bit stack, I/O mapping, DMA, etc.)
_init_features:
    rts

; Default __ovl_init — no code overlays. ln45 links the library's (ovl.s45)
; when a program has them: it loads their file into far memory.
__ovl_init:
    rts

; Default __zp_init — no __zp variable has an initial value. ln45 generates
; one that copies them into the base page when some has.
__zp_init:
    rts

; Defaults of the mapped overlays' hooks (ovl.s45): after a ROM call, and
; at exit: none
__ovl_rom_leave:
__ovl_exit:
__ovl_jsave:         ; (setjmp/longjmp: the overlay state, ovl.s45)
__ovl_dma_fix:       ; (memcpy & co.: an address in the mapped overlays' window)
__bc_run:            ; (basic_call.s45's; never reached without it)
__ovl_jrestore:
    rts

; __basic_call (a BASIC SYS of a C function) is the library's basic_call.s45,
; linked only when a program has such functions; it sets __bc_mode and
; jumps to __start, which then goes on at its __bc_run (weak: below)

; (in the init code, which is RAM)
__bc_mode:  .byte 0
__bc_done:  .byte 0

; Default __atexit_run: no handlers. atexit.c in the library replaces it
; when the program calls atexit.
___atexit_run:
    rts

; Default __mainargs: no arguments (argc 0, argv NULL). mainargs.c in the
; library replaces it when main is defined with parameters.
___mainargs:
    lda #<__noargs
    ldx #>__noargs
    rts
__noargs:
    .word 0, 0

; __abort — abnormal termination. Non-overridable core implementation.
; abort() (weak) calls this. Users override abort() for pre-abort hooks,
; then call __abort for the actual termination.
__abort:
    ; Return to the caller (BASIC's READY. prompt) like exit(), marked as an
    ; abort, rather than stopping in the monitor with BRK
    lda #$FE            ; exit status $FFFE
    ldx #$FF
    bra __exit

; __bp_rom — switch to the ROM's base page (0) before calling KERNAL/BASIC.
; Preserves A, X, Y and Z.
__bp_rom:
    pha
    lda #0
    tab
    pla
    rts

; __bp_prog — switch back to the program's base page after a ROM call: the
; interrupt handlers' page (__zp_page_isr) while an __interrupt handler runs.
; Preserves A, X, Y, Z and the flags (ROM routines return status in C).
__bp_prog:
    php
    pha
    lda __isr_depth
    bne @isr
    lda #>__zp_page
    bra @set
@isr:
    lda #>__zp_page_isr
@set:
    tab
    pla
    plp
    jmp __ovl_rom_leave ; (mapped code overlays: the overlay mapped again)

; __rom_call (a KERNAL routine on the ROM's stack) is the library's
; rom_call.s45, linked only when a program calls one (#322)

; Nesting depth of running __interrupt handlers (their prologue increments
; it). Kept in the init code (RAM) so crt0 adds nothing to the data segment.
__isr_depth:
    .byte 0
