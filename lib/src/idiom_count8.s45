; __idiom_count8(const unsigned char *arr, int n, unsigned char target) -> int
; Counts occurrences of target byte in array
; Parameters (stack calling convention):
;   [FP+2]: arr — array pointer (word)
;   [FP+4]: n   — count (word)
;   [FP+6]: target — target byte value (char, passed as int)
; Returns: AX = count of matches (0-N)
; Clobbers: A, X, Y, Z

    .cpu 45gs02

    .global __idiom_count8

__idiom_count8:
    ; Set up frame pointer
    tsy
    tsx
    inx
    bne @fp_nc
    iny
@fp_nc:
    stx $FD
    sty $FE

    ; Get n from [FP+4]
    ldy #$04
    lda ($FD),y
    sta $FB           ; n_lo
    lda ($FD),y+1
    sta $FC           ; n_hi

    ; If n == 0, return 0
    lda $FB
    ora $FC
    bne @start
    lda #$00
    ldx #$00
    ldy #$00
    ldz #$00
    rts

@start:
    ; Get target from [FP+6]
    ldy #$06
    lda ($FD),y
    sta $FA           ; target_byte

    ; Get array pointer from [FP+2]
    ldy #$02
    lda ($FD),y
    sta $F8           ; arr_lo
    lda ($FD),y+1
    sta $F9           ; arr_hi

    ; Initialize: index = 0, count = 0
    lda #$00
    sta $F2           ; index_lo = 0
    sta $F3           ; index_hi = 0
    sta $F4           ; count_lo = 0
    sta $F5           ; count_hi = 0

@loop:
    ; Check index < n
    lda $F2           ; index_lo
    cmp $FB           ; n_lo
    bcc @continue
    bne @done
    lda #$00
    cmp $FC           ; n_hi
    bcc @continue

@done:
    ; Return count (stored in $F4:$F5)
    lda $F4
    ldx $F5
    ldy #$00
    ldz #$00
    rts

@continue:
    ; Compute address: arr + index
    lda $F8           ; arr_lo
    clc
    adc $F2           ; + index_lo
    sta $F6           ; addr_lo
    lda $F9           ; arr_hi
    adc $F3           ; + index_hi + carry
    sta $F7           ; addr_hi

    ; Load arr[index]
    ldy #$00
    lda ($F6),y       ; Load byte

    ; Compare with target
    cmp $FA           ; target_byte
    bne @skip_inc

    ; Increment count
    inc $F4
    bne @skip_inc
    inc $F5

@skip_inc:
    ; Increment index
    inc $F2
    bne @loop
    inc $F3
    jmp @loop
