; __idiom_sum16(const int *arr, int n) -> int
; Sum reduction: adds n 16-bit integers from array
; Stack calling convention: arr at [FP+2], n at [FP+4]
; Returns: AX = sum (16-bit), Y=0, Z=0

    .cpu 45gs02

    .global __idiom_sum16

__idiom_sum16:
    ; Establish frame pointer
    tsy
    tsx
    inx
    bne @fp_nc
    iny
@fp_nc:
    stx $FD
    sty $FE

    ; Get n from [FP+4]
    ldy #$04
    lda ($FD),y
    sta $FB           ; n_lo
    lda ($FD),y+1
    sta $FC           ; n_hi

    ; If n == 0, return 0
    lda $FB
    ora $FC
    bne @start
    lda #$00
    ldx #$00
    ldy #$00
    ldz #$00
    rts

@start:
    ; Get arr from [FP+2]
    ldy #$02
    lda ($FD),y
    sta $F8           ; arr_lo
    lda ($FD),y+1
    sta $F9           ; arr_hi

    ; Initialize: sum = 0, i = 0
    lda #$00
    ldx #$00          ; AX = sum
    sta $FA           ; i_lo = 0
    sta $F2           ; sum_lo = 0
    sta $F3           ; sum_hi = 0

@loop:
    ; Check i < n
    lda $FA           ; i_lo
    cmp $FB           ; n_lo
    bcc @continue
    bne @done
    lda #$00
    cmp $FC           ; n_hi
    bcc @continue

@done:
    ; Return sum from $F2:$F3
    lda $F2
    ldx $F3
    ldy #$00
    ldz #$00
    rts

@continue:
    ; Compute address: arr + i*2
    lda $FA           ; i
    asl               ; i*2
    clc
    adc $F8           ; + arr_lo
    sta $F6           ; addr_lo
    lda $F9           ; arr_hi
    adc #$00          ; + carry
    sta $F7           ; addr_hi

    ; Load arr[i] (16-bit)
    ldy #$00
    lda ($F6),y       ; arr[i]_lo
    clc
    adc $F2           ; + sum_lo
    sta $F2           ; sum_lo

    lda $F3           ; sum_hi
    ldy #$01
    adc ($F6),y       ; + arr[i]_hi + carry
    sta $F3           ; sum_hi

    ; Increment i
    inc $FA
    bne @loop
    ; If we overflow i_lo, handle i_hi (unlikely for reasonable arrays)
    ; Skipping for now

    jmp @loop
