; float_rom.s — CBM 40-bit float runtime via BASIC 65 ROM
;
; Uses JSRFAR ($FF6E) to call BASIC ROM float routines.
; JSRFAR handles MAP banking automatically — no overlay conflicts.
;
; JSRFAR convention: Bank=$02, PCH=$03, PCL=$04
; These ZP locations are scratch (used by DMA ops and startup code)
; and are free at the point float routines are called.
;
; FAC (Floating Point Accumulator) at $63-$68
; ARG (secondary accumulator) at $6A-$6F
;
; Float values are 5 bytes: exponent (1) + mantissa (4), big-endian.
;
; The program runs with its base page relocated (see crt0), but the ROM and
; the FAC/ARG/JSRFAR locations above are in page 0. Each public __float_*
; entry switches to page 0 (__bp_rom) and returns through __bp_prog. The
; internal helpers (__jsrfar_basic, __float_load_*, __float_store_fac) must
; only be called with the base page already at 0.

    .cpu 45gs02

.extern __bp_rom
.extern __bp_prog

; KERNAL far-call entry
JSRFAR      = $FF6E
BASIC_BANK  = $03      ; BASIC ROM bank (C65 bank 3)

; BASIC 65 jump table addresses
BJT_AYINT   = $7F00
BJT_GIVAYF  = $7F03
BJT_FADDT   = $7F1B
BJT_FSUBT   = $7F15
BJT_FMULTT  = $7F21
BJT_FDIVT   = $7F27
BJT_NEGOP   = $7F33
BJT_FCOMP   = $7F54
BJT_MOVFA   = $7F69
BJT_MOVAF   = $7F6C
BJT_MOVFM   = $7F63
BJT_MOVMF   = $7F66
BJT_LOG     = $7F2A
BJT_SQR     = $7F30
BJT_EXP     = $7F3C
BJT_SIN     = $7F42
BJT_COS     = $7F3F
BJT_TAN     = $7F45
BJT_ATN     = $7F48
BJT_ABS     = $7F4E
BJT_ROUND   = $7F4B

; FAC/ARG ZP locations
FAC_EX = $63
FAC_M1 = $64
FAC_M2 = $65
FAC_M3 = $66
FAC_M4 = $67
FAC_SI = $68
FAC_OV = $71
ARG_EX = $6A
ARG_M1 = $6B
ARG_M2 = $6C
ARG_M3 = $6D
ARG_M4 = $6E
ARG_SI = $6F

; ===========================================================================
; Helper: call BASIC ROM routine via JSRFAR
; Call with target address in AX (A=low, X=high)
; ===========================================================================
.global __jsrfar_basic
__jsrfar_basic:
    sta $04             ; PCL
    stx $03             ; PCH
    lda #BASIC_BANK
    sta $02             ; Bank
    lda #0
    sta $09             ; Z = 0 on entry: BASIC 65 routines assume it (e.g. tza)
    jsr JSRFAR
    rts

; ===========================================================================
; Memory format is CBM packed: exponent, then the mantissa MSB first with the
; sign in bit 7 of the first mantissa byte (the hidden 1 bit is implied).
; BASIC 65 keeps FAC/ARG unpacked with the mantissa LSB first:
;   FAC: $63 exp, $64-$67 mantissa (LSB..MSB), $68 sign (bit 7), $71 rounding
;   ARG: $6A exp, $6B-$6E mantissa (LSB..MSB), $6F sign (bit 7)
; (Same as the ROM's MOVFM / MOVMF.)
; ===========================================================================

; Load 5-byte float from memory (AX = pointer) into FAC
.global __float_load_fac
__float_load_fac:
    sta $02
    stx $03
    ldy #0
    lda ($02),y
    sta FAC_EX
    iny
    lda ($02),y
    sta FAC_SI          ; sign = bit 7
    ora #$80            ; hidden 1 bit
    sta FAC_M4
    iny
    lda ($02),y
    sta FAC_M3
    iny
    lda ($02),y
    sta FAC_M2
    iny
    lda ($02),y
    sta FAC_M1
    lda #0
    sta FAC_OV          ; rounding byte
    rts

; Load 5-byte float from memory (AX = pointer) into ARG
.global __float_load_arg
__float_load_arg:
    sta $02
    stx $03
    ldy #0
    lda ($02),y
    sta ARG_EX
    iny
    lda ($02),y
    sta ARG_SI
    ora #$80
    sta ARG_M4
    iny
    lda ($02),y
    sta ARG_M3
    iny
    lda ($02),y
    sta ARG_M2
    iny
    lda ($02),y
    sta ARG_M1
    rts

; Store FAC to memory (AX = destination), rounded
.global __float_store_fac
__float_store_fac:
    pha
    phx
    lda #<BJT_ROUND
    ldx #>BJT_ROUND
    jsr __jsrfar_basic
    plx
    pla
    sta $02
    stx $03
    ldy #0
    lda FAC_EX
    sta ($02),y
    iny
    lda FAC_SI          ; sign bit replaces the hidden 1 bit of the MSB
    and #$80
    sta $04
    lda FAC_M4
    and #$7F
    ora $04
    sta ($02),y
    iny
    lda FAC_M3
    sta ($02),y
    iny
    lda FAC_M2
    sta ($02),y
    iny
    lda FAC_M1
    sta ($02),y
    rts

; ===========================================================================
; Binary: __float_add  (result = a + b)
; ===========================================================================
.global __float_add
__float_add:
    jsr __bp_rom
    lda #<__float_b
    ldx #>__float_b
    jsr __float_load_fac
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_arg
    lda #<BJT_FADDT
    ldx #>BJT_FADDT
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

; ===========================================================================
; Binary: __float_sub  (result = a - b)
; ===========================================================================
.global __float_sub
__float_sub:
    jsr __bp_rom
    lda #<__float_b
    ldx #>__float_b
    jsr __float_load_fac
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_arg
    lda #<BJT_FSUBT
    ldx #>BJT_FSUBT
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

; ===========================================================================
; Binary: __float_mul  (result = a * b)
; ===========================================================================
.global __float_mul
__float_mul:
    jsr __bp_rom
    lda #<__float_b
    ldx #>__float_b
    jsr __float_load_fac
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_arg
    lda #<BJT_FMULTT
    ldx #>BJT_FMULTT
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

; ===========================================================================
; Binary: __float_div  (result = a / b)
; ===========================================================================
.global __float_div
__float_div:
    jsr __bp_rom
    lda #<__float_b
    ldx #>__float_b
    jsr __float_load_fac
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_arg
    lda #<BJT_FDIVT
    ldx #>BJT_FDIVT
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

; ===========================================================================
; Unary: __float_neg  (result = -a)
; ===========================================================================
.global __float_neg
__float_neg:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    lda #<BJT_NEGOP
    ldx #>BJT_NEGOP
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

; ===========================================================================
; Compare: __float_cmp  (a vs b → A = $FF/-1, $00, $01)
; ===========================================================================
.global __float_cmp
__float_cmp:
    jsr __bp_rom
    ; Compute a - b via FSUBT, then check sign
    ; FSUBT: FAC = ARG - FAC, so load b→FAC, a→ARG → FAC = a - b
    lda #<__float_b
    ldx #>__float_b
    jsr __float_load_fac
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_arg
    lda #<BJT_FSUBT
    ldx #>BJT_FSUBT
    jsr __jsrfar_basic
    ; FAC = a - b. Check sign.
    lda FAC_EX
    beq @zero           ; exponent 0 = value is 0 (equal)
    bbs7 FAC_SI, @negative  ; sign is bit 7 (the other bits are mantissa leftovers)
    lda #$01            ; positive: a > b
    jmp __bp_prog
@negative:
    lda #$FF            ; negative: a < b
    jmp __bp_prog
@zero:
    lda #$00            ; equal
    jmp __bp_prog

; ===========================================================================
; Conversion: __float_itof (int AX → float at __float_a)
; ===========================================================================
.global __float_itof
__float_itof:
    jsr __bp_rom
    ; Input: A=low byte, X=high byte of 16-bit integer
    ; GIVAYF expects: A=high byte, Y=low byte
    ; JSRFAR loads: A from $06, Y from $08
    tay             ; Y = low byte (save temporarily)
    txa             ; A = high byte
    sta $06         ; JSRFAR A register = high byte
    sty $08         ; JSRFAR Y register = low byte
    lda #BASIC_BANK
    sta $02
    lda #>BJT_GIVAYF
    sta $03
    lda #<BJT_GIVAYF
    sta $04
    lda #0
    sta $09             ; Z = 0
    jsr JSRFAR
    ; FAC now has the float value — store to __float_a
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

; ===========================================================================
; Conversion: __float_ftoi (float at __float_a → int AX)
; ===========================================================================
.global __float_ftoi
__float_ftoi:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    lda #<BJT_AYINT
    ldx #>BJT_AYINT
    jsr __jsrfar_basic
    ; MEGA65 BASIC 65 AYINT: stores 16-bit integer in FAC_M1 (low) and FAC_M2 (high)
    lda FAC_M1      ; low byte
    ldx FAC_M2      ; high byte
    jmp __bp_prog

; ===========================================================================
; Math: unary float functions
; ===========================================================================
.global __float_sin
__float_sin:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    lda #<BJT_SIN
    ldx #>BJT_SIN
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

.global __float_cos
__float_cos:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    lda #<BJT_COS
    ldx #>BJT_COS
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

.global __float_tan
__float_tan:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    lda #<BJT_TAN
    ldx #>BJT_TAN
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

.global __float_atn
__float_atn:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    lda #<BJT_ATN
    ldx #>BJT_ATN
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

.global __float_log
__float_log:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    lda #<BJT_LOG
    ldx #>BJT_LOG
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

.global __float_exp
__float_exp:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    lda #<BJT_EXP
    ldx #>BJT_EXP
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

.global __float_sqr
__float_sqr:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    lda #<BJT_SQR
    ldx #>BJT_SQR
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

.global __float_abs
__float_abs:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    lda #<BJT_ABS
    ldx #>BJT_ABS
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

; ===========================================================================
; Shared data buffers
; ===========================================================================
.segment "bss"
.global __float_a
__float_a: .res 5

.global __float_b
__float_b: .res 5
