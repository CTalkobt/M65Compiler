; float_rom.s — CBM 40-bit float runtime via BASIC 65 ROM
;
; Uses JSRFAR ($FF6E) to call BASIC ROM float routines.
; JSRFAR handles MAP banking automatically — no overlay conflicts.
;
; JSRFAR convention: Bank=$02, PCH=$03, PCL=$04
; These ZP locations are scratch (used by DMA ops and startup code)
; and are free at the point float routines are called.
;
; FAC (Floating Point Accumulator) at $63-$68
; ARG (secondary accumulator) at $6A-$6F
;
; Float values are 5 bytes: exponent (1) + mantissa (4), big-endian.
;
; The program runs with its base page relocated (see crt0), but the ROM and
; the FAC/ARG/JSRFAR locations above are in page 0. Each public __float_*
; entry switches to page 0 (__bp_rom) and returns through __bp_prog. The
; internal helpers (__jsrfar_basic, __float_load_*, __float_store_fac) must
; only be called with the base page already at 0.

    .cpu 45gs02

.extern __bp_rom
.extern __bp_prog

; KERNAL far-call entry
JSRFAR      = $FF6E
BASIC_BANK  = $03      ; BASIC ROM bank (C65 bank 3)

; BASIC 65 jump table addresses
BJT_AYINT   = $7F00
BJT_GIVAYF  = $7F03
BJT_FADDT   = $7F1B
BJT_FSUBT   = $7F15
BJT_FMULTT  = $7F21
BJT_FDIVT   = $7F27
BJT_NEGOP   = $7F33
BJT_FCOMP   = $7F54
BJT_MOVFA   = $7F69
BJT_MOVAF   = $7F6C
BJT_MOVFM   = $7F63
BJT_MOVMF   = $7F66
BJT_LOG     = $7F2A
BJT_SQR     = $7F30
BJT_EXP     = $7F3C
BJT_SIN     = $7F42
BJT_COS     = $7F3F
BJT_TAN     = $7F45
BJT_ATN     = $7F48
BJT_ABS     = $7F4E
BJT_ROUND   = $7F4B

; FAC/ARG ZP locations
FAC_EX = $63
FAC_M1 = $64
FAC_M2 = $65
FAC_M3 = $66
FAC_M4 = $67
FAC_SI = $68
FAC_OV = $71
ARG_EX = $6A
ARG_M1 = $6B
ARG_M2 = $6C
ARG_M3 = $6D
ARG_M4 = $6E
ARG_SI = $6F

; ===========================================================================
; Helper: call BASIC ROM routine via JSRFAR
; Call with target address in AX (A=low, X=high)
; ===========================================================================
.global __jsrfar_basic
__jsrfar_basic:
    sta $04             ; PCL
    stx $03             ; PCH
    lda #BASIC_BANK
    sta $02             ; Bank
    lda #0
    sta $09             ; Z = 0 on entry: BASIC 65 routines assume it (e.g. tza)
    jsr JSRFAR
    rts

; ===========================================================================
; Memory format is CBM packed: exponent, then the mantissa MSB first with the
; sign in bit 7 of the first mantissa byte (the hidden 1 bit is implied).
; BASIC 65 keeps FAC/ARG unpacked with the mantissa LSB first:
;   FAC: $63 exp, $64-$67 mantissa (LSB..MSB), $68 sign (bit 7), $71 rounding
;   ARG: $6A exp, $6B-$6E mantissa (LSB..MSB), $6F sign (bit 7)
; (Same as the ROM's MOVFM / MOVMF.)
; ===========================================================================

; Load 5-byte float from memory (AX = pointer) into FAC
.global __float_load_fac
__float_load_fac:
    sta $02
    stx $03
    ldy #0
    lda ($02),y
    sta FAC_EX
    iny
    lda ($02),y
    sta FAC_SI          ; sign = bit 7
    ora #$80            ; hidden 1 bit
    sta FAC_M4
    iny
    lda ($02),y
    sta FAC_M3
    iny
    lda ($02),y
    sta FAC_M2
    iny
    lda ($02),y
    sta FAC_M1
    lda #0
    sta FAC_OV          ; rounding byte
    rts

; Load 5-byte float from memory (AX = pointer) into ARG
.global __float_load_arg
__float_load_arg:
    sta $02
    stx $03
    ldy #0
    lda ($02),y
    sta ARG_EX
    iny
    lda ($02),y
    sta ARG_SI
    ora #$80
    sta ARG_M4
    iny
    lda ($02),y
    sta ARG_M3
    iny
    lda ($02),y
    sta ARG_M2
    iny
    lda ($02),y
    sta ARG_M1
    rts

; Store FAC to memory (AX = destination), rounded
.global __float_store_fac
__float_store_fac:
    pha
    phx
    lda #<BJT_ROUND
    ldx #>BJT_ROUND
    jsr __jsrfar_basic
    plx
    pla
    sta $02
    stx $03
    ldy #0
    lda FAC_EX
    sta ($02),y
    iny
    lda FAC_SI          ; sign bit replaces the hidden 1 bit of the MSB
    and #$80
    sta $04
    lda FAC_M4
    and #$7F
    ora $04
    sta ($02),y
    iny
    lda FAC_M3
    sta ($02),y
    iny
    lda FAC_M2
    sta ($02),y
    iny
    lda FAC_M1
    sta ($02),y
    rts

; ===========================================================================
; Binary: __float_add  (result = a + b)
; ===========================================================================
.global __float_add
__float_add:
    jsr __bp_rom
    lda #<__float_b
    ldx #>__float_b
    jsr __float_load_fac
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_arg
    lda #<BJT_FADDT
    ldx #>BJT_FADDT
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

; ===========================================================================
; Binary: __float_sub  (result = a - b)
; ===========================================================================
.global __float_sub
__float_sub:
    jsr __bp_rom
    lda #<__float_b
    ldx #>__float_b
    jsr __float_load_fac
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_arg
    lda #<BJT_FSUBT
    ldx #>BJT_FSUBT
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

; ===========================================================================
; Binary: __float_mul  (result = a * b)
; ===========================================================================
.global __float_mul
__float_mul:
    jsr __bp_rom
    lda #<__float_b
    ldx #>__float_b
    jsr __float_load_fac
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_arg
    lda #<BJT_FMULTT
    ldx #>BJT_FMULTT
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

; ===========================================================================
; Binary: __float_div  (result = a / b)
; ===========================================================================
.global __float_div
__float_div:
    jsr __bp_rom
    lda #<__float_b
    ldx #>__float_b
    jsr __float_load_fac
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_arg
    lda #<BJT_FDIVT
    ldx #>BJT_FDIVT
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

; ===========================================================================
; Unary: __float_neg  (result = -a)
; ===========================================================================
.global __float_neg
__float_neg:
    ; Flip the sign bit (bit 7 of the first mantissa byte) of the packed
    ; value: exact, and -0.0 keeps its sign (BASIC's NEGOP leaves 0 alone)
    lda __float_a+1
    eor #$80
    sta __float_a+1
    rts

; ===========================================================================
; Compare: __float_cmp  (a vs b → A = $FF/-1, $00, $01)
; ===========================================================================
.global __float_cmp
__float_cmp:
    jsr __bp_rom
    ; Compute a - b via FSUBT, then check sign
    ; FSUBT: FAC = ARG - FAC, so load b→FAC, a→ARG → FAC = a - b
    lda #<__float_b
    ldx #>__float_b
    jsr __float_load_fac
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_arg
    lda #<BJT_FSUBT
    ldx #>BJT_FSUBT
    jsr __jsrfar_basic
    ; FAC = a - b. Check sign.
    lda FAC_EX
    beq @zero           ; exponent 0 = value is 0 (equal)
    bbs7 FAC_SI, @negative  ; sign is bit 7 (the other bits are mantissa leftovers)
    lda #$01            ; positive: a > b
    jmp __bp_prog
@negative:
    lda #$FF            ; negative: a < b
    jmp __bp_prog
@zero:
    lda #$00            ; equal
    jmp __bp_prog

; ===========================================================================
; Conversions between integers and floats, done on the packed CBM format
; (exponent byte, 32-bit mantissa with the sign in bit 7 of its top byte and
; an implicit leading 1). No ROM calls: BASIC's AYINT floors and only takes
; -32768..32767, GIVAYF only takes a signed 16-bit value.
;   __float_ftol: float at __float_a -> 32-bit integer in A/X/Y/Z (low..high),
;                 truncated toward zero (C conversion semantics)
;   __float_ftoi: the same, low 16 bits in A/X
;   __float_ltof: 32-bit signed integer in A/X/Y/Z -> float at __float_a
;   __float_ultof: 32-bit unsigned integer in A/X/Y/Z -> float at __float_a
;   __float_itof / __float_utof: signed / unsigned 16-bit A/X -> float
; Temporaries: $F0-$F4 of the program's zero page (library temps).
; ===========================================================================
FT_M0 = $F0
FT_M1 = $F1
FT_M2 = $F2
FT_M3 = $F3
FT_SG = $F4

.global __float_ftoi
.global __float_ftol
__float_ftoi:
__float_ftol:
    lda #0
    sta FT_M0
    sta FT_M1
    sta FT_M2
    sta FT_M3
    lda __float_a           ; exponent: value = 0.M * 2^(exp-128)
    cmp #$81
    bcc @done               ; |value| < 1 (or 0): 0
    ; mantissa with the implicit leading 1
    lda __float_a+1
    ora #$80
    sta FT_M3
    lda __float_a+2
    sta FT_M2
    lda __float_a+3
    sta FT_M1
    lda __float_a+4
    sta FT_M0
    ; shift right by 160 - exp (32 - integer bits); exp >= 160 overflows
    lda #$A0
    sec
    sbc __float_a
    bcc @sign               ; too large: keep the low 32 bits of 0.M * 2^32
    tax
    beq @sign
@shift:
    lsr FT_M3
    ror FT_M2
    ror FT_M1
    ror FT_M0
    dex
    bne @shift
@sign:
    lda __float_a+1
    bpl @done
    ; negative: two's complement
    sec
    lda #0
    sbc FT_M0
    sta FT_M0
    lda #0
    sbc FT_M1
    sta FT_M1
    lda #0
    sbc FT_M2
    sta FT_M2
    lda #0
    sbc FT_M3
    sta FT_M3
@done:
    lda FT_M3
    taz
    lda FT_M0
    ldx FT_M1
    ldy FT_M2
    rts

.global __float_itof
__float_itof:
    ; signed 16-bit A/X: sign-extend into Y/Z
    ldy #0
    ldz #0
    cpx #$80
    bcc __float_ltof
    ldy #$FF
    ldz #$FF
    bra __float_ltof

.global __float_utof
__float_utof:
    ldy #0
    ldz #0
    bra __float_ultof

.global __float_ltof
.global __float_ultof
__float_ltof:
    sta FT_M0
    stx FT_M1
    sty FT_M2
    tza
    sta FT_M3
    lda #0
    sta FT_SG
    bbr7 FT_M3, __float_ltof_mag
    ; negative: magnitude = -value
    lda #$80
    sta FT_SG
    sec
    lda #0
    sbc FT_M0
    sta FT_M0
    lda #0
    sbc FT_M1
    sta FT_M1
    lda #0
    sbc FT_M2
    sta FT_M2
    lda #0
    sbc FT_M3
    sta FT_M3
    bra __float_ltof_mag
__float_ultof:
    sta FT_M0
    stx FT_M1
    sty FT_M2
    tza
    sta FT_M3
    lda #0
    sta FT_SG
__float_ltof_mag:
    ; zero?
    lda FT_M0
    ora FT_M1
    ora FT_M2
    ora FT_M3
    bne @norm
    ldx #4
@z:
    sta __float_a,x         ; A = 0
    dex
    bpl @z
    rts
@norm:
    ; normalize: shift left until bit 31 is set; exponent = 160 - shifts
    ldx #$A0
@nl:
    bbs7 FT_M3, @pack
    asl FT_M0
    rol FT_M1
    rol FT_M2
    rol FT_M3
    dex
    bra @nl
@pack:
    stx __float_a
    lda FT_M3
    and #$7F                ; the implicit 1 makes way for the sign
    ora FT_SG
    sta __float_a+1
    lda FT_M2
    sta __float_a+2
    lda FT_M1
    sta __float_a+3
    lda FT_M0
    sta __float_a+4
    rts

; ===========================================================================
; Math: unary float functions
; ===========================================================================
.global __float_sin
__float_sin:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    lda #<BJT_SIN
    ldx #>BJT_SIN
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

.global __float_cos
__float_cos:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    lda #<BJT_COS
    ldx #>BJT_COS
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

.global __float_tan
__float_tan:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    lda #<BJT_TAN
    ldx #>BJT_TAN
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

.global __float_atn
__float_atn:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    lda #<BJT_ATN
    ldx #>BJT_ATN
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

.global __float_log
__float_log:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    lda #<BJT_LOG
    ldx #>BJT_LOG
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

.global __float_exp
__float_exp:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    lda #<BJT_EXP
    ldx #>BJT_EXP
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

.global __float_sqr
__float_sqr:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    lda #<BJT_SQR
    ldx #>BJT_SQR
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

.global __float_abs
__float_abs:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    lda #<BJT_ABS
    ldx #>BJT_ABS
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

; ===========================================================================
; Shared data buffers
; ===========================================================================
.segment "bss"
.global __float_a
__float_a: .res 5

.global __float_b
__float_b: .res 5
