; SAC Debug Helper Functions
; These functions provide runtime debug output for Static Allocation Convention (SAC) AR buffers
; Called via -fsac-debug compiler flag to trace AR buffer allocation and function entry/exit

    .global __sac_debug_enter
    .global __sac_debug_exit

    ; __sac_debug_enter: Called at SAC function entry
    ; Parameters:
    ;   A:X = AR buffer address (low:high)
    ;   Y   = AR size in bytes
    ;
    ; This stub implementation does nothing.
    ; Users can replace with actual debug output (e.g., printf, UART, screen writes)
__sac_debug_enter:
    ; Stub: just return
    ; In a real implementation, this might:
    ; - Print "ENTER funcName: AR=0xXXXX (size=N)"
    ; - Output to screen memory ($0400) or UART
    ; - Use printf for formatted output
    rts

    ; __sac_debug_exit: Called at SAC function exit
    ; This stub implementation does nothing.
    ; Users can replace with actual debug output (e.g., printf, UART, screen writes)
__sac_debug_exit:
    ; Stub: just return
    ; In a real implementation, this might:
    ; - Print "EXIT funcName"
    ; - Output to screen memory ($0400) or UART
    ; - Use printf for formatted output
    rts
