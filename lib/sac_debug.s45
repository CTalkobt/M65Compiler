; SAC Debug Helper Functions
; These functions provide runtime debug output for Static Allocation Convention (SAC) AR buffers
; Called via -fsac-debug compiler flag to trace AR buffer allocation and function entry/exit

; no calls through pointers here (ln45's call graph)
.weak cc45.icallinfo
cc45.icallinfo = 1

    .global __sac_debug_enter
    .global __sac_debug_exit
    .extern _printf

    ; __sac_debug_enter: Called at SAC function entry
    ; Parameters (registers):
    ;   A = AR buffer address (low byte)
    ;   X = AR buffer address (high byte)
    ;   Y = AR size in bytes
    ;
    ; Output via printf using stack calling convention
__sac_debug_enter:
    ; Push parameters for printf (stack convention, reverse order)
    ; printf(format, ar_addr_16bit, ar_size_16bit)

    ; Push AR_SIZE as 16-bit value (high byte, then low)
    lda #$00             ; AR size is always < 256, so high byte is 0
    pha
    phy                  ; Push Y (AR size low byte)

    ; Push AR_ADDRESS as 16-bit value (high byte, then low)
    phx                  ; Push X (AR address high byte)
    pha                  ; Push A (AR address low byte)

    ; Format string pointer is the first (last pushed) argument
    lda #>sac_enter_fmt
    pha
    lda #<sac_enter_fmt
    pha
    jsr _printf

    ; The caller drops the arguments (6 bytes)
    pla
    pla
    pla
    pla
    pla
    pla
    rts

    ; __sac_debug_exit: Called at SAC function exit
    ; No parameters
__sac_debug_exit:
    ; Call printf with exit message (variadic: stack convention)
    lda #>sac_exit_fmt
    pha
    lda #<sac_exit_fmt
    pha
    jsr _printf
    pla
    pla
    rts

    .data
sac_enter_fmt:
    .ascii "SAC ENTER: AR=$%04X size=%d\n"
    .byte $00

sac_exit_fmt:
    .ascii "SAC EXIT\n"
    .byte $00
