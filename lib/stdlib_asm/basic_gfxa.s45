; basic_gfxa.s45 — the graphics run time's dot (basic_gfx.c, basic45 --compile, #369)
;
;   __bas_gplot  the dot at (__bas_gx, __bas_gy) of the draw screen with the
;                pens, the draw mode and the pattern, as BASIC 65's graphics
;                kernel's plotdot (b65alt.src V920413) after calcadr: each plane
;                of the screen read, changed and written in bank 4 (even
;                planes) or 5 (odd) at the plane's segment
;
; The kernel's variables (bank 0 $1F00, kg65vars.src) are read in place.

.weak cc45.icallinfo
cc45.icallinfo = 1

    .cpu 45gs02

KG_PENS     = $1F41
KG_MODE     = $1F44
KG_DPATYPE  = $1F45
KG_DPAT     = $1F46
KG_PATBIT   = $1F4A
KG_WIDTH    = $1F4C
KG_HEIGHT   = $1F4D
KG_PLANES   = $1F50
KG_BANKA    = $1F3E
KG_DSBP     = $1F61

KG_VPMAXX   = $1F57
KG_VPMAXY   = $1F59

PTR = $08                   ; (__zp_scratch: the byte's 28-bit address)

.extern __bas_g
.extern __bas_n

; the kernel's variables as one symbol (basic_gfx.c's struct kg65 _bas_kg)
.global __bas_kg
__bas_kg = $1F00

    .split "__bas_gplot"
.global __bas_gplot
__bas_gplot:
    jsr calcadr
    jmp plotdot

; odd, line, adr and mask of (__bas_gx, __bas_gy) (calcadr; __bas_gy's high
; byte halved on an interlaced screen)
calcadr:
    ; the line (y, or y / 2 interlaced: odd its parity)
    lda #0
    sta odd
    lda __bas_gy
    ldx KG_HEIGHT
    beq @v200
    lsr __bas_gy+1
    ror a
    rol odd
@v200:
    sta line
    ; row * $500, halved for 640, quartered for 320
    lsr a
    lsr a
    lsr a
    sta adr+1
    asl a
    asl a
    clc
    adc adr+1               ; row * 5
    sta adr+1
    lda #0
    sta adr
    lsr adr+1
    ror adr
    lda KG_WIDTH
    bne @w640
    lsr adr+1
    ror adr
@w640:
    lda line
    and #7
    ora adr
    sta adr
    ; + the column's byte (x AND $FFF8)
    lda __bas_gx
    and #$F8
    clc
    adc adr
    sta adr
    lda __bas_gx+1
    adc adr+1
    sta adr+1
    lda __bas_gx
    and #7
    tax
    lda bitsdn,x
    sta mask
    rts

plotdot:
    ; the pattern's bit (style 1)
    lda #1
    sta pat
    lda KG_MODE
    and #8
    beq @nopat
    lda KG_PATBIT
    and #7
    tax
    lda bitsdn,x
    sta pat
    lda KG_PATBIT
    lsr a
    lsr a
    lsr a
    and #3
    tax
    lda KG_DPAT,x
    and pat
    sta pat
    inc KG_PATBIT
    lda KG_DPATYPE
    and #3
    tax
    lda KG_PATBIT
    cmp patrbits,x
    bne @nopat
    lda #0
    sta KG_PATBIT
@nopat:
    ; the planes
    lda #0
    sta plane
    lda #1
    sta pbit
@plane:
    lda KG_PLANES
    and pbit
    beq @next
    jsr paddr
    lda [PTR],z
    sta cur
    ; the mode
    lda KG_MODE
    and #7
    beq @normal
    lda KG_PENS
    and pbit
    beq @next               ; (a plane pen 0 does not use: left)
    lda KG_MODE
    and #2
    beq @notxor
    lda KG_MODE
    and #8
    beq @xor
    lda pat
    beq @next
@xor:
    lda cur
    eor mask
    bra @store
@notxor:
    lda KG_MODE
    and #1
    beq @normal
    lda pat                 ; jam2: off bits in pen 1's colour
    bne @pen0
    lda KG_PENS+1
    bra @pen
@normal:
    lda pat
    beq @next
@pen0:
    lda KG_PENS
@pen:
    and pbit
    bne @set
    lda mask
    eor #$FF
    and cur
    bra @store
@set:
    lda cur
    ora mask
@store:
    sta [PTR],z
@next:
    inc plane
    asl pbit
    bcc @plane
    rts

; PTR := the byte of plane `plane` (Z = 0)
paddr:
    ldx plane
    lda KG_DSBP,x
    ldy KG_HEIGHT
    beq @low
    ldy odd
    beq @low
    and #$E0                ; (the odd lines' segment)
    bra @seg
@low:
    asl a
    asl a
    asl a
    asl a
@seg:
    ora adr+1
    sta PTR+1
    lda adr
    sta PTR
    txa
    and #1
    ora KG_BANKA
    sta PTR+2
    lda #0
    sta PTR+3
    ldz #0
    rts

; ---------------------------------------------------------------------------
;   __bas_gpix    A := the colour index at (__bas_gx, __bas_gy) (q.pixel),
;                 carry clear; carry set (A = 0) beyond the viewport's far
;                 edges
;   __bas_gpixel  PIXEL(x, y): _bas_g[0-3] (x, y) to __bas_n
; ---------------------------------------------------------------------------
    .split "__bas_gpixel"
.global __bas_gpixel
__bas_gpixel:
    lda __bas_g
    sta __bas_gx
    lda __bas_g+1
    sta __bas_gx+1
    lda __bas_g+2
    sta __bas_gy
    lda __bas_g+3
    sta __bas_gy+1
    jsr __bas_gpix
    sta __bas_n
    lda #0
    sta __bas_n+1
    rts

.global __bas_gpix
__bas_gpix:
    lda __bas_gx+1
    cmp KG_VPMAXX+1
    bcc @x
    bne @out
    lda __bas_gx
    cmp KG_VPMAXX
    bcs @out
@x:
    lda __bas_gy+1
    cmp KG_VPMAXY+1
    bcc @y
    bne @out
    lda __bas_gy
    cmp KG_VPMAXY
    bcs @out
@y:
    jsr calcadr
    lda #0
    sta cur
    sta plane
    lda #1
    sta pbit
@pl:
    lda KG_PLANES
    and pbit
    beq @nx
    jsr paddr
    lda [PTR],z
    and mask
    beq @nx
    lda cur
    ora pbit
    sta cur
@nx:
    inc plane
    asl pbit
    bcc @pl
    lda cur
    clc
    rts
@out:
    lda #0
    sec
    rts

bitsdn:   .byte 128, 64, 32, 16, 8, 4, 2, 1
patrbits: .byte 8, 16, 24, 32

.segment "bss"
.global __bas_gx
.global __bas_gy
__bas_gx: .res 2
__bas_gy: .res 2
odd:   .res 1
line:  .res 1
adr:   .res 2
mask:  .res 1
pat:   .res 1
plane: .res 1
pbit:  .res 1
cur:   .res 1

; ---------------------------------------------------------------------------
;   __bas_gline0  the line from (__bas_lx0, __bas_ly0) to (__bas_lx1, __bas_ly1),
;                 clipped to the viewport (kg65.clip: Cohen-Sutherland, the
;                 intersections n * d1 / d2 in BASIC's floats, rounded down;
;                 the distances to the low edges one more, as its calconst),
;                 each dot plotted (q.line: Bresenham by the kernel's octants)
; ---------------------------------------------------------------------------

.extern __float_itof
.extern __float_mul
.extern __float_div
.extern __float_a
.extern __float_b
.extern __bas_ayint
.extern __bas_n

KG_VPMINX = $1F53
KG_VPMINY = $1F55

.segment "code"
    .split "__bas_gline0"
.global __bas_gline0
__bas_gline0:
    ; maxx, maxy: the viewport's last
    sec
    lda KG_VPMAXX
    sbc #1
    sta maxx
    lda KG_VPMAXX+1
    sbc #0
    sta maxx+1
    sec
    lda KG_VPMAXY
    sbc #1
    sta maxy
    lda KG_VPMAXY+1
    sbc #0
    sta maxy+1
@clip:
    ldx #0
    jsr outcode
    sta c0
    ldx #4
    jsr outcode
    sta c1
    and c0
    beq @c2
    rts                     ; all outside
@c2:
    lda c0
    ora c1
    bne @c3
    jmp @draw
@c3:
    ; dx, dy
    sec
    lda __bas_lx1
    sbc __bas_lx0
    sta ddx
    lda __bas_lx1+1
    sbc __bas_lx0+1
    sta ddx+1
    sec
    lda __bas_ly1
    sbc __bas_ly0
    sta ddy
    lda __bas_ly1+1
    sbc __bas_ly0+1
    sta ddy+1
    ; the point outside: the first, else the second
    ldx #0
    lda c0
    bne @c4
    ldx #4
    lda c1
@c4:
    stx pt
    sta cc
    and #8
    beq @n8
    ; y > maxy: x = (maxy - y0) * dx / dy + x0, y = maxy
    sec
    lda maxy
    sbc __bas_ly0
    sta xn
    lda maxy+1
    sbc __bas_ly0+1
    sta xn+1
    jsr xclip
    lda maxy
    ldy maxy+1
    bra @sety
@n8:
    lda cc
    and #2
    beq @n2
    ; y < miny: x = (miny - y0 - 1) * dx / dy + x0, y = miny
    clc
    lda KG_VPMINY
    sbc __bas_ly0
    sta xn
    lda KG_VPMINY+1
    sbc __bas_ly0+1
    sta xn+1
    jsr xclip
    lda KG_VPMINY
    ldy KG_VPMINY+1
@sety:
    ldx pt
    sta __bas_ly0,x
    tya
    sta __bas_ly0+1,x
    lda res
    sta __bas_lx0,x
    lda res+1
    sta __bas_lx0+1,x
    jmp @clip
@n2:
    lda cc
    and #4
    beq @n4
    ; x > maxx: y = (maxx - x0) * dy / dx + y0, x = maxx
    sec
    lda maxx
    sbc __bas_lx0
    sta xn
    lda maxx+1
    sbc __bas_lx0+1
    sta xn+1
    jsr yclip
    lda maxx
    ldy maxx+1
    bra @setx
@n4:
    ; x < minx: y = (minx - x0 - 1) * dy / dx + y0, x = minx
    clc
    lda KG_VPMINX
    sbc __bas_lx0
    sta xn
    lda KG_VPMINX+1
    sbc __bas_lx0+1
    sta xn+1
    jsr yclip
    lda KG_VPMINX
    ldy KG_VPMINX+1
@setx:
    ldx pt
    sta __bas_lx0,x
    tya
    sta __bas_lx0+1,x
    lda res
    sta __bas_ly0,x
    lda res+1
    sta __bas_ly0+1,x
    jmp @clip

@draw:
    ; Bresenham: octant bits 2 (x back), 4 (y back), 8 (steep)
    lda #0
    sta oct
    sec
    lda __bas_lx1
    sbc __bas_lx0
    sta ddx
    lda __bas_lx1+1
    sbc __bas_lx0+1
    sta ddx+1
    bpl @dxp
    lda #2
    tsb oct
    sec
    lda #0
    sbc ddx
    sta ddx
    lda #0
    sbc ddx+1
    sta ddx+1
@dxp:
    sec
    lda __bas_ly1
    sbc __bas_ly0
    sta ddy
    lda __bas_ly1+1
    sbc __bas_ly0+1
    sta ddy+1
    bpl @dyp
    lda #4
    tsb oct
    sec
    lda #0
    sbc ddy
    sta ddy
    lda #0
    sbc ddy+1
    sta ddy+1
@dyp:
    ; dx - dy < 0: swapped, steep
    sec
    lda ddx
    sbc ddy
    lda ddx+1
    sbc ddy+1
    bpl @shallow
    ldx ddx
    ldy ddx+1
    lda ddy
    sta ddx
    lda ddy+1
    sta ddx+1
    stx ddy
    sty ddy+1
    lda #8
    tsb oct
@shallow:
    ; e = -dx / 2 (arithmetic)
    sec
    lda #0
    sbc ddx
    sta err
    lda #0
    sbc ddx+1
    cmp #$80
    ror a
    sta err+1
    ror err
    lda ddx
    sta cnt
    lda ddx+1
    sta cnt+1
    jsr dot
@step:
    lda cnt
    ora cnt+1
    bne @more
    rts
@more:
    lda cnt
    bne @dec
    dec cnt+1
@dec:
    dec cnt
    ldz oct                 ; (z: this step's octant)
    clc
    lda err
    adc ddy
    sta err
    lda err+1
    adc ddy+1
    sta err+1
    bmi @nodiag
    sec
    lda err
    sbc ddx
    sta err
    lda err+1
    sbc ddx+1
    sta err+1
    inz
@nodiag:
    tza
    and #8
    beq @xmain
    ; steep: y always, x on the diagonal
    jsr ystep
    tza
    and #1
    beq @plot
    jsr xstep
    bra @plot
@xmain:
    jsr xstep
    tza
    and #1
    beq @plot
    jsr ystep
@plot:
    jsr dot
    bra @step

; x one way or the other (octant bit 1)
xstep:
    tza
    and #2
    bne @back
    inc __bas_lx0
    bne @x
    inc __bas_lx0+1
@x:
    rts
@back:
    lda __bas_lx0
    bne @x2
    dec __bas_lx0+1
@x2:
    dec __bas_lx0
    rts
ystep:
    tza
    and #4
    bne @back
    inc __bas_ly0
    bne @y
    inc __bas_ly0+1
@y:
    rts
@back:
    lda __bas_ly0
    bne @y2
    dec __bas_ly0+1
@y2:
    dec __bas_ly0
    rts

; the dot at (lx0, ly0) (keeps z)
dot:
    phz
    lda __bas_lx0
    sta __bas_gx
    lda __bas_lx0+1
    sta __bas_gx+1
    lda __bas_ly0
    sta __bas_gy
    lda __bas_ly0+1
    sta __bas_gy+1
    jsr __bas_gplot
    plz
    rts

; outcode of point X (0 the first, 4 the second): 1 x < min, 4 x > max,
; 2 y < min, 8 y > max (signed)
outcode:
    lda #0
    sta oc
    ; y
    sec
    lda __bas_ly0,x
    sbc KG_VPMINY
    lda __bas_ly0+1,x
    sbc KG_VPMINY+1
    bvc @y1
    eor #$80
@y1:
    bpl @y2
    lda #2
    tsb oc
    bra @x
@y2:
    sec
    lda maxy
    sbc __bas_ly0,x
    lda maxy+1
    sbc __bas_ly0+1,x
    bvc @y3
    eor #$80
@y3:
    bpl @x
    lda #8
    tsb oc
@x:
    sec
    lda __bas_lx0,x
    sbc KG_VPMINX
    lda __bas_lx0+1,x
    sbc KG_VPMINX+1
    bvc @x1
    eor #$80
@x1:
    bpl @x2
    lda #1
    tsb oc
    bra @out
@x2:
    sec
    lda maxx
    sbc __bas_lx0,x
    lda maxx+1
    sbc __bas_lx0+1,x
    bvc @x3
    eor #$80
@x3:
    bpl @out
    lda #4
    tsb oc
@out:
    lda oc
    rts

; res = xn * dx / dy + x0 (xclip), res = xn * dy / dx + y0 (yclip)
xclip:
    lda ddx
    sta d1
    lda ddx+1
    sta d1+1
    lda ddy
    sta d2
    lda ddy+1
    sta d2+1
    jsr calcxypt
    clc
    lda __bas_n
    adc __bas_lx0
    sta res
    lda __bas_n+1
    adc __bas_lx0+1
    sta res+1
    rts
yclip:
    lda ddy
    sta d1
    lda ddy+1
    sta d1+1
    lda ddx
    sta d2
    lda ddx+1
    sta d2+1
    jsr calcxypt
    clc
    lda __bas_n
    adc __bas_ly0
    sta res
    lda __bas_n+1
    adc __bas_ly0+1
    sta res+1
    rts

; __bas_n := xn * d1 / d2 in floats (no division by 0), rounded down
calcxypt:
    lda d1
    ldx d1+1
    jsr __float_itof
    ldx #4
@b:
    lda __float_a,x
    sta __float_b,x
    dex
    bpl @b
    lda xn
    ldx xn+1
    jsr __float_itof
    jsr __float_mul
    lda d2
    ora d2+1
    beq @int
    ldx #4
@s:
    lda __float_a,x
    sta ftmp,x
    dex
    bpl @s
    lda d2
    ldx d2+1
    jsr __float_itof
    ldx #4
@b2:
    lda __float_a,x
    sta __float_b,x
    lda ftmp,x
    sta __float_a,x
    dex
    bpl @b2
    jsr __float_div
@int:
    jmp __bas_ayint

.segment "bss"
.global __bas_lx0
.global __bas_ly0
.global __bas_lx1
.global __bas_ly1
__bas_lx0: .res 2           ; (in this order: outcode's X 0 / 4)
__bas_ly0: .res 2
__bas_lx1: .res 2
__bas_ly1: .res 2
maxx: .res 2
maxy: .res 2
ddx:  .res 2
ddy:  .res 2
err:  .res 2
cnt:  .res 2
xn:   .res 2
d1:   .res 2
d2:   .res 2
res:  .res 2
ftmp: .res 5
c0:   .res 1
c1:   .res 1
cc:   .res 1
pt:   .res 1
oc:   .res 1
oct:  .res 1

; ---------------------------------------------------------------------------
;   __bas_gbox  BOX: __bas_g's count (values * 2), then up to 9 words: two
;               corners (+ solid) or four (+ solid), as kg65.box. Solid: the
;               edges 0-3 and 1-2 stepped together (kg65.s.line without
;               addresses, unclipped), a line between them each step; else
;               the four sides (each corner drawn twice)
; ---------------------------------------------------------------------------

.extern __bas_g
.extern __bas_raise

KG_PATBIT2 = $1F4A
E_X = 0                     ; an edge's record (18 bytes, X = 0 or 18)
E_Y = 2
E_X1 = 4
E_Y1 = 6
E_DX = 8
E_DY = 10
E_E = 12
E_N = 14
E_OCT = 16

.segment "code"
    .split "__bas_gbox"
.global __bas_gbox
__bas_gbox:
    lda __bas_g
    ora #2
    sta bcount
    tax
    lda __bas_g-1,x         ; the solid flag's low byte
    sta bsolid
    lda bcount
    cmp #18
    beq @four
    cmp #10
    beq @two
    ; fewer values: nothing; between: ?SYNTAX ERROR
    cmp #10
    bcc @none
    lda #11
    jmp __bas_raise
@none:
    rts
@four:
    ldx #15
@f1:
    lda __bas_g+1,x
    sta cx0,x
    dex
    bpl @f1
    bra @corners
@two:
    ; (x0, y0), (x2, y0), (x2, y2), (x0, y2)
    ldx #1
@t1:
    lda __bas_g+1,x         ; x0
    sta cx0,x
    sta cx0+12,x
    lda __bas_g+3,x         ; y0
    sta cx0+2,x
    sta cx0+6,x
    lda __bas_g+5,x         ; x2
    sta cx0+4,x
    sta cx0+8,x
    lda __bas_g+7,x         ; y2
    sta cx0+10,x
    sta cx0+14,x
    dex
    bpl @t1
@corners:
    lda bsolid
    bne @solid
    ; the frame: 0-1, 1-2, 2-3, 3-0
    lda #0
    sta KG_PATBIT2
    ldy #0
@side:
    sty bk
    ldx #3
@s1:
    lda cx0,y
    sta __bas_lx0
    lda cx0+1,y
    sta __bas_lx0+1
    lda cx0+2,y
    sta __bas_ly0
    lda cx0+3,y
    sta __bas_ly0+1
    ldx bk
    inx
    inx
    inx
    inx
    txa
    and #15
    tax
    lda cx0,x
    sta __bas_lx1
    lda cx0+1,x
    sta __bas_lx1+1
    lda cx0+2,x
    sta __bas_ly1
    lda cx0+3,x
    sta __bas_ly1+1
    jsr __bas_gline0
    lda bk
    clc
    adc #4
    tay
    cpy #16
    bne @side
    rts
@solid:
    ; edge A: corner 0 to 3, edge B: corner 1 to 2
    ldx #3
@e1:
    lda cx0,x
    sta edges+E_X,x
    lda cx0+12,x
    sta edges+E_X1,x
    lda cx0+4,x
    sta edges+18+E_X,x
    lda cx0+8,x
    sta edges+18+E_X1,x
    dex
    bpl @e1
    ldx #0
    jsr einit
    ldx #18
    jsr einit
    bra @draw
@loop:
    ldx #0
    jsr estep
    bcc @b
    rts
@b:
    lda #0
    sta KG_PATBIT2
    ldx #18
    jsr estep
@draw:
    ldx #3
@d1:
    lda edges+E_X,x
    sta __bas_lx0,x
    lda edges+18+E_X,x
    sta __bas_lx1,x
    dex
    bpl @d1
    jsr __bas_gline0
    bra @loop

; edge X: its octant, |dx|, |dy| (swapped when steep), e = -dx / 2, n = $FFFF
einit:
    lda #0
    sta edges+E_OCT,x
    sec
    lda edges+E_X1,x
    sbc edges+E_X,x
    sta edges+E_DX,x
    lda edges+E_X1+1,x
    sbc edges+E_X+1,x
    sta edges+E_DX+1,x
    bpl @i1
    lda #2
    ora edges+E_OCT,x
    sta edges+E_OCT,x
    sec
    lda #0
    sbc edges+E_DX,x
    sta edges+E_DX,x
    lda #0
    sbc edges+E_DX+1,x
    sta edges+E_DX+1,x
@i1:
    sec
    lda edges+E_Y1,x
    sbc edges+E_Y,x
    sta edges+E_DY,x
    lda edges+E_Y1+1,x
    sbc edges+E_Y+1,x
    sta edges+E_DY+1,x
    bpl @i2
    lda #4
    ora edges+E_OCT,x
    sta edges+E_OCT,x
    sec
    lda #0
    sbc edges+E_DY,x
    sta edges+E_DY,x
    lda #0
    sbc edges+E_DY+1,x
    sta edges+E_DY+1,x
@i2:
    sec
    lda edges+E_DX,x
    sbc edges+E_DY,x
    lda edges+E_DX+1,x
    sbc edges+E_DY+1,x
    bpl @i3
    lda edges+E_DX,x        ; swap
    ldy edges+E_DY,x
    sta edges+E_DY,x
    tya
    sta edges+E_DX,x
    lda edges+E_DX+1,x
    ldy edges+E_DY+1,x
    sta edges+E_DY+1,x
    tya
    sta edges+E_DX+1,x
    lda #8
    ora edges+E_OCT,x
    sta edges+E_OCT,x
@i3:
    sec
    lda #0
    sbc edges+E_DX,x
    sta edges+E_E,x
    lda #0
    sbc edges+E_DX+1,x
    cmp #$80
    ror a
    sta edges+E_E+1,x
    ror edges+E_E,x
    lda #$FF
    sta edges+E_N,x
    sta edges+E_N+1,x
    rts

; edge X a dot on: C set when it has reached its end (n >= dx)
estep:
    ldz edges+E_OCT,x
    clc
    lda edges+E_E,x
    adc edges+E_DY,x
    sta edges+E_E,x
    lda edges+E_E+1,x
    adc edges+E_DY+1,x
    sta edges+E_E+1,x
    bmi @s1
    sec
    lda edges+E_E,x
    sbc edges+E_DX,x
    sta edges+E_E,x
    lda edges+E_E+1,x
    sbc edges+E_DX+1,x
    sta edges+E_E+1,x
    inz
@s1:
    tza
    and #8
    beq @s2
    tza
    and #1
    beq @s3
    jsr exstep
@s3:
    jsr eystep
    bra @s4
@s2:
    jsr exstep
    tza
    and #1
    beq @s4
    jsr eystep
@s4:
    inc edges+E_N,x
    bne @s5
    inc edges+E_N+1,x
@s5:
    lda edges+E_N,x
    cmp edges+E_DX,x
    lda edges+E_N+1,x
    sbc edges+E_DX+1,x
    rts

exstep:
    tza
    and #2
    bne @back
    inc edges+E_X,x
    bne @r
    inc edges+E_X+1,x
@r:
    rts
@back:
    lda edges+E_X,x
    bne @b
    dec edges+E_X+1,x
@b:
    dec edges+E_X,x
    rts
eystep:
    tza
    and #4
    bne @back
    inc edges+E_Y,x
    bne @r
    inc edges+E_Y+1,x
@r:
    rts
@back:
    lda edges+E_Y,x
    bne @b
    dec edges+E_Y+1,x
@b:
    dec edges+E_Y,x
    rts

.segment "bss"
cx0:    .res 16             ; the corners: x0, y0, x1, y1, x2, y2, x3, y3
edges:  .res 36
bcount: .res 1
bsolid: .res 1
bk:     .res 1

; ---------------------------------------------------------------------------
;   __bas_gfacet  the solid triangle __bas_fpx / __bas_fpy (3 corners), as
;                 kg65.s.facet: the corners sorted by x (unsigned: (0,1),
;                 (1,2), (0,1)), each column x a vertical line between the
;                 edges' y = base +/- n * dy / dx (the math unit: 16 x 16 ->
;                 32 bits, / 16, the low 16 bits). The edges (Y): 0 corner 0
;                 to 1, 2 corner 0 to 2, 4 corner 1 to 2
; ---------------------------------------------------------------------------

MULTINA = $D770
MULTINB = $D774
PRODUCT = $D778
DIVQUOT = $D76C
MATHBUSY = $D70F

.segment "code"
    .split "__bas_gfacet"
.global __bas_gfacet
__bas_gfacet:
    ldx #0
    jsr fsort
    ldx #2
    jsr fsort
    ldx #0
    jsr fsort
    ; the edges: dx, |dy|, the flag (y back: unsigned borrow), the base y
    ldx #0
    ldy #2
    lda #0
    jsr fedge
    ldx #0
    ldy #4
    lda #2
    jsr fedge
    ldx #2
    ldy #4
    lda #4
    jsr fedge
    lda edx+2
    ora edx+3
    bne @go
    rts
@go:
    lda __bas_fpx
    sta ffx
    lda __bas_fpx+1
    sta ffx+1
    lda #0
    sta fn
    sta fn+1
    lda edx
    ora edx+1
    beq @second
@l1:
    lda fn
    ldx fn+1
    ldy #0
    jsr fend
    sta __bas_ly0
    stx __bas_ly0+1
    lda fn
    ldx fn+1
    ldy #2
    jsr fend
    sta __bas_ly1
    stx __bas_ly1+1
    jsr fcol
    lda ffx                 ; (last when fx >= x1, before it moves on)
    cmp __bas_fpx+2
    lda ffx+1
    sbc __bas_fpx+3
    php
    jsr fnext
    plp
    bcc @l1
@second:
    lda edx+4
    ora edx+5
    bne @l2
    rts
@l2:
    lda fn
    ldx fn+1
    ldy #2
    jsr fend
    sta __bas_ly1
    stx __bas_ly1+1
    sec
    lda ffx
    sbc __bas_fpx+2
    pha
    lda ffx+1
    sbc __bas_fpx+3
    tax
    pla
    ldy #4
    jsr fend
    sta __bas_ly0
    stx __bas_ly0+1
    jsr fcol
    lda ffx
    cmp __bas_fpx+4
    lda ffx+1
    sbc __bas_fpx+5
    php
    jsr fnext
    plp
    bcc @l2
    rts

; the column: (fx, ly0) to (fx, ly1), the pattern from its start
fcol:
    lda ffx
    sta __bas_lx0
    sta __bas_lx1
    lda ffx+1
    sta __bas_lx0+1
    sta __bas_lx1+1
    lda #0
    sta KG_PATBIT2
    jmp __bas_gline0
fnext:
    inc ffx
    bne @a
    inc ffx+1
@a:
    inc fn
    bne @b
    inc fn+1
@b:
    rts

; corners X/2 and X/2 + 1 in x order (unsigned)
fsort:
    lda __bas_fpx+2,x
    cmp __bas_fpx,x
    lda __bas_fpx+3,x
    sbc __bas_fpx+1,x
    bcs @ok
    ldy #1
@sw:
    lda __bas_fpx,x
    pha
    lda __bas_fpx+2,x
    sta __bas_fpx,x
    pla
    sta __bas_fpx+2,x
    lda __bas_fpy,x
    pha
    lda __bas_fpy+2,x
    sta __bas_fpy,x
    pla
    sta __bas_fpy+2,x
    inx
    dey
    bpl @sw
@ok:
    rts

; edge A (0, 2, 4) from corner X to corner Y (byte offsets)
fedge:
    stx fa
    sty fb
    tax                     ; x := the edge
    stx fe
    ldy fa
    lda __bas_fpy,y         ; base: the first corner's y
    sta ebase,x
    lda __bas_fpy+1,y
    sta ebase+1,x
    ; dx = x[b] - x[a]
    ldy fb
    sec
    lda __bas_fpx,y
    ldy fa
    sbc __bas_fpx,y
    sta edx,x
    ldy fb
    lda __bas_fpx+1,y
    ldy fa
    sbc __bas_fpx+1,y
    sta edx+1,x
    ; dy = y[b] - y[a], or its negation (flag) when y[b] < y[a]
    ldy fb
    sec
    lda __bas_fpy,y
    ldy fa
    sbc __bas_fpy,y
    sta edy,x
    ldy fb
    lda __bas_fpy+1,y
    ldy fa
    sbc __bas_fpy+1,y
    sta edy+1,x
    lda #0
    bcs @pos
    sec
    lda #0
    sbc edy,x
    sta edy,x
    lda #0
    sbc edy+1,x
    sta edy+1,x
    lda #1
@pos:
    sta eflag,x
    rts

; A/X := base +/- (A/X) * dy / dx of edge Y
fend:
    sta MULTINA
    stx MULTINA+1
    lda #0
    sta MULTINA+2
    sta MULTINA+3
    sta MULTINB+2
    sta MULTINB+3
    lda edy,y
    sta MULTINB
    lda edy+1,y
    sta MULTINB+1
    ldx #3
@m:
    lda PRODUCT,x
    sta MULTINA,x
    dex
    bpl @m
    lda edx,y
    sta MULTINB
    lda edx+1,y
    sta MULTINB+1
@w:
    bit MATHBUSY
    bmi @w
    lda eflag,y
    bne @sub
    clc
    lda ebase,y
    adc DIVQUOT
    pha
    lda ebase+1,y
    adc DIVQUOT+1
    tax
    pla
    rts
@sub:
    sec
    lda ebase,y
    sbc DIVQUOT
    pha
    lda ebase+1,y
    sbc DIVQUOT+1
    tax
    pla
    rts

.segment "bss"
.global __bas_fpx
.global __bas_fpy
__bas_fpx: .res 6
__bas_fpy: .res 6
edx:   .res 6
edy:   .res 6
ebase: .res 6
eflag: .res 6
ffx:   .res 2
fn:    .res 2
fa:    .res 1
fb:    .res 1
fe:    .res 1

; ---------------------------------------------------------------------------
;   __bas_gepstab  the ellipse's octant table (kg65.s.epstab) for radii
;                  __bas_ecrx / __bas_ecry (__bas_eflag bit 7: not a circle)
;                  in attic RAM ($8710000, __bas_etp its index): $FF, the
;                  first half's steps (old x - new x: 0 / 1) to the turn point
;                  $FE, the second's (new y - old y, 0 below) to $FD, then all
;                  of it reversed back to the $FF. x = floor(SQR(...)) of
;                  ry^2 - y^2 (circle), or rx^2 (ry^2 - y^2) / ry^2 (the math
;                  unit; in floats when the product passes 32 bits)
; ---------------------------------------------------------------------------

.extern __float_ultof
.extern __bas_sqr

ETABLEN = $2000
EPTR = $08                  ; (__zp_scratch: the table byte's 28-bit address)

.segment "code"
    .split "__bas_gepstab"
.global __bas_gepstab
__bas_gepstab:
    ; rqx = rx^2, rqy = ry^2, and as floats
    lda __bas_ecrx
    ldx __bas_ecrx+1
    jsr square
    ldx #3
@q1:
    lda PRODUCT,x
    sta rqx,x
    dex
    bpl @q1
    lda __bas_ecry
    ldx __bas_ecry+1
    jsr square
    ldx #3
@q2:
    lda PRODUCT,x
    sta rqy,x
    dex
    bpl @q2
    lda rqx
    ldx rqx+1
    ldy rqx+2
    ldz rqx+3
    jsr __float_ultof
    ldx #4
@q3:
    lda __float_a,x
    sta xrfp,x
    dex
    bpl @q3
    lda rqy
    ldx rqy+1
    ldy rqy+2
    ldz rqy+3
    jsr __float_ultof
    ldx #4
@q4:
    lda __float_a,x
    sta yrfp,x
    dex
    bpl @q4
    ; the table from its $FF
    lda #0
    sta __bas_etp
    sta __bas_etp+1
    lda #$FF
    jsr eput
    lda #0
    sta ecdx
    sta ecdx+1
    lda __bas_ecrx
    sta ex
    lda __bas_ecrx+1
    sta ex+1
@h1:
    lda ex
    sta ecdy
    lda ex+1
    sta ecdy+1
    inc ecdx
    bne @h1a
    inc ecdx+1
@h1a:
    ; d = rqy - y^2; negative: the turn point
    lda ecdx
    ldx ecdx+1
    jsr square
    sec
    ldx #0
    ldy #4
@h1b:
    lda rqy,x
    sbc PRODUCT,x
    sta ed,x
    inx
    dey
    bne @h1b
    lda ed+3
    bmi @turn
    bit __bas_eflag
    bpl @h1c                ; (a circle: sqrt(d))
    ; rx^2 * d: past 32 bits in floats, else / ry^2
    ldx #3
@h1d:
    lda ed,x
    sta MULTINA,x
    lda rqx,x
    sta MULTINB,x
    dex
    bpl @h1d
    lda PRODUCT+4
    ora PRODUCT+5
    ora PRODUCT+6
    ora PRODUCT+7
    beq @h1e
    jsr dfloat              ; float(d) * xrfp / yrfp
    ldx #4
@h1f:
    lda xrfp,x
    sta __float_b,x
    dex
    bpl @h1f
    jsr __float_mul
    ldx #4
@h1g:
    lda yrfp,x
    sta __float_b,x
    dex
    bpl @h1g
    jsr __float_div
    jsr __bas_sqr
    jsr __bas_ayint
    bra @h1h
@h1e:
    jsr prod2ed
    ldx #3
@h1i:
    lda ed,x
    sta MULTINA,x
    lda rqy,x
    sta MULTINB,x
    dex
    bpl @h1i
    jsr quot                ; ed := the quotient
@h1c:
    jsr esqrt
@h1h:
    ; the step: old x - new x (low bytes); 2 or more: the turn point
    sec
    lda ecdy
    sbc __bas_n
    cmp #2
    bcs @turn
    jsr eput
    lda __bas_n
    sta ex
    lda __bas_n+1
    sta ex+1
    jmp @h1
@turn:
    lda #$FE
    jsr eput
    ; x = y - 1, y = the last x
    lda ecdx
    bne @t1
    dec ecdx+1
@t1:
    dec ecdx
    lda ecdx
    sta ex
    lda ecdx+1
    sta ex+1
    lda ecdy
    sta ecdx
    lda ecdy+1
    sta ecdx+1
@h2:
    lda ex
    sta ecdy
    lda ex+1
    sta ecdy+1
    lda ecdx
    bne @h2a
    dec ecdx+1
@h2a:
    dec ecdx
    lda ecdx+1
    bmi @end
    ; d = rqx - x^2
    lda ecdx
    ldx ecdx+1
    jsr square
    sec
    ldx #0
    ldy #4
@h2b:
    lda rqx,x
    sbc PRODUCT,x
    sta ed,x
    inx
    dey
    bne @h2b
    bit __bas_eflag
    bpl @h2c
    ; (d * ry^2, its low 32 bits) / rx^2
    ldx #3
@h2d:
    lda ed,x
    sta MULTINA,x
    lda rqy,x
    sta MULTINB,x
    dex
    bpl @h2d
    jsr prod2ed
    ldx #3
@h2e:
    lda ed,x
    sta MULTINA,x
    lda rqx,x
    sta MULTINB,x
    dex
    bpl @h2e
    jsr quot
@h2c:
    jsr esqrt
    ; new y - old y (low bytes), 0 below
    sec
    lda __bas_n
    sbc ecdy
    bcs @h2f
    lda #0
@h2f:
    jsr eput
    lda ecdx
    ora ecdx+1
    beq @end
    lda __bas_n
    sta ex
    lda __bas_n+1
    sta ex+1
    jmp @h2
@end:
    ; $FD (not counted), then everything back to the $FF reversed after it
    lda __bas_etp
    sta esrc
    sta edst
    lda __bas_etp+1
    sta esrc+1
    sta edst+1
    lda #$FD
    ldx #edst-ebase0
    jsr eput2
@rev:
    lda esrc
    bne @r1
    dec esrc+1
@r1:
    dec esrc
    inc edst
    bne @r2
    inc edst+1
@r2:
    ldx #esrc-ebase0
    jsr eget2
    pha
    ldx #edst-ebase0
    jsr eput2
    pla
    cmp #$FF
    bne @rev
    rts

; PRODUCT := (A/X) squared
square:
    sta MULTINA
    sta MULTINB
    stx MULTINA+1
    stx MULTINB+1
    lda #0
    sta MULTINA+2
    sta MULTINB+2
    sta MULTINA+3
    sta MULTINB+3
    rts

; ed := PRODUCT's low 32 bits
prod2ed:
    ldx #3
@p:
    lda PRODUCT,x
    sta ed,x
    dex
    bpl @p
    rts

; ed := MULTINA / MULTINB (the divider's quotient)
quot:
@w:
    bit MATHBUSY
    bmi @w
    ldx #3
@q:
    lda DIVQUOT,x
    sta ed,x
    dex
    bpl @q
    rts

; __float_a := float(ed) (unsigned 32 bits)
dfloat:
    lda ed
    ldx ed+1
    ldy ed+2
    ldz ed+3
    jmp __float_ultof

; __bas_n := floor(SQR(ed))
esqrt:
    jsr dfloat
    jsr __bas_sqr
    jmp __bas_ayint

; the table byte A at __bas_etp (then __bas_etp + 1), below ETABLEN
eput:
    pha
    lda __bas_etp+1
    cmp #>ETABLEN
    bcs @skip
    jsr eaddr
    pla
    ldz #0
    sta [EPTR],z
    bra @inc
@skip:
    pla
@inc:
    inc __bas_etp
    bne @r
    inc __bas_etp+1
@r:
    rts
eaddr:
    lda __bas_etp
    sta EPTR
    lda __bas_etp+1
    sta EPTR+1
    lda #$71
    sta EPTR+2
    lda #$08
    sta EPTR+3
    rts
; A at the index ebase0+X (esrc / edst), below ETABLEN; A from it
eput2:
    pha
    lda ebase0+1,x
    cmp #>ETABLEN
    bcs @skip
    jsr eaddr2
    pla
    ldz #0
    sta [EPTR],z
    rts
@skip:
    pla
    rts
eget2:
    jsr eaddr2
    ldz #0
    lda [EPTR],z
    rts
eaddr2:
    lda ebase0,x
    sta EPTR
    lda ebase0+1,x
    sta EPTR+1
    lda #$71
    sta EPTR+2
    lda #$08
    sta EPTR+3
    rts

.segment "bss"
.global __bas_ecrx
.global __bas_ecry
.global __bas_eflag
.global __bas_etp
__bas_ecrx: .res 2
__bas_ecry: .res 2
__bas_eflag: .res 1
__bas_etp:  .res 2
rqx:    .res 4
rqy:    .res 4
xrfp:   .res 5
yrfp:   .res 5
ed:     .res 4
ex:     .res 2
ecdx:   .res 2
ecdy:   .res 2
ebase0:
esrc:   .res 2
edst:   .res 2

; ---------------------------------------------------------------------------
;   __bas_gfill  PAINT x, y, mode, colour (_bas_g[1-8] as GKI.parm; mode 1's
;                colour already the colour's index): kg65.paint, s.rfill and
;                s.push. The fill's stack (16 bytes a span) is in attic RAM at
;                $8700000, as long as the kernel's would be after a short
;                program ($2100-$F6FF); full, the fill stops
; ---------------------------------------------------------------------------

PSTACK_HI = $D6             ; (psp + 16 from $D600 up: full)

.segment "code"
    .split "__bas_gfill"
.global __bas_gfill
__bas_gfill:
    lda __bas_g+3
    sta sy
    sta pty
    lda __bas_g+4
    sta sy+1
    sta pty+1
    lda __bas_g+5
    sta pmode
    lda __bas_g+7
    sta pbc
    lda #0
    sta psp
    sta psp+1
    lda pmode
    beq @m0
    cmp #1
    beq @go
    cmp #2
    bne @ret
    lda KG_PENS
    sta pbc
    jsr pxy
    bcs @ret
    cmp #0
    beq @ret                ; (an empty start dot: nothing)
    bra @go
@m0:
    jsr pxy
    sta pbc                 ; (0 beyond the viewport)
@go:
    lda __bas_g+1
    ldx __bas_g+2
    jsr inside
    beq @ret
    ; the start's span
    lda __bas_g+1
    sta sl
    lda __bas_g+2
    sta sl+1
@l:
    lda sl
    bne @l1
    dec sl+1
@l1:
    dec sl
    lda sl
    ldx sl+1
    jsr inside
    bne @l
    inc sl
    bne @l2
    inc sl+1
@l2:
    lda __bas_g+1
    sta sr
    lda __bas_g+2
    sta sr+1
@r:
    inc sr
    bne @r1
    inc sr+1
@r1:
    lda sr
    ldx sr+1
    jsr inside
    bne @r
    lda sr
    bne @r2
    dec sr+1
@r2:
    dec sr
    ldx #sl-pvars
    ldy #sr-pvars
    jsr span
    ; up (d = 1), then down (d = -1)
    jsr startsp
    lda sy
    sec
    sbc #1
    sta pty
    lda sy+1
    sbc #0
    sta pty+1
    lda #1
    sta pd
    jsr rfill
    jsr startsp
    lda sy
    clc
    adc #1
    sta pty
    lda sy+1
    adc #0
    sta pty+1
    lda #$FF
    sta pd
    jmp rfill
@ret:
    rts

; lx = pl = sl, rx = pr = sr
startsp:
    lda sl
    sta plx
    sta ppl
    lda sl+1
    sta plx+1
    sta ppl+1
    lda sr
    sta prx
    sta ppr
    lda sr+1
    sta prx+1
    sta ppr+1
    rts

; A := the colour index at (x, y) of the parameters (__bas_gpix)
pxy:
    lda __bas_g+1
    sta __bas_gx
    lda __bas_g+2
    sta __bas_gx+1
    lda sy
    sta __bas_gy
    lda sy+1
    sta __bas_gy+1
    jmp __bas_gpix

; A (Z clear) := 1 when (A/X, ty) is inside the boundary, else 0 (Z set)
inside:
    sta __bas_gx
    stx __bas_gx+1
    lda pty
    sta __bas_gy
    lda pty+1
    sta __bas_gy+1
    jsr __bas_gpix
    bcs @no
    ldx pmode
    beq @m0
    dex
    beq @m1
    cmp #0                  ; mode 2: not 0, not the colour
    beq @no
    cmp pbc
    beq @no
    bra @yes
@m1:
    cmp KG_PENS             ; mode 1: neither pen 0 nor the colour
    beq @no
    cmp pbc
    beq @no
    bra @yes
@m0:
    cmp pbc                 ; mode 0: the start dot's colour
    bne @no
@yes:
    lda #1
    rts
@no:
    lda #0
    rts

; the line from pvars+X to pvars+Y on ty (the pattern from its start)
span:
    lda pvars,x
    sta __bas_lx0
    lda pvars+1,x
    sta __bas_lx0+1
    lda pvars,y
    sta __bas_lx1
    lda pvars+1,y
    sta __bas_lx1+1
    lda pty
    sta __bas_ly0
    sta __bas_ly1
    lda pty+1
    sta __bas_ly0+1
    sta __bas_ly1+1
    lda #0
    sta KG_PATBIT
    jmp __bas_gline0

; the stack's PTR at psp
spaddr:
    lda psp
    sta PTR
    lda psp+1
    sta PTR+1
    lda #$70
    sta PTR+2
    lda #$08
    sta PTR+3
    rts

; nl..d stacked; carry set: the stack is full
push:
    sta prp
    clc
    lda psp
    adc #16
    lda psp+1
    adc #0
    cmp #PSTACK_HI
    bcs @full
    jsr spaddr
    ldx #15
@c:
    txa
    taz
    lda pvars,x
    sta [PTR],z
    dex
    bpl @c
    lda psp
    clc
    adc #16
    sta psp
    bcc @ok
    inc psp+1
@ok:
    clc
@full:
    rts

pop:
    lda psp
    sec
    sbc #16
    sta psp
    bcs @p
    dec psp+1
@p:
    jsr spaddr
    ldx #15
@c:
    txa
    taz
    lda [PTR],z
    sta pvars,x
    dex
    bpl @c
    rts

; ty one row in d's direction (back: opposite = 1)
tyfwd:
    bit pd
    bmi tyinc
tydec:
    lda pty
    bne @d
    dec pty+1
@d:
    dec pty
    rts
tyback:
    bit pd
    bmi tydec
tyinc:
    inc pty
    bne @i
    inc pty+1
@i:
    rts

; inside(nl, ty) / inside(nr, ty)
insnl:
    lda pnl
    ldx pnl+1
    jmp inside
insnr:
    lda pnr
    ldx pnr+1
    jmp inside

; the spans next to [lx, rx] on line ty, then back from the stack (s.rfill)
rfill:
@fill:
    lda plx
    sta pnl
    lda plx+1
    sta pnl+1
@l10:
    jsr insnl
    beq @l14
    lda pnl
    sta pnr
    lda pnl+1
    sta pnr+1
@l11:
    lda pnl
    bne @l12
    dec pnl+1
@l12:
    dec pnl
    jsr insnl
    bne @l11
    inc pnl
    bne @l18
    inc pnl+1
    bra @l18
@l14:
    inc pnl
    bne @l15
    inc pnl+1
@l15:
    jsr insnl
    bne @l16
    lda prx                 ; rx < nl: stop
    cmp pnl
    lda prx+1
    sbc pnl+1
    bcs @l14
@l16:
    lda pnl
    sta pnr
    lda pnl+1
    sta pnr+1
@l18:
    lda pnl                 ; nl >= rx: back
    cmp prx
    lda pnl+1
    sbc prx+1
    bcc @l19
    jmp @l42
@l19:
    inc pnr
    bne @l20
    inc pnr+1
@l20:
    jsr insnr
    bne @l19
    lda pnr
    bne @l21
    dec pnr+1
@l21:
    dec pnr
    ldx #pnl-pvars
    ldy #pnr-pvars
    jsr span
    lda #1
    jsr push
    bcs @done
    lda pnl
    sta plx
    sta ppl
    lda pnl+1
    sta plx+1
    sta ppl+1
    lda pnr
    sta prx
    sta ppr
    lda pnr+1
    sta prx+1
    sta ppr+1
    jsr tyfwd
    jmp @fill
@done:
    rts
@l28:
    sec
    lda ppl
    sbc #2
    sta ptmp
    lda ppl+1
    sbc #0
    sta ptmp+1
    bmi @l34                ; (below 0)
    lda ptmp                ; tmp < nl: on
    cmp pnl
    lda ptmp+1
    sbc pnl+1
    bcc @l34
    lda #2
    jsr push
    bcs @done
    lda pnl
    sta plx
    sta ppl
    lda pnl+1
    sta plx+1
    sta ppl+1
    lda ptmp
    sta prx
    lda ptmp+1
    sta prx+1
    lda pnr
    sta ppr
    lda pnr+1
    sta ppr+1
    jsr tyback
    jmp @neg
@l34:
    clc
    lda ppr
    adc #2
    sta ptmp
    lda ppr+1
    adc #0
    sta ptmp+1
    lda pnr                 ; nr < tmp: on
    cmp ptmp
    lda pnr+1
    sbc ptmp+1
    bcc @l40
    lda #3
    jsr push
    bcs @done
    lda ptmp
    sta plx
    lda ptmp+1
    sta plx+1
    lda pnr
    sta prx
    sta ppr
    lda pnr+1
    sta prx+1
    sta ppr+1
    jsr tyback
    lda pnl
    sta ppl
    lda pnl+1
    sta ppl+1
@neg:
    lda #0
    sec
    sbc pd
    sta pd
    jmp @fill
@l40:
    clc
    lda pnr
    adc #2
    sta pnl
    lda pnr+1
    adc #0
    sta pnl+1
    lda pnl                 ; nl < rx: again
    cmp prx
    lda pnl+1
    sbc prx+1
    bcs @l42
    jmp @l10
@l42:
    lda psp
    ora psp+1
    beq @done
    jsr pop
    lda prp
    cmp #1
    bne @p2
    jmp @l28
@p2:
    cmp #2
    beq @l34
    cmp #3
    beq @l40
    rts

.segment "bss"
pvars:                      ; (stacked in this order, 16 bytes)
pnl:    .res 2
pnr:    .res 2
plx:    .res 2
prx:    .res 2
pty:    .res 2
ppl:    .res 2
ppr:    .res 2
prp:    .res 1
pd:     .res 1
sl:     .res 2              ; (span's X / Y offsets from pvars: after it)
sr:     .res 2
sy:     .res 2
ptmp:   .res 2
psp:    .res 2
pmode:  .res 1
pbc:    .res 1

; ---------------------------------------------------------------------------
;   __bas_gellipse  ELLIPSE / CIRCLE: _bas_g as GKI.parm (count, then words
;                   cx, cy, xr, yr, flag, start, end): kg65.ellipse, the
;                   table (__bas_gepstab), cdot, octa / octb, solide
; ---------------------------------------------------------------------------

.extern __bas_fdiv
.extern __float_atn
.extern __float_itof
.extern __float_mul

; (evars offsets)
E_X0 = 0
E_Y0 = 2
E_DX = 4
E_DY = 6

.segment "code"
    .split "__bas_gellipse"
.global __bas_gellipse
__bas_gellipse:
    ldx #13
@a:
    lda __bas_g+1,x
    sta eargs,x
    dex
    bpl @a
    ldx #3
@r:
    lda earg_rx,x
    sta __bas_ecrx,x        ; (ecrx, ecry together)
    dex
    bpl @r
    lda earg_f
    sta __bas_eflag
    lda __bas_ecrx
    cmp __bas_ecry
    bne @ne
    lda __bas_ecrx+1
    cmp __bas_ecry+1
    beq @eq
@ne:
    lda __bas_eflag
    ora #$80
    sta __bas_eflag
@eq:
    ; a radius 0: a line
    lda __bas_ecrx
    ora __bas_ecrx+1
    bne @rx
    lda ecx
    sta __bas_lx0
    sta __bas_lx1
    lda ecx+1
    sta __bas_lx0+1
    sta __bas_lx1+1
    sec
    lda ecy
    sbc __bas_ecry
    sta __bas_ly0
    lda ecy+1
    sbc __bas_ecry+1
    sta __bas_ly0+1
    clc
    lda ecy
    adc __bas_ecry
    sta __bas_ly1
    lda ecy+1
    adc __bas_ecry+1
    sta __bas_ly1+1
    jmp __bas_gline0
@rx:
    lda __bas_ecry
    ora __bas_ecry+1
    bne @ry
    lda ecy
    sta __bas_ly0
    sta __bas_ly1
    lda ecy+1
    sta __bas_ly0+1
    sta __bas_ly1+1
    sec
    lda ecx
    sbc __bas_ecrx
    sta __bas_lx0
    lda ecx+1
    sbc __bas_ecrx+1
    sta __bas_lx0+1
    clc
    lda ecx
    adc __bas_ecrx
    sta __bas_lx1
    lda ecx+1
    adc __bas_ecrx+1
    sta __bas_lx1+1
    jmp __bas_gline0
@ry:
    ; a sector
    lda estart
    ora estart+1
    ora eend
    ora eend+1
    beq @tab
    lda __bas_eflag
    ora #$10
    sta __bas_eflag
    jsr ecmpse
    bcs @s1
    lda __bas_eflag
    ora #$20
    sta __bas_eflag
@s1:
    lda __bas_eflag
    and #4
    beq @s2
    ldx #eend-eargs         ; (from 12 o'clock: 90 less, 360 more below 0)
    jsr eminus90
    ldx #estart-eargs
    jsr eminus90
@s2:
    jsr ecmpse
    bcs @tab
    lda __bas_eflag
    ora #$28
    sta __bas_eflag
@tab:
    jsr __bas_gepstab
    jsr resettp
    lda __bas_eflag
    and #$11
    cmp #1
    bne @nsol
    jmp solide
@nsol:
    lda __bas_eflag
    and #4
    beq @o3
    ; from 12 o'clock: octb from the $FD, then octa
    lda ecx
    sta ex0
    lda ecx+1
    sta ex0+1
    sec
    lda ecy
    sbc __bas_ecry
    sta ey0
    lda ecy+1
    sbc __bas_ecry+1
    sta ey0+1
@fd:
    jsr enext
    cmp #$FD
    bne @fd
    jsr octb
    jsr resettp
    jsr etpdec
    jmp octa
@o3:
    jsr x0rx
    jsr etpdec
    jsr octa
octb:
    ldx #6*4
    jsr octant
    ldx #7*4
    jmp octant

; carry clear: end < start
ecmpse:
    lda eend
    cmp estart
    lda eend+1
    sbc estart+1
    rts

; the angle at eargs+X: 90 less, or 270 more below 90
eminus90:
    lda eargs+1,x
    bne @sub
    lda eargs,x
    cmp #90
    bcs @sub
    adc #<270
    sta eargs,x
    lda #>270
    sta eargs+1,x
    rts
@sub:
    sec
    lda eargs,x
    sbc #90
    sta eargs,x
    bcs @r
    dec eargs+1,x
@r:
    rts

; x0 = cx + xr, y0 = cy
x0rx:
    clc
    lda ecx
    adc __bas_ecrx
    sta ex0
    lda ecx+1
    adc __bas_ecrx+1
    sta ex0+1
    lda ecy
    sta ey0
    lda ecy+1
    sta ey0+1
    rts

resettp:
    lda #0
    sta __bas_etp
    sta __bas_etp+1
    lda #$FF
    jmp eput
etpdec:
    lda __bas_etp
    bne @d
    dec __bas_etp+1
@d:
    dec __bas_etp
    rts

; A := the table's next entry ($FD past its end)
enext:
    inc __bas_etp
    bne @n
    inc __bas_etp+1
@n:
    lda __bas_etp+1
    cmp #>ETABLEN
    bcs @end
    jsr eaddr
    ldz #0
    lda [EPTR],z
    rts
@end:
    lda #$FD
    rts

octa:
    ldx #0
    jsr octant
    ldx #1*4
    jsr octant
    ldx #2*4
    jsr octant
    ldx #3*4
    jsr octant
    jsr resettp
    jsr etpdec
    ldx #4*4
    jsr octant
    ldx #5*4
    ; (fall through)

; an octant: the points to an entry with bit 7, each step (x0, y0) +
; (mx, my), an entry's 1 also + (ex, ey): octtab+X (ex, ey, mx, my)
octant:
    stx octi
@l:
    jsr cdot
    bmi @r
    ldx octi
    cmp #0
    beq @m
    lda octtab,x
    ldy #E_X0
    jsr addsb
    lda octtab+1,x
    ldy #E_Y0
    jsr addsb
@m:
    lda octtab+2,x
    ldy #E_X0
    jsr addsb
    lda octtab+3,x
    ldy #E_Y0
    jsr addsb
    bra @l
@r:
    rts

; evars+Y += the signed byte A (X kept)
addsb:
    sta etmp
    lda #0
    bit etmp
    bpl @p
    lda #$FF
@p:
    sta etmp+1
    clc
    lda evars,y
    adc etmp
    sta evars,y
    lda evars+1,y
    adc etmp+1
    sta evars+1,y
    rts

; the point (x0, y0): the sector's test, legs, a solid sector's lines; A
; the next entry
cdot:
    lda __bas_eflag
    and #$10
    beq @dot
    jsr eatan
    ; in: start <= a < end (or start <= a or a < end: bit 3)
    lda eang
    cmp estart
    lda eang+1
    sbc estart+1
    rol etmp                ; (bit 0: a >= start)
    lda eang
    cmp eend
    lda eang+1
    sbc eend+1              ; (carry clear: a < end)
    lda __bas_eflag
    and #8
    bne @or
    bcs @out
    lda etmp
    lsr a
    bcc @out
    bra @in
@or:
    bcc @in
    lda etmp
    lsr a
    bcc @out
@in:
    lda __bas_eflag
    and #$20
    bne @dot
    lda __bas_eflag
    ora #$20
    sta __bas_eflag
    bra @leg
@out:
    lda __bas_eflag
    and #$20
    beq @next
    lda __bas_eflag
    and #$DF
    sta __bas_eflag
@leg:
    lda __bas_eflag
    and #3
    cmp #2
    beq @noleg              ; (a leg unless only bit 1)
    jsr clinep
@noleg:
    lda __bas_eflag
    and #$20
    beq @next
@dot:
    ; the dot, inside the viewport
    lda ex0
    cmp KG_VPMAXX
    lda ex0+1
    sbc KG_VPMAXX+1
    bcs @solid
    lda ey0
    cmp KG_VPMAXY
    lda ey0+1
    sbc KG_VPMAXY+1
    bcs @solid
    lda ex0
    cmp KG_VPMINX
    lda ex0+1
    sbc KG_VPMINX+1
    bcc @solid
    lda ey0
    cmp KG_VPMINY
    lda ey0+1
    sbc KG_VPMINY+1
    bcc @solid
    lda ex0
    sta __bas_gx
    lda ex0+1
    sta __bas_gx+1
    lda ey0
    sta __bas_gy
    lda ey0+1
    sta __bas_gy+1
    jsr __bas_gplot
@solid:
    lda __bas_eflag
    and #$01
    beq @next
    jsr clinep
    ; to (x0, y0 -1 / +1 toward the centre: y0 >= cy signed)
    lda ex0
    sta __bas_lx1
    lda ex0+1
    sta __bas_lx1+1
    lda ey0
    cmp ecy
    lda ey0+1
    sbc ecy+1
    bvc @v
    eor #$80
@v:
    bmi @up
    sec
    lda ey0
    sbc #1
    sta __bas_ly1
    lda ey0+1
    sbc #0
    bra @ly
@up:
    clc
    lda ey0
    adc #1
    sta __bas_ly1
    lda ey0+1
    adc #0
@ly:
    sta __bas_ly1+1
    jsr cline1
@next:
    jmp enext

; the line from the centre to (x0, y0)
clinep:
    lda ex0
    sta __bas_lx1
    lda ex0+1
    sta __bas_lx1+1
    lda ey0
    sta __bas_ly1
    lda ey0+1
    sta __bas_ly1+1
cline1:
    lda ecx
    sta __bas_lx0
    lda ecx+1
    sta __bas_lx0+1
    lda ecy
    sta __bas_ly0
    lda ecy+1
    sta __bas_ly0+1
    jmp __bas_gline0

; eang := the angle of (x0 - cx, y0 - cy) in degrees, 0-359 (kg65.s.atan)
eatan:
    sec
    lda ex0
    sbc ecx
    sta adx
    lda ex0+1
    sbc ecx+1
    sta adx+1
    sec
    lda ey0
    sbc ecy
    sta ady
    lda ey0+1
    sbc ecy+1
    sta ady+1
    lda adx
    ora adx+1
    bne @f
    ldx #<90
    ldy #>90
    bit ady+1
    bpl @set
    ldx #<270
    ldy #>270
@set:
    stx eang
    sty eang+1
    rts
@f:
    lda adx
    ldx adx+1
    jsr __float_itof
    ldx #4
@b:
    lda __float_a,x
    sta __float_b,x
    dex
    bpl @b
    lda ady
    ldx ady+1
    jsr __float_itof
    jsr __bas_fdiv
    jsr __float_atn
    ldx #4
@k:
    lda deg,x
    sta __float_b,x
    dex
    bpl @k
    jsr __float_mul
    jsr __bas_ayint
    lda __bas_n
    sta eang
    lda __bas_n+1
    sta eang+1
    bit adx+1
    bpl @p
    clc
    lda eang
    adc #180
    sta eang
    bcc @p
    inc eang+1
@p:
    bit eang+1
    bpl @r
    clc
    lda eang
    adc #<360
    sta eang
    lda eang+1
    adc #>360
    sta eang+1
@r:
    rts

; the full solid ellipse: lines between the arc's points and their mirror
; (a column whose low byte was the last one's skipped)
solide:
    jsr x0rx
    jsr etpdec
    ldx #3
@c:
    lda evars,x
    sta evars+E_DX,x
    dex
    bpl @c
    lda #1
    jsr sline
    ldx #0
    jsr squarter
    lda #0
    jsr sline
    ldx #1*4
    jsr squarter
    lda #0
    jsr sline
    ldx #2*4
    jsr squarter
    lda #0
    jsr sline
    ldx #3*4
    ; (fall through)

; a quarter from entry A, octtab+X's steps (dx, dy as x0, y0 mirrored)
squarter:
    stx octi
@l:
    cmp #0
    bmi @r
    ldx octi
    cmp #0
    beq @m
    lda octtab,x
    jsr step2x
    lda octtab+1,x
    jsr step2y
@m:
    lda octtab+2,x
    jsr step2x
    lda octtab+3,x
    jsr step2y
    lda #0
    jsr sline
    bra @l
@r:
    rts
step2x:
    pha
    ldy #E_X0
    jsr addsb
    pla
    ldy #E_DX
    jmp addsb
step2y:
    pha
    ldy #E_Y0
    jsr addsb
    pla
    eor #$FF
    clc
    adc #1
    ldy #E_DY
    jmp addsb

; the line (x0, y0)-(dx, dy) unless A = 0 and x0's low byte is the last
; one's; A the next entry
sline:
    cmp #0
    bne @draw
    lda ex0
    cmp elast
    beq @skip
@draw:
    ldx #7
@c:
    lda evars,x
    sta __bas_lx0,x
    dex
    bpl @c
    lda ex0
    sta elast
    jsr __bas_gline0
@skip:
    jmp enext

octtab:
    .byte $FF, 0, 0, 1
    .byte 0, 1, $FF, 0
    .byte 0, $FF, $FF, 0
    .byte $FF, 0, 0, $FF
    .byte 1, 0, 0, $FF
    .byte 0, $FF, 1, 0
    .byte 0, 1, 1, 0
    .byte 1, 0, 0, 1
deg:    .byte $86, $65, $2E, $E0, $D3   ; (180 / pi)

.segment "bss"
eargs:                      ; (_bas_g 1-14)
ecx:    .res 2
ecy:    .res 2
earg_rx: .res 2
earg_ry: .res 2
earg_f: .res 2
estart: .res 2
eend:   .res 2
evars:                      ; (x0, y0, dx, dy: the line's lx0..ly1 order)
ex0:   .res 2
ey0:   .res 2
emx:   .res 2
emy:   .res 2
adx:    .res 2
ady:    .res 2
eang:   .res 2
etmp:   .res 2
octi:   .res 1
elast:  .res 1
