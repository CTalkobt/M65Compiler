; __builtin_trap — unconditional abnormal termination (#761)
;
; cc45 compiles __builtin_trap() to a call here. The program ends as abort()
; does (exit status $FFFE at $FD/$FE) through crt0's __abort, which a program
; cannot override, so neither a user's abort() nor the atexit handlers run.
; No calls through pointers here (ln45's call graph).
.weak cc45.icallinfo
cc45.icallinfo = 1

.global ___builtin_trap
.extern __abort
.segment "code"

___builtin_trap:
    jmp __abort
