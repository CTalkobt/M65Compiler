; memcpy.s — Copy memory area (ZP calling convention), by DMA (#325)
;
; void *memcpy(void *dest, void *src, int n);
;   Copies n bytes from src to dest. Returns dest.

; no calls through pointers here (ln45's call graph)
.weak cc45.icallinfo
cc45.icallinfo = 1

.global _memcpy
.extern __dma_mem

.segment "code"

proc _memcpy
    .zp_uses $10, $11, $12, $13, $14, $15
    .zp_clobbers $10, $11, $12, $13, $14, $15
    .zp_release $12, $13, $14, $15
    .reg_clobbers A, X, Y, Z
    .flag_clobbers C, N, Z

    ; dest=$10/$11, src=$12/$13, n=$14/$15
    lda $14
    ora $15
    beq @none               ; (a DMA length of 0 is 64 KB)
    lda #0                  ; copy, upwards
    jmp __dma_mem
@none:
    lda $10
    ldx $11
    rts
    .func_flags zp_call
    endproc
