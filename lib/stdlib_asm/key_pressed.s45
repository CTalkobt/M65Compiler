; key_pressed.s45 — is a key held down? (ZP calling convention)
;
; __regparm unsigned char key_pressed(unsigned char keycode);
;   keycode = (column << 3) | row  (see the KEY_* constants in mega65.h)
;   Returns 1 if the key is down, 0 if not.
;
; Reads the MEGA65's own keyboard matrix view: write a row number (0-7, 8 =
; the C65 extra keys) to $D614, read that row's 8 keys at $D613 (a bit 0 =
; down). Unlike a scan through CIA 1 ($DC00/$DC01) it does not depend on the
; joysticks (which share the CIA's lines), on the KERNAL's own keyboard scan
; in its interrupt, or on the CIA port settings.
;
; First param arrives in A via __regparm convention.

.global _key_pressed

.segment "code"

proc _key_pressed
    .reg_clobbers A, X, Y
    .flag_clobbers C, N, Z

    tay                 ; Y = keycode
    and #$07
    sta $D614           ; the matrix row to read
    tya
    lsr
    lsr
    lsr
    and #$07
    tax                 ; X = the key's bit in the row
    lda $D613           ; the row: a bit 0 = key down
    eor #$FF
    and @bit_table,x
    beq @not_pressed
    lda #1
    rts
@not_pressed:
    lda #0
    rts

@bit_table:
    .byte $01, $02, $04, $08, $10, $20, $40, $80

    .func_flags zp_call, leaf
    endproc
