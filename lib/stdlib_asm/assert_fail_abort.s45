; assert_fail_abort.s — end of a failed assert / assert_msg (ZP convention)
; Called after the message is printed. No return: calls abort(), as C
; specifies for a failed assertion (exit status $FFFE, atexit handlers
; not run).

; no calls through pointers here (ln45's call graph)
.weak cc45.icallinfo
cc45.icallinfo = 1

.global _assert_fail_abort
.extern _abort

.segment "code"

proc _assert_fail_abort
    jmp _abort
    .zp_clobbers
    .reg_clobbers
    .flag_clobbers
    .func_flags zp_call
    endproc
