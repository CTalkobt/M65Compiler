; memset.s — Fill memory with a byte value (ZP calling convention), by DMA
; (#325)
;
; void *memset(void *s, int c, int n);
;   Fills n bytes at address s with byte c. Returns s.

; no calls through pointers here (ln45's call graph)
.weak cc45.icallinfo
cc45.icallinfo = 1

.global _memset
.extern __dma_mem

.segment "code"

proc _memset
    .zp_uses $10, $11, $12, $13, $14, $15
    .zp_clobbers $10, $11, $12, $13, $14, $15
    .zp_release $12, $13, $14, $15
    .reg_clobbers A, X, Y, Z
    .flag_clobbers C, N, Z

    ; s=$10/$11, c=$12 (low byte: the fill job's source), n=$14/$15
    lda $14
    ora $15
    beq @none               ; (a DMA length of 0 is 64 KB)
    lda #3                  ; fill
    jmp __dma_mem
@none:
    lda $10
    ldx $11
    rts
    .func_flags zp_call
    endproc
