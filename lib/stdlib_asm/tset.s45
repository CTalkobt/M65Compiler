; tset.s45 — an ordered set in a red-black tree: struct tset's methods (<set.h>, #403)
;
;   void  tset::init(size_t esize, int (*cmp)(const void *, const void *))   this $10, $12, $14
;   int   tset::insert(const void *key)      1 inserted, 0 there already, -1 no memory
;   int   tset::erase(const void *key)       1 erased, 0 not there
;   void *tset::find(const void *key), *tset::lower_bound(const void *key)
;   void *tset::first(), *tset::next(void *e)            in order; NULL at the end
;   size_t tset::size(); void tset::clear(), tset::free()   (both free every node)
;
; struct tset: root (0), len (2), esize (4), cmp (6), ksize (8: the key's
; bytes; esize in a set). struct tmap (#407) is a tset whose element is the
; key and then the value: insert copies ksize bytes from the key and the
; rest from the value at $14, and on an element already there copies the
; value over it (tmap::put is tset::insert). A node (malloc,
; 7 + esize bytes): link[0] (0, the lower side), link[1] (2), parent (4),
; colour (6: 0 black, 1 red), the element (7). A direction is the link's
; offset, 0 or 2 (the other: d ^ 2), so each pair of mirrored cases is one:
; rotate(x, d) turns x down towards d. Insert and erase relink nodes, never
; move elements: an element stays where it is until it is erased.
;
; The working pointers are in the zero page ($10-$2B, D and CL at $08/$09:
; the parameter block, which a caller does not keep across a call), so a
; node's fields are (ptr),y. cmp (called through __ct_cmp, stdlib/ct_shim.c),
; malloc and free may change any of it: around them it is kept in BSS
; (__ts_save / __ts_restore) — not reentrant, and cmp must not use a set.
; cmp NULL compares the key's bytes, unsigned, the first first.

.global _tset__init, _tset__insert, _tset__erase, _tset__find, _tset__lower_bound
.global _tset__first, _tset__next, _tset__size, _tset__clear, _tset__free
.global __ts_compare
.global _tmap__init, _tmap__put, _tmap__get, _tmap__erase, _tmap__find, _tmap__lower_bound
.global _tmap__first, _tmap__next, _tmap__size, _tmap__clear, _tmap__free
.extern __ct_copy, __ct_bytecmp, ___ct_cmp, ___ct_cmpf, _malloc, _free

; the comparison through __ct_cmp (a C function: ln45's call graph knows it)
.weak cc45.icallinfo
cc45.icallinfo = 1

D       = $08       ; a direction: 0 or 2
CL      = $09       ; the colour taken out (erase)
CT_ES   = $0A       ; (container.s45's: copy and compare)
CT_P    = $0C
CT_Q    = $0E
TP      = $0C       ; a node (the colour helpers)
T       = $10       ; the tree
K       = $12       ; the key (next: the element)
VAL     = $14       ; the value (a map's insert)
N       = $16       ; nodes
P       = $18
XN      = $1A
XP      = $1C
W       = $1E
YN      = $20
R       = $20       ; (the search's lower bound: not at the same time as YN)
ZN      = $22
TU      = $24       ; rotate's x, transplant's u
TV      = $26       ; rotate's y, transplant's v
TW      = $28       ; rotate's w
TG      = $2A       ; transplant's parent
ZLO     = $08       ; what __ts_save keeps
ZLEN    = $24

N_PAR   = 4
N_COL   = 6
N_KEY   = 7
F_ES    = 4
F_CMP   = 6
F_KS    = 8

.segment "bss"
__ts_stash: .res ZLEN

; ---- the node helpers --------------------------------------------------

.macro mov dst, src
    lda src
    sta dst
    lda src+1
    sta dst+1
.endmacro

.macro clr dst
    lda #0
    sta dst
    sta dst+1
.endmacro

; Z set when v is NULL
.macro isnull v
    lda v
    ora v+1
.endmacro

; Z set when a == b
.macro eq a, b
    lda a
    cmp b
    bne @ne\@
    lda a+1
    cmp b+1
@ne\@:
.endmacro

; dst = node's field at off
.macro get dst, node, off
    ldy #off
    lda (node),y
    sta dst
    iny
    lda (node),y
    sta dst+1
.endmacro

; node's field at off = src
.macro put node, off, src
    ldy #off
    lda src
    sta (node),y
    iny
    lda src+1
    sta (node),y
.endmacro

; v = v's field at off
.macro follow v, off
    ldy #off+1
    lda (v),y
    tax
    dey
    lda (v),y
    sta v
    stx v+1
.endmacro

; dst = node.link[d] / node.link[d ^ 2]
.macro getd dst, node
    ldy D
    lda (node),y
    sta dst
    iny
    lda (node),y
    sta dst+1
.endmacro

.macro geto dst, node
    lda D
    eor #2
    tay
    lda (node),y
    sta dst
    iny
    lda (node),y
    sta dst+1
.endmacro

; node.link[d] / node.link[d ^ 2] = src
.macro putd node, src
    ldy D
    lda src
    sta (node),y
    iny
    lda src+1
    sta (node),y
.endmacro

.macro puto node, src
    lda D
    eor #2
    tay
    lda src
    sta (node),y
    iny
    lda src+1
    sta (node),y
.endmacro

; D = child's side of parent (0: link[0])
.macro side parent, child
    ldx #0
    ldy #0
    lda (parent),y
    cmp child
    bne @o\@
    iny
    lda (parent),y
    cmp child+1
    beq @s\@
@o\@:
    ldx #2
@s\@:
    stx D
.endmacro

; the base page the methods change
.macro clobbers
    .zp_clobbers $08, $09, $0A, $0B, $0C, $0D, $0E, $0F, $10, $11, $12, $13, $14, $15, $16, $17
    .zp_clobbers $18, $19, $1A, $1B, $1C, $1D, $1E, $1F, $20, $21, $22, $23, $24, $25, $26, $27
    .zp_clobbers $28, $29, $2A, $2B
    .reg_clobbers A, X, Y, Z
    .flag_clobbers C, N, Z, V
.endmacro

.segment "code"

; the zero-page state into BSS / back (around cmp, malloc, free)
proc __ts_save
    ldx #ZLEN-1
@l:
    lda ZLO,x
    sta __ts_stash,x
    dex
    bpl @l
    rts
endproc

proc __ts_restore
    ldx #ZLEN-1
@l:
    lda __ts_stash,x
    sta ZLO,x
    dex
    bpl @l
    rts
endproc

; C set when the node at zero page X is red (NULL is black); TP = it
proc __ts_isred
    lda $00,x
    sta TP
    lda $01,x
    sta TP+1
    ora TP
    clc
    beq @r
    ldy #N_COL
    lda (TP),y
    lsr a
@r:
    rts
endproc

; the node at zero page X painted A (0 black, 1 red); NULL: nothing
proc __ts_paint
    pha
    lda $00,x
    sta TP
    lda $01,x
    sta TP+1
    ora TP
    beq @null
    pla
    ldy #N_COL
    sta (TP),y
    rts
@null:
    pla
    rts
endproc

; A/X = N's element (N + 7)
proc __ts_elem
    clc
    lda N
    adc #N_KEY
    ldx N+1
    bcc @r
    inx
@r:
    rts
endproc

; N = the lowest node under N
proc __ts_min
@l:
    ldy #0
    lda (N),y
    iny
    ora (N),y
    beq @r
    follow N, 0
    bra @l
@r:
    rts
endproc

; the key against node N's element: A = $FF before it, 0 equal, 1 after
; (global, with its record: ln45 bridges its call of __ct_cmp in c45_stack.lib)
proc __ts_compare
    .reg_clobbers A, X, Y, Z
    .flag_clobbers C, N, Z, V
    clc                 ; CT_Q = the node's element
    lda N
    adc #N_KEY
    sta CT_Q
    lda N+1
    adc #0
    sta CT_Q+1
    ldy #F_CMP
    lda (T),y
    iny
    ora (T),y
    bne @fn
    mov CT_P, K         ; no cmp: the key's bytes
    ldy #F_KS
    lda (T),y
    sta CT_ES
    iny
    lda (T),y
    sta CT_ES+1
    jsr __ct_bytecmp
    beq @eq
    bcc @lt
@gt:
    lda #1
    rts
@fn:
    ldy #F_CMP
    lda (T),y
    sta ___ct_cmpf
    iny
    lda (T),y
    sta ___ct_cmpf+1
    jsr __ts_save
    mov $10, K          ; cmp(key, element)
    mov $12, CT_Q
    jsr ___ct_cmp
    pha
    phx
    jsr __ts_restore
    plx
    pla
    cpx #$80            ; (negative: before)
    bcs @lt
    cpx #0
    bne @gt
    cmp #0
    bne @gt
@eq:
    lda #0
    rts
@lt:
    lda #$FF
    rts
    .func_flags zp_call
endproc

; the walk from the root: N the node equal to the key (A = 0), or NULL
; with P the last node and D the side the key goes to (A != 0); R the
; lowest node after the key (the lower bound when not equal)
proc __ts_search
    get N, T, 0
    clr P
    clr R
    sta D
@loop:
    isnull N
    beq @none
    jsr __ts_compare
    tax
    beq @found
    mov P, N
    ldy #2              ; after this node: link[1]
    cpx #$FF
    bne @go
    mov R, N            ; before it: link[0], and it is after the key
    ldy #0
@go:
    sty D
    iny
    lda (N),y
    tax
    dey
    lda (N),y
    sta N
    stx N+1
    bra @loop
@found:
    mov R, N
    lda #0
    rts
@none:
    lda #1
    rts
endproc

; TU replaced by TV (may be NULL) in its parent or as the root; TV.parent = TU.parent
proc __ts_transplant
    get TG, TU, N_PAR
    isnull TG
    bne @child
    put T, 0, TV
    bra @parent
@child:
    ldy #0              ; TU's side of TG
    lda (TG),y
    cmp TU
    bne @upper
    iny
    lda (TG),y
    cmp TU+1
    bne @upper
    ldy #0
    bra @link
@upper:
    ldy #2
@link:
    lda TV
    sta (TG),y
    iny
    lda TV+1
    sta (TG),y
@parent:
    isnull TV
    beq @done
    put TV, N_PAR, TG
@done:
    rts
endproc

; rotate(TU, D): TV = TU.link[d^2] up into TU's place, TU down towards d
; (d 0: a left rotation)
proc __ts_rotate
    geto TV, TU         ; y = x.link[d^2]
    getd TW, TV         ; w = y.link[d]
    puto TU, TW         ; x.link[d^2] = w
    isnull TW
    beq @1
    put TW, N_PAR, TU   ; w.parent = x
@1:
    jsr __ts_transplant ; y in x's place
    putd TV, TU         ; y.link[d] = x
    put TU, N_PAR, TV   ; x.parent = y
    rts
endproc

; the value (esize - ksize bytes from VAL) into node N's element after its
; key: nothing in a set
proc __ts_value
    sec
    ldy #F_ES
    lda (T),y
    ldy #F_KS
    sbc (T),y
    sta CT_ES
    ldy #F_ES+1
    lda (T),y
    ldy #F_KS+1
    sbc (T),y
    sta CT_ES+1
    ora CT_ES
    beq @none
    jsr __ts_elem       ; CT_P = N + 7 + ksize
    ldy #F_KS
    clc
    adc (T),y
    sta CT_P
    iny
    txa
    adc (T),y
    sta CT_P+1
    mov CT_Q, VAL
    jmp __ct_copy
@none:
    rts
endproc

; void tset::init(size_t esize, int (*cmp)(...))
proc _tset__init
    .zp_uses $10, $11, $12, $13, $14, $15
    .reg_clobbers A, Y
    .flag_clobbers N, Z
    lda #0
    ldy #3
@z:
    sta ($10),y
    dey
    bpl @z
    ldy #4
    lda $12
    sta ($10),y
    iny
    lda $13
    sta ($10),y
    iny
    lda $14
    sta ($10),y
    iny
    lda $15
    sta ($10),y
    iny
    lda $12             ; ksize = esize
    sta ($10),y
    iny
    lda $13
    sta ($10),y
    rts
    .func_flags zp_call
endproc

; int tset::insert(const void *key)
proc _tset__insert
    .zp_uses $10, $11, $12, $13, $14, $15
    clobbers
    jsr __ts_search
    cmp #0
    bne @new
    jsr __ts_value      ; there already (a map's value replaced)
    lda #0
    tax
    rts
@new:
    jsr __ts_save       ; z = malloc(7 + esize)
    ldy #F_ES+1
    lda (T),y
    tax
    dey
    lda (T),y
    clc
    adc #N_KEY
    bcc @1
    inx
@1:
    sta $10
    stx $11
    jsr _malloc
    pha
    phx
    jsr __ts_restore
    plx
    pla
    sta ZN
    stx ZN+1
    ora ZN+1
    bne @got
    lda #$FF            ; no memory
    tax
    rts
@got:
    lda #0              ; links NULL, parent P, red, the key, the value
    ldy #3
@zero:
    sta (ZN),y
    dey
    bpl @zero
    put ZN, N_PAR, P
    iny
    lda #1
    sta (ZN),y
    mov N, ZN
    jsr __ts_elem
    sta CT_P
    stx CT_P+1
    mov CT_Q, K
    ldy #F_KS
    lda (T),y
    sta CT_ES
    iny
    lda (T),y
    sta CT_ES+1
    jsr __ct_copy
    jsr __ts_value
    isnull P            ; under P on side D, or the root
    bne @under
    put T, 0, ZN
    bra @linked
@under:
    putd P, ZN
@linked:
    ldy #2              ; len + 1
    lda (T),y
    clc
    adc #1
    sta (T),y
    iny
    lda (T),y
    adc #0
    sta (T),y
@fix:                   ; while z's parent is red
    get P, ZN, N_PAR
    ldx #P
    jsr __ts_isred
    bcs @red
    jmp @done
@red:
    get XN, P, N_PAR    ; g (a red node is not the root: it exists)
    side XN, P          ; D: p's side of g
    geto W, XN          ; the uncle
    ldx #W
    jsr __ts_isred
    bcc @black
    lda #0              ; red uncle: p, u black, g red, up two
    ldx #P
    jsr __ts_paint
    lda #0
    ldx #W
    jsr __ts_paint
    lda #1
    ldx #XN
    jsr __ts_paint
    mov ZN, XN
    jmp @fix
@black:
    geto YN, P          ; z on the inner side: rotate it out
    eq YN, ZN
    bne @outer
    mov ZN, P
    mov TU, P
    jsr __ts_rotate     ; rotate(z, d)
    get P, ZN, N_PAR
@outer:
    lda #0
    ldx #P
    jsr __ts_paint
    get XN, P, N_PAR
    lda #1
    ldx #XN
    jsr __ts_paint
    mov TU, XN          ; rotate(g, d ^ 2)
    lda D
    eor #2
    sta D
    jsr __ts_rotate
@done:
    get N, T, 0         ; the root black
    lda #0
    ldx #N
    jsr __ts_paint
    lda #1
    ldx #0
    rts
    .func_flags zp_call
endproc

; int tset::erase(const void *key)
proc _tset__erase
    .zp_uses $10, $11, $12, $13
    clobbers
    jsr __ts_search
    cmp #0
    beq @found
    lda #0
    tax
    rts
@found:
    mov ZN, N
    ldy #N_COL          ; the colour taken out: z's
    lda (ZN),y
    sta CL
    get XN, ZN, 2
    ldy #0
    lda (ZN),y
    iny
    ora (ZN),y
    beq @one            ; no lower child: the upper in its place
    isnull XN
    bne @two
    get XN, ZN, 0       ; no upper child: the lower in its place
@one:
    get XP, ZN, N_PAR
    mov TU, ZN
    mov TV, XN
    jsr __ts_transplant
    jmp @removed
@two:                   ; two: its successor y in its place
    mov N, XN
    jsr __ts_min
    mov YN, N
    ldy #N_COL          ; the colour taken out: y's
    lda (YN),y
    sta CL
    get XN, YN, 2
    get XP, YN, N_PAR
    eq XP, ZN
    bne @deeper
    mov XP, YN          ; y is z's child: x stays under y
    bra @place
@deeper:
    mov TU, YN          ; y out of its place, x in it
    mov TV, XN
    jsr __ts_transplant
    get W, ZN, 2        ; y.link[1] = z.link[1], its parent y
    put YN, 2, W
    put W, N_PAR, YN
@place:
    mov TU, ZN          ; y in z's place
    mov TV, YN
    jsr __ts_transplant
    get W, ZN, 0        ; y.link[0] = z.link[0], its parent y
    put YN, 0, W
    put W, N_PAR, YN
    ldy #N_COL          ; y takes z's colour
    lda (ZN),y
    sta (YN),y
@removed:
    jsr __ts_save       ; free(z)
    mov $10, ZN
    jsr _free
    jsr __ts_restore
    ldy #2              ; len - 1
    lda (T),y
    sec
    sbc #1
    sta (T),y
    iny
    lda (T),y
    sbc #0
    sta (T),y
    lda CL
    beq @loop           ; a black node out: the fixup
    jmp @ok
@loop:                  ; while x is not the root and black
    ldy #0
    lda (T),y
    cmp XN
    bne @notroot
    iny
    lda (T),y
    cmp XN+1
    bne @notroot
    jmp @end
@notroot:
    ldx #XN
    jsr __ts_isred
    bcc @xblack
    jmp @end
@xblack:
    side XP, XN         ; D: x's side of xp
    geto W, XP          ; w: the sibling
    ldx #W
    jsr __ts_isred
    bcc @wblack
    lda #0              ; red sibling: w black, xp red, rotate(xp, d)
    ldx #W
    jsr __ts_paint
    lda #1
    ldx #XP
    jsr __ts_paint
    mov TU, XP
    jsr __ts_rotate
    geto W, XP
@wblack:
    getd N, W           ; N: the near nephew, P: the far one
    geto P, W
    ldx #N
    jsr __ts_isred
    bcs @nephew
    ldx #P
    jsr __ts_isred
    bcs @nephew
    lda #1              ; both black: w red, up one
    ldx #W
    jsr __ts_paint
    mov XN, XP
    get XP, XN, N_PAR
    jmp @loop
@nephew:
    ldx #P              ; the far one black: rotate(w, d ^ 2)
    jsr __ts_isred
    bcs @far
    lda #0
    ldx #N
    jsr __ts_paint
    lda #1
    ldx #W
    jsr __ts_paint
    mov TU, W
    lda D
    eor #2
    sta D
    jsr __ts_rotate
    lda D
    eor #2
    sta D
    geto W, XP
@far:
    ldy #N_COL          ; w takes xp's colour; xp, the far nephew black
    lda (XP),y
    sta (W),y
    lda #0
    ldx #XP
    jsr __ts_paint
    geto P, W
    lda #0
    ldx #P
    jsr __ts_paint
    mov TU, XP          ; rotate(xp, d); done
    jsr __ts_rotate
    get XN, T, 0
@end:
    lda #0
    ldx #XN
    jsr __ts_paint
@ok:
    lda #1
    ldx #0
    rts
    .func_flags zp_call
endproc

; void *tset::find(const void *key)
proc _tset__find
    .zp_uses $10, $11, $12, $13
    clobbers
    jsr __ts_search
    cmp #0
    bne @none
    jmp __ts_elem
@none:
    lda #0
    tax
    rts
    .func_flags zp_call
endproc

; void *tset::lower_bound(const void *key)
proc _tset__lower_bound
    .zp_uses $10, $11, $12, $13
    clobbers
    jsr __ts_search
    isnull R
    beq @none
    mov N, R
    jmp __ts_elem
@none:
    lda #0
    tax
    rts
    .func_flags zp_call
endproc

; void *tset::first()
proc _tset__first
    .zp_uses $10, $11
    clobbers
    get N, T, 0
    isnull N
    beq @none
    jsr __ts_min
    jmp __ts_elem
@none:
    lda #0
    tax
    rts
    .func_flags zp_call
endproc

; void *tset::next(void *e): the element after e, or NULL
proc _tset__next
    .zp_uses $10, $11, $12, $13
    clobbers
    sec                 ; N: e's node
    lda K
    sbc #N_KEY
    sta N
    lda K+1
    sbc #0
    sta N+1
    ldy #2              ; an upper subtree: its lowest
    lda (N),y
    iny
    ora (N),y
    beq @up
    follow N, 2
    jsr __ts_min
    jmp __ts_elem
@up:                    ; else up while N is its parent's link[1]
    get P, N, N_PAR
    isnull P
    beq @none
    ldy #2
    lda (P),y
    cmp N
    bne @found
    iny
    lda (P),y
    cmp N+1
    bne @found
    mov N, P
    bra @up
@found:
    mov N, P
    jmp __ts_elem
@none:
    lda #0
    tax
    rts
    .func_flags zp_call
endproc

; size_t tset::size()
proc _tset__size
    .zp_uses $10, $11
    .reg_clobbers A, X, Y
    .flag_clobbers N, Z
    ldy #3
    lda ($10),y
    tax
    dey
    lda ($10),y
    rts
    .func_flags zp_call
endproc

; void tset::clear(): every node freed (leaves first, by the parent links)
proc _tset__clear
    .zp_uses $10, $11
    clobbers
    get N, T, 0
@loop:
    isnull N
    beq @empty
    ldy #0              ; down while there is a child
    lda (N),y
    iny
    ora (N),y
    beq @upper
    follow N, 0
    bra @loop
@upper:
    ldy #2
    lda (N),y
    iny
    ora (N),y
    beq @leaf
    follow N, 2
    bra @loop
@leaf:                  ; a leaf: out of its parent, freed
    get P, N, N_PAR
    isnull P
    beq @free
    side P, N
    ldy D
    lda #0
    sta (P),y
    iny
    sta (P),y
@free:
    jsr __ts_save
    mov $10, N
    jsr _free
    jsr __ts_restore
    mov N, P
    bra @loop
@empty:
    lda #0              ; root NULL, len 0
    ldy #3
@z:
    sta (T),y
    dey
    bpl @z
    rts
    .func_flags zp_call
endproc

; void tset::free(): as clear
proc _tset__free
    .zp_uses $10, $11
    clobbers
    jmp _tset__clear
    .func_flags zp_call
endproc

; ---- struct tmap: the tset's methods -----------------------------------

; void tmap::init(size_t ksize, size_t vsize, int (*cmp)(...))   $12, $14, $16
proc _tmap__init
    .zp_uses $10, $11, $12, $13, $14, $15, $16, $17
    .reg_clobbers A, Y
    .flag_clobbers C, N, Z
    ldy #8              ; ksize
    lda $12
    sta ($10),y
    iny
    lda $13
    sta ($10),y
    ldy #6              ; cmp
    lda $16
    sta ($10),y
    iny
    lda $17
    sta ($10),y
    ldy #4              ; esize = ksize + vsize
    clc
    lda $12
    adc $14
    sta ($10),y
    iny
    lda $13
    adc $15
    sta ($10),y
    lda #0              ; empty
    ldy #3
@z:
    sta ($10),y
    dey
    bpl @z
    rts
    .func_flags zp_call
endproc

; void *tmap::get(const void *key): the value, or NULL
proc _tmap__get
    .zp_uses $10, $11, $12, $13
    clobbers
    jsr _tset__find
    cmp #0
    bne @in
    cpx #0
    beq @none
@in:
    ldy #F_KS
    clc
    adc (T),y
    pha
    txa
    iny
    adc (T),y
    tax
    pla
@none:
    rts
    .func_flags zp_call
endproc

proc _tmap__put
    .zp_uses $10, $11, $12, $13, $14, $15
    clobbers
    jmp _tset__insert
    .func_flags zp_call
endproc

proc _tmap__erase
    .zp_uses $10, $11, $12, $13
    clobbers
    jmp _tset__erase
    .func_flags zp_call
endproc

proc _tmap__find
    .zp_uses $10, $11, $12, $13
    clobbers
    jmp _tset__find
    .func_flags zp_call
endproc

proc _tmap__lower_bound
    .zp_uses $10, $11, $12, $13
    clobbers
    jmp _tset__lower_bound
    .func_flags zp_call
endproc

proc _tmap__first
    .zp_uses $10, $11
    clobbers
    jmp _tset__first
    .func_flags zp_call
endproc

proc _tmap__next
    .zp_uses $10, $11, $12, $13
    clobbers
    jmp _tset__next
    .func_flags zp_call
endproc

proc _tmap__size
    .zp_uses $10, $11
    .reg_clobbers A, X, Y
    .flag_clobbers N, Z
    jmp _tset__size
    .func_flags zp_call
endproc

proc _tmap__clear
    .zp_uses $10, $11
    clobbers
    jmp _tset__clear
    .func_flags zp_call
endproc

proc _tmap__free
    .zp_uses $10, $11
    clobbers
    jmp _tset__clear
    .func_flags zp_call
endproc
