; __heap_bounds.s — default heap bounds for malloc
;
; 0 means automatic: the heap starts at the end of the program (__bss_end)
; and ends 4KB below the 16-bit CPU stack's top (or at $C000 with the 8-bit
; page-1 stack). Linked only when no object defines the symbols, so a
; program can place the heap with its own __heap_start/__heap_end.

.global __heap_start
.global __heap_end

__heap_start = 0
__heap_end = 0
