; puts.s — Write a NUL-terminated string to screen (ZP calling convention)
;
; int puts(char *s);
;   Writes string s to the screen via KERNAL CHROUT, then a newline.
;   Returns 0 on success.
; int putstr(const char *s);  (also __builtin_putstr)
;   The same without the newline. cc45 turns printf("text") (no % and the
;   result unused) into putstr("text"), and printf("text\n") into
;   puts("text"), so such a program does not link the printf formatter.
;
; Uses ZP $FB/$FC for the string pointer — kernal-safe locations.

.global _puts
.global _putstr
.extern __bp_rom
.extern __bp_prog

.segment "code"

proc _putstr
    .zp_uses $10, $11
    .zp_clobbers $10, $11
    .zp_release $10, $11
    .reg_clobbers A, X, Y, Z
    .flag_clobbers C, N, Z, V

    ; Save $FB/$FC and copy string pointer there
    lda $FB
    pha
    lda $FC
    pha
    lda $10
    sta $FB
    lda $11
    sta $FC
    ldy #0
@loop:
    lda ($FB),y
    beq @done
    phz
    phy
    jsr __bp_rom
    jsr $FFD2
    jsr __bp_prog
    ply
    plz
    iny
    bne @loop
    inc $FC             ; next page of the string
    bra @loop
@done:
    ; Restore $FB/$FC
    pla
    sta $FC
    pla
    sta $FB
    lda #0
    tax
    rts
    .func_flags zp_call
    endproc

proc _puts
    .zp_uses $10, $11
    .zp_clobbers $10, $11
    .zp_release $10, $11
    .reg_clobbers A, X, Y, Z
    .flag_clobbers C, N, Z, V

    jsr _putstr
    lda #$0D
    phz
    jsr __bp_rom
    jsr $FFD2
    jsr __bp_prog
    plz
    lda #0
    tax
    rts
    .func_flags zp_call
    endproc
