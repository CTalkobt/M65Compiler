; cbm_args.s45 — the register bytes of cc45's __jsr / __jsr_raw / __jmp
; (and so of the <cbm.h> KERNAL wrappers) and ___cbm_target, the routine
; __rom_call calls
;
; C stores a register's value here (an assignment works in every calling
; convention) and the call's inline assembly loads the register from it;
; the registers asked for are saved here after the call.

; no calls through pointers here (ln45's call graph)
.weak cc45.icallinfo
cc45.icallinfo = 1

.global ___cbm_target

.segment "bss"
___cbm_target: .res 2   ; the KERNAL routine crt0's __rom_call calls

.global ___jsr_a, ___jsr_x, ___jsr_y, ___jsr_z, ___jsr_c, ___jsr_p
.global ___jsr_ax, ___jsr_ay, ___jsr_az, ___jsr_xy, ___jsr_q
___jsr_a:  .res 1
___jsr_x:  .res 1
___jsr_y:  .res 1
___jsr_z:  .res 1
___jsr_c:  .res 1       ; .Carry = value (not 0: set)
___jsr_p:  .res 1       ; the flags after the call (php)
___jsr_ax: .res 2
___jsr_ay: .res 2
___jsr_az: .res 2
___jsr_xy: .res 2
___jsr_q:  .res 4

; __interrupt handlers (cc45) call these at their start and end (crt0 has
; empty defaults): a handler that uses __jsr or <cbm.h> does not change the
; bytes of a __jsr the interrupted code is in the middle of. One level: a
; handler interrupted by another shares the save area.
.global __jsr_isr_save, __jsr_isr_restore
.segment "code"
__jsr_isr_save:
    ldx #19
__jis_loop:
    lda ___cbm_target,x     ; (___cbm_target and the ___jsr_ bytes: 20 in a row)
    sta __jsr_isr_area,x
    dex
    bpl __jis_loop
    rts
__jsr_isr_restore:
    ldx #19
__jir_loop:
    lda __jsr_isr_area,x
    sta ___cbm_target,x
    dex
    bpl __jir_loop
    rts
.segment "bss"
__jsr_isr_area: .res 20
