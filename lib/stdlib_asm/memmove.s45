; memmove.s — Copy memory area, overlap-safe (ZP calling convention), by
; DMA (#325)
;
; void *memmove(void *dest, void *src, int n);
;   Copies n bytes from src to dest. Handles overlapping areas: a
;   destination above the source is copied downwards, from the last byte.
;   Returns dest.

; no calls through pointers here (ln45's call graph)
.weak cc45.icallinfo
cc45.icallinfo = 1

.global _memmove
.extern __dma_mem

.segment "code"

proc _memmove
    .zp_uses $10, $11, $12, $13, $14, $15
    .zp_clobbers $10, $11, $12, $13, $14, $15
    .zp_release $12, $13, $14, $15
    .reg_clobbers A, X, Y, Z
    .flag_clobbers C, N, Z, V

    ; dest=$10/$11, src=$12/$13, n=$14/$15
    lda $14
    ora $15
    beq @none               ; (a DMA length of 0 is 64 KB)
    lda $12                 ; upwards when src >= dest
    cmp $10
    lda $13
    sbc $11
    lda #0                  ; copy, upwards
    bcs @go
    lda #$30                ; copy, downwards
@go:
    jmp __dma_mem
@none:
    lda $10
    ldx $11
    rts
    .func_flags zp_call
    endproc
