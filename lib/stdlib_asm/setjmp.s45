; setjmp.s — Non-local jumps (ZP calling convention)
;
; int setjmp(jmp_buf env);
;   env pointer in $10/$11.
;   Saves return address and stack pointer into env[0..3].
;   Returns 0.
;
; void longjmp(jmp_buf env, int val);
;   env pointer in $10/$11, val in $12/$13.
;   Restores SP and jumps to saved return address.
;   setjmp appears to return val (or 1 if val==0).
;
; jmp_buf layout: [0] PCL, [1] PCH, [2] SPL, [3] SPH, [4-5] frame pointer,
; [6] the code overlays' return stack depth, [7] the overlay in the region
; (__ovl_jsave/__ovl_jrestore: ovl.s45 in a program with overlays, else
; crt0's empty ones)

; no calls through pointers here (ln45's call graph)
.weak cc45.icallinfo
cc45.icallinfo = 1

.global _setjmp
.global _longjmp
.extern __ovl_jsave, __ovl_jrestore

.segment "code"

; --- setjmp ---

proc _setjmp
    .zp_uses $10, $11
    .zp_clobbers $08, $09, $10, $11
    .zp_release $10, $11
    .reg_clobbers A, X, Y
    .flag_clobbers C, N, Z

    ; Return address and SP, read through a pointer so the stack may live
    ; on any page (16-bit SP)
    tsx
    tsy
    stx $08
    sty $09
    ldy #1
    lda ($08), y            ; PCL
    tax
    iny
    lda ($08), y            ; PCH
    ldy #1
    sta ($10), y
    dey
    txa
    sta ($10), y
    ldy #2
    lda $08
    sta ($10), y            ; SPL
    iny
    lda $09
    sta ($10), y            ; SPH
    lda $FD                 ; frame pointer
    iny
    sta ($10), y
    lda $FE
    iny
    sta ($10), y
    jsr __ovl_jsave         ; env[6], env[7]

    ; Return 0
    lda #0
    tax
    rts
    .func_flags zp_call
    endproc

; --- longjmp ---

proc _longjmp
    .zp_uses $10, $11, $12, $13
    .zp_clobbers $10, $11, $12, $13
    .zp_release $10, $11, $12, $13
    .reg_clobbers A, X, Y, Z
    .flag_clobbers C, N, Z, V

    ; Check val == 0, force to 1
    lda $12
    ora $13
    bne @nonzero
    lda #1
    sta $12
    lda #0
    sta $13
@nonzero:

    ; SP = saved SP + 2 (as after setjmp's return; the return address is
    ; pushed back below and popped by rts). The stack unwinds upward, so
    ; SPL is written first: an interrupt in between pushes below the target.
    ldy #2
    lda ($10), y
    clc
    adc #2
    tax
    iny
    lda ($10), y
    adc #0
    tay
    txs
    tys
    ldy #4                  ; frame pointer
    lda ($10), y
    sta $FD
    iny
    lda ($10), y
    sta $FE
    jsr __ovl_jrestore      ; the overlay setjmp's caller runs in

    ; Push saved return address onto hardware stack
    ldy #1
    lda ($10), y            ; PCH
    pha
    dey
    lda ($10), y            ; PCL
    pha

    ; Return val in AX
    lda $12
    ldx $13

    rts
    .func_flags zp_call
    endproc
