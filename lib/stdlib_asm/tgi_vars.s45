; tgi_vars.s45 — <tgi.h>'s kernel variables (tgi/tgi-kernel.h) in a fixed
; order, so tgi_setup.s45's tgi_install copies a driver's numbers in one
; loop (the order of tgi_driver_t's from xres, stdlib/tgi_drv.h) and clears
; a new driver's state in one (___tgi_state .. ___tgi_state_end:
; ___tgi_state_size bytes)

.global _tgi_drv, _tgi_xmax, _tgi_ymax
.global _tgi_xres, _tgi_yres, _tgi_colorcount, _tgi_pagecount, _tgi_fontwidth
.global _tgi_fontheight, _tgi_aspectratio, _tgi_flags, ___tgi_mode
.global ___tgi_state, _tgi_error, _tgi_gmode, _tgi_curx, _tgi_cury, _tgi_color
.global _tgi_font, _tgi_textdir, ___tgi_vfont, _tgi_textscalew, _tgi_textscaleh
.global _tgi_charwidth, _tgi_charheight, ___tgi_state_end, ___tgi_state_size

.segment "bss"
_tgi_drv:           .res 2  ; the installed driver
_tgi_xmax:          .res 2  ; tgi_xres - 1
_tgi_ymax:          .res 2  ; tgi_yres - 1
; the driver's numbers (tgi_driver_t's, in its order)
_tgi_xres:          .res 2
_tgi_yres:          .res 2
_tgi_colorcount:    .res 1  ; 0: 256
_tgi_pagecount:     .res 1
_tgi_fontwidth:     .res 1
_tgi_fontheight:    .res 1
_tgi_aspectratio:   .res 2  ; 8.8
_tgi_flags:         .res 1
___tgi_mode:        .res 1  ; $80: 640x200, nibble colour (tgi_ncm.s45)
; a new driver's state: all 0 (TGI_ERR_OK, TGI_FONT_BITMAP,
; TGI_TEXT_HORIZONTAL, no vector font)
___tgi_state:
_tgi_error:         .res 1
_tgi_gmode:         .res 1
_tgi_curx:          .res 2
_tgi_cury:          .res 2
_tgi_color:         .res 1
_tgi_font:          .res 1
_tgi_textdir:       .res 1
___tgi_vfont:       .res 2  ; the installed vector font
_tgi_textscalew:    .res 4  ; vector, bitmap font scale (8.8)
_tgi_textscaleh:    .res 4
_tgi_charwidth:     .res 2  ; the scaled bitmap character (8.8)
_tgi_charheight:    .res 2
___tgi_state_end:
___tgi_state_size = ___tgi_state_end - ___tgi_state   ; (tgi_setup.s45's tgi_install)
