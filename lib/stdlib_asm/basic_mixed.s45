; basic_mixed.s45 — basic45's compiled procs in an interpreted program
; (#577): the interpreted CALL writes the variables' POINTERs into
; ___bas_pp (basic45's thunk file: in the data segment, written before the
; first call fills BSS) and SYSes the compiled program, which reads its
; parameters and writes its result through them.
;
;   __bas_vget    __bas_n: a POINTER; __bas_m: 0 a float, 1 an integer
;                 -> __float_a (5 bytes) / __bas_n (the integer, low first)
;   __bas_vputf   __bas_n: a POINTER; __float_a written there (5 bytes)
;   __bas_vputi   __bas_n: a POINTER; __bas_m written there (2 bytes)
;   __bas_vgets   __bas_n: a string's POINTER (its descriptor: length,
;                 address low, high); its characters into __bas_sr's buffer
;                 (a length byte, then the characters; #680)
;   __bas_vputs   __bas_n: the POINTER of basic45's ZBUF$ (its characters
;                 written in place: the length kept, BASIC's string space
;                 untouched); __bas_sa: the string (a length byte, then the
;                 characters), as many as fit; __bas_plen: how many (the
;                 thunk gives it to the CALL, which takes LEFT$(ZBUF$, n))
;   __bas_xbase   an array parameter (#683): __bas_n: POINTER(x(0)), __bas_m:
;                 its type byte ($22 a float, $25 an integer) -> __bas_xp: the
;                 element 0's 28-bit address, __bas_n: the elements; another
;                 type ?TYPE MISMATCH, more than one dimension ?BAD SUBSCRIPT
;                 (the array's header before it, b65.src: ..., type, length
;                 (2), dimensions (1), elements (2, high first))
;   __bas_xgetf / __bas_xgeti   the element at __bas_xp into __bas_xcell
;   __bas_xputf / __bas_xputi   __bas_xcell into the element at __bas_xp
;                 (integers high byte first there, low first in the cell)
;
; BASIC 65's variables (b65.src: ptrget): a scalar's value in bank 0 at
; $F700-$FEFF, an array's in bank 1 (POINTER's rule: an address from $F700
; up is bank 0's, any other bank 1's); a float as the library's (exponent,
; 4 bytes of mantissa, its top bit the sign), an integer high byte first.

.weak cc45.icallinfo
cc45.icallinfo = 1

.global __bas_vget, __bas_vputf, __bas_vputi, __bas_vgets, __bas_vputs
.global __bas_xbase, __bas_xgetf, __bas_xgeti, __bas_xputf, __bas_xputi, __bas_xp, __bas_xcell
.extern __bas_n, __bas_m, __float_a, __bas_sr, __bas_sa, __bas_plen, __bas_raise

.segment "bss"
__bas_xp:    .res 4
__bas_xcell: .res 5

FP = $08                    ; the variable (a 32-bit pointer)
SP = $0C                    ; the compiled program's string (16 bits)

.segment "code"

; FP := the 28-bit address of POINTER __bas_n
proc __bas_vaddr
    lda __bas_n
    sta FP
    lda __bas_n+1
    sta FP+1
    ldx #1
    cmp #$F7
    bcc @b1
    ldx #0
@b1:
    stx FP+2
    lda #0
    sta FP+3
    rts
endproc

proc __bas_vget
    jsr __bas_vaddr
    ldz #0
    lda __bas_m
    bne @int
    ldx #0
@f: lda [FP],z
    sta __float_a,x
    inz
    inx
    cpx #5
    bne @f
    rts
@int:
    lda [FP],z              ; high
    tax
    inz
    lda [FP],z              ; low
    sta __bas_n
    stx __bas_n+1
    rts
endproc

proc __bas_vputf
    jsr __bas_vaddr
    ldz #0
    ldx #0
@f: lda __float_a,x
    sta [FP],z
    inz
    inx
    cpx #5
    bne @f
    rts
endproc

proc __bas_vputi
    jsr __bas_vaddr
    ldz #0
    lda __bas_m+1           ; high first
    sta [FP],z
    inz
    lda __bas_m
    sta [FP],z
    rts
endproc

; FP := the descriptor's string: its length in X (0: none to read)
proc __bas_vdesc
    jsr __bas_vaddr
    ldz #0
    lda [FP],z              ; length
    sta __bas_m
    inz
    lda [FP],z              ; address low
    pha
    inz
    lda [FP],z              ; high
    sta __bas_n+1
    pla
    sta __bas_n
    jsr __bas_vaddr
    ldx __bas_m
    rts
endproc

proc __bas_vgets
    jsr __bas_vdesc
    lda __bas_sr
    sta SP
    lda __bas_sr+1
    sta SP+1
    ldy #0
    txa                     ; (its flags for the BEQ: after LDY)
    sta (SP),y
    beq @done
    ldz #0
@c: lda [FP],z
    iny
    sta (SP),y
    inz
    dex
    bne @c
@done:
    rts
endproc

proc __bas_vputs
    jsr __bas_vdesc         ; X: ZBUF$'s length
    lda __bas_sa
    sta SP
    lda __bas_sa+1
    sta SP+1
    ldy #0
    txa
    cmp (SP),y              ; the fewer of the two
    bcc @n
    lda (SP),y
@n: sta __bas_plen
    tax
    beq @done
    ldz #0
@c: iny
    lda (SP),y
    sta [FP],z
    inz
    dex
    bne @c
@done:
    rts
endproc

proc __bas_xbase
    jsr __bas_vaddr
    ldx #3
@cp:
    lda FP,x
    sta __bas_xp,x
    dex
    bpl @cp
    ; FP := the header's type byte, 6 before the element
    sec
    lda FP
    sbc #6
    sta FP
    lda FP+1
    sbc #0
    sta FP+1
    lda FP+2
    sbc #0
    sta FP+2
    ldz #0
    lda [FP],z              ; the type
    cmp __bas_m
    beq @typed
    lda #22                 ; ?TYPE MISMATCH
    jmp __bas_raise
@typed:
    ldz #3
    lda [FP],z              ; the dimensions
    cmp #1
    beq @one
    lda #18                 ; ?BAD SUBSCRIPT
    jmp __bas_raise
@one:
    inz
    lda [FP],z              ; the elements, high first
    sta __bas_n+1
    inz
    lda [FP],z
    sta __bas_n
    rts
endproc

; FP := __bas_xp
proc __bas_xaddr
    ldx #3
@cp:
    lda __bas_xp,x
    sta FP,x
    dex
    bpl @cp
    ldz #0
    rts
endproc

proc __bas_xgetf
    jsr __bas_xaddr
    ldx #0
@f: lda [FP],z
    sta __bas_xcell,x
    inz
    inx
    cpx #5
    bne @f
    rts
endproc

proc __bas_xgeti
    jsr __bas_xaddr
    lda [FP],z              ; high
    sta __bas_xcell+1
    inz
    lda [FP],z
    sta __bas_xcell
    rts
endproc

proc __bas_xputf
    jsr __bas_xaddr
    ldx #0
@f: lda __bas_xcell,x
    sta [FP],z
    inz
    inx
    cpx #5
    bne @f
    rts
endproc

proc __bas_xputi
    jsr __bas_xaddr
    lda __bas_xcell+1       ; high first
    sta [FP],z
    inz
    lda __bas_xcell
    sta [FP],z
    rts
endproc
