; ovl.s45 — code overlays (ln45; cc45 #pragma cc45 overlay(name) / -foverlay)
;
; An overlay's code is linked to run at one region of bank 0 (__ovl_region,
; below the stack's share) and is kept in far memory; its data and BSS stay
; resident. ln45 links this runtime when a program has overlays.
;
; __ovl_init (called by crt0 before main) loads the overlay files, which ln45
; writes next to the program, into far memory through the KERNAL (SETBNK,
; SETNAM, SETLFS, LOAD) from the device the program was loaded from; the
; KERNAL loads into chip RAM only, so a file kept in attic RAM is loaded into
; a staging bank and copied up by DMA.
;
; A call from outside an overlay goes through a stub ln45 generates, 6
; bytes (#332):
;     jsr __ovl_calli / .byte id / .word f
; __ovl_calli reads the id and the function after its return address and
; goes on as __ovl_call. With ln45 --overlay-fast-stubs, 21 bytes and a few
; cycles less per call:
;     sta __ovl_sa / lda #id / sta __ovl_want
;     lda #<f / sta __ovl_tgt / lda #>f / sta __ovl_tgt+1 / jmp __ovl_call
; __ovl_call moves the caller's return address to the overlay return stack,
; with the overlay to bring back on the return: the one the innermost
; overlay call still running entered (0 at the top level). That is the
; caller's own overlay for a call from the region, and also for a call from
; resident code an overlay called (overlay a -> resident -> overlay b: a is
; needed again when the resident function returns into it). It copies the
; wanted overlay in by DMA when it is not there, and jumps to the function
; with the stack as the caller left it, but for the return address, now
; __ovl_ret's: both calling conventions find their arguments where they
; expect them. __ovl_ret puts that overlay back when another one was copied
; in meanwhile, and returns to the caller. A, X, Y, Z go in and come back unchanged, and the
; flags come back as the function left them.
;
; ln45 provides:
;   __ovl_region   where overlays run, __ovl_region_end the end of the
;                  largest
;   __ovl_table0..5  six tables of a byte per overlay (id 1..n at index
;                  id - 1, up to 255 overlays): copied overlays (ln45's
;                  default) the far address (bits 0-7, 8-15, 16-23, then
;                  20-27) and the length (0-7, 8-15); mapped overlays (ln45
;                  --overlay-map) the lower half of MAP (A, X) that maps the
;                  window to it in 0 and 1
;   __ovl_mapped   1 when the overlays are mapped, 0 when they are copied
;   __ovl_file     the number of files (one per 64 KB bank of the ranges
;                  ln45 --overlay-store gives), the name's length, the
;                  name (PETSCII; each file has its own last character:
;                  PROG.OV1, PROG.OV2), then a record of 8 bytes per file:
;                  the name's last character, the chip RAM bank it is
;                  loaded into, the megabyte of attic RAM ($80-$87, 0 for a
;                  file kept where it is loaded) and the bank it is copied
;                  to, its address (bits 0-15, both; each file starts with
;                  it) and length. Attic RAM's come first: they are loaded
;                  into one staging bank (ln45 --overlay-staging), which
;                  chip RAM's files may use too
;
; Mapped overlays (ln45 --overlay-map) run where they are kept: the window
; (8 KB blocks of $4000-$7FFF, the lower half of the map) is mapped to the
; overlay with MAP; no copying. The upper half stays as the ROM keeps it
; (the KERNAL at $E000 is mapped there), taken at start from the map the
; KERNAL records as current ($011C-$011F), and the overlay's map is written
; there too, so the ROM's own map changes (interrupts, far calls) put the
; overlay back when they restore it. After every ROM call (crt0's
; __bp_prog) __ovl_rom_leave maps it again; __exit (__ovl_exit) restores
; the ROM's map.

; ln45's call graph: calls through pointers only from __ovl_call (cc45.icall.<f>)
.weak cc45.icallinfo
cc45.icallinfo = 1
.weak cc45.icall.__ovl_call
cc45.icall.__ovl_call = 1

.global __ovl_init, __ovl_call, __ovl_calli, __ovl_ret, __ovl_load, __ovl_rom_leave, __ovl_exit
.global __ovl_sa, __ovl_want, __ovl_tgt, __ovl_cur, ___ovl_current
.global __ovl_jsave, __ovl_jrestore, __ovl_dma_fix
.extern __ovl_region, __ovl_region_end, __ovl_file, __ovl_mapped
.extern __ovl_table0, __ovl_table1, __ovl_table2, __ovl_table3, __ovl_table4, __ovl_table5
.extern ___cbm_target, __rom_call, _abort, __dma_job

OVL_DEPTH = 32

.segment "bss"
__ovl_sx:   .res 1          ; X, Y, Z and the flags across the call
__ovl_sy:   .res 1
__ovl_sz:   .res 1
__ovl_sf:   .res 1
__ovl_map:  .res 4          ; mapped overlays: the MAP registers in effect
__ovl_sys:  .res 4          ; the ROM's map at start
__ovl_q:    .res 4          ; (A, X, Y, Z across MAP)
___ovl_current:             ; (C: __ovl_current, <overlay.h>)
__ovl_cur:  .res 1          ; the overlay in the region (0: none)
__ovl_rsp:  .res 1          ; the overlay return stack
__ovl_rlo:  .res OVL_DEPTH
__ovl_rhi:  .res OVL_DEPTH
__ovl_rid:  .res OVL_DEPTH  ; the overlay to bring back on the return
__ovl_rwt:  .res OVL_DEPTH  ; the overlay the call entered
__ovl_rec:  .res 1          ; __ovl_init: the file's record in __ovl_file
__ovl_n:    .res 1          ;             the files still to load
__ovl_ix:   .res 1          ; __ovl_calli: X and Y while it reads the stub
__ovl_iy:   .res 1

.segment "code"
; What the stubs write (in the code segment: ln45 places stubs before it is
; done moving BSS, and the code does not move)
__ovl_sa:   .byte 0         ; A across the call
__ovl_want: .byte 0         ; the overlay the stub calls into
__ovl_tgt:  .word 0         ; the function
; An enhanced (F018B) DMA job: options (source and destination megabyte),
; then the copy
__ovl_job:
    .byte $0B, $80, 0, $81, 0, $00
    .byte 0                 ; copy
    .byte 0, 0              ; length
    .byte 0, 0, 0           ; source: bits 0-15, bank
    .byte 0, 0, 0           ; destination
    .byte 0, 0, 0
__ovl_msg:
    .byte 13, $3F, $4F, $56, $45, $52, $4C, $41, $59, $20, $46, $49, $4C, $45, 13   ; "?OVERLAY FILE"
__ovl_msg_end:

; The 6-byte stub's entry: jsr __ovl_calli / .byte id / .word f. Its return
; address is the stub's last byte: the id and the function follow it. Pulled
; off, it leaves the caller's own return address on top, as the 21-byte
; stub's jmp __ovl_call does. A, X, Y, Z are kept ($08/$09: scratch).
proc __ovl_calli
    sta __ovl_sa
    stx __ovl_ix
    sty __ovl_iy
    pla
    sta $08
    pla
    sta $09
    ldy #1
    lda ($08),y
    sta __ovl_want
    iny
    lda ($08),y
    sta __ovl_tgt
    iny
    lda ($08),y
    sta __ovl_tgt+1
    ldx __ovl_ix
    ldy __ovl_iy
    jmp __ovl_call
endproc

proc __ovl_call
    stx __ovl_sx
    sty __ovl_sy
    stz __ovl_sz
    ldx __ovl_rsp
    cpx #OVL_DEPTH
    bcc @room
    jmp _abort              ; calls through overlays nested too deep
@room:
    pla                     ; the caller's return address
    sta __ovl_rlo,x
    pla
    sta __ovl_rhi,x
    ; the overlay to bring back: the one the innermost call still running
    ; entered (code in the region runs only inside such a call), 0 at the
    ; top level (nothing to copy back)
    lda #0
    cpx #0
    beq @owner
    lda __ovl_rwt-1,x
@owner:
    sta __ovl_rid,x
    lda __ovl_want
    sta __ovl_rwt,x
    inx
    stx __ovl_rsp
    lda __ovl_want
    cmp __ovl_cur
    beq @go
    jsr __ovl_load
@go:
    lda #>(__ovl_ret - 1)   ; the function returns to __ovl_ret
    pha
    lda #<(__ovl_ret - 1)
    pha
    lda __ovl_sa
    ldx __ovl_sx
    ldy __ovl_sy
    ldz __ovl_sz
    jmp (__ovl_tgt)
__ovl_ret:
    php
    sta __ovl_sa
    pla
    sta __ovl_sf
    stx __ovl_sx
    sty __ovl_sy
    stz __ovl_sz
    ldx __ovl_rsp
    dex
    stx __ovl_rsp
    lda __ovl_rid,x         ; the caller's overlay back (0: the caller is
    beq @back               ; resident code: whatever is there stays)
    cmp __ovl_cur
    beq @back
    jsr __ovl_load
@back:
    ldx __ovl_rsp
    lda __ovl_rhi,x
    pha
    lda __ovl_rlo,x
    pha
    lda __ovl_sf
    pha
    lda __ovl_sa
    ldx __ovl_sx
    ldy __ovl_sy
    ldz __ovl_sz
    plp
    rts
endproc

; setjmp/longjmp (setjmp.s45; jmp_buf at $10/$11): setjmp saves the overlay
; return stack's depth and the overlay in the region in env[6], env[7];
; longjmp puts them back -- the calls it leaves are dropped, and the
; overlay setjmp was called from (if any) is brought back before execution
; continues there. A, Y (and in __ovl_jrestore X, Z) are changed, $10-$13 kept.
proc __ovl_jsave
    ldy #6
    lda __ovl_rsp
    sta ($10),y
    iny
    lda __ovl_cur
    sta ($10),y
    rts
endproc

proc __ovl_jrestore
    ldy #6
    lda ($10),y
    sta __ovl_rsp
    iny
    lda ($10),y
    beq @done               ; (none was in yet: the code there is resident)
    cmp __ovl_cur
    beq @done
    jsr __ovl_load
@done:
    rts
endproc

; Overlay A (1..n) into the region by DMA, or mapped into the window
proc __ovl_load
    sta __ovl_cur
    tax                     ; its index in the tables: A - 1
    dex
    lda #<__ovl_mapped
    beq @copy
    lda __ovl_table0,x      ; the lower half of the map: the window
    sta __ovl_map
    lda __ovl_table1,x
    sta __ovl_map+1
    lda __ovl_sys+2         ; the upper half: the ROM's
    sta __ovl_map+2
    lda __ovl_sys+3
    sta __ovl_map+3
    ldq __ovl_map
    stq $011C               ; (the KERNAL's current map)
    map
    eom
    rts
@copy:
    lda __ovl_table0,x      ; source: bits 0-15, bank, megabyte
    sta __ovl_job+9
    lda __ovl_table1,x
    sta __ovl_job+10
    lda __ovl_table2,x
    and #$0F
    sta __ovl_job+11
    lda __ovl_table3,x
    sta __ovl_job+2
    lda __ovl_table4,x      ; length
    sta __ovl_job+7
    lda __ovl_table5,x
    sta __ovl_job+8
    lda #<__ovl_region
    sta __ovl_job+12
    lda #>__ovl_region
    sta __ovl_job+13
    lda #0
    sta __ovl_job+14
    sta __ovl_job+4
    php                     ; (no interrupt between the DMA register writes)
    sei
    sta $D702
    sta $D704
    lda #>__ovl_job
    sta $D701
    lda #<__ovl_job
    sta $D705
    plp
    rts
endproc

; memcpy, memmove, memset (dma_mem.s45): an address of their DMA job
; (__dma_job+X: bits 0-15, bank) the CPU sees in the window of mapped
; overlays is where the overlay in it is kept: + the window's MAP offset.
; A, X, Y and the flags kept.
proc __ovl_dma_fix
    php
    pha
    lda #<__ovl_mapped
    beq @done
    lda __ovl_cur
    beq @done
    lda __dma_job+1,x
    cmp #>__ovl_region
    bcc @done
    cmp #$80
    bcs @done
    clc
    adc __ovl_map           ; (bits 8-15 of the offset)
    sta __dma_job+1,x
    lda __ovl_map+1
    and #$0F                ; (bits 16-19)
    adc __dma_job+2,x
    sta __dma_job+2,x
@done:
    pla
    plp
    rts
endproc

; Mapped overlays: the overlay's map again after a ROM call (crt0's
; __bp_prog), and the ROM's map at exit (crt0's __exit). A, X, Y, Z and the
; flags kept.
proc __ovl_rom_leave
    php
    stq __ovl_q
    lda #<__ovl_mapped
    beq @done
    lda __ovl_cur
    beq @done
    ldq __ovl_map
    stq $011C
    map
    eom
@done:
    ldq __ovl_q
    plp
    rts
endproc

proc __ovl_exit
    php
    stq __ovl_q
    lda #<__ovl_mapped
    beq @done
    lda __ovl_cur
    beq @done
    lda #0
    sta __ovl_cur
    ldq __ovl_sys
    stq $011C
    map
    eom
@done:
    ldq __ovl_q
    plp
    rts
endproc

; Load the overlay files into far memory (attic RAM's through the staging
; bank, then copied up by DMA)
proc __ovl_init
    lda #0
    sta __ovl_cur
    sta __ovl_rsp
    ldq $011C               ; the ROM's map (mapped overlays keep its upper half)
    stq __ovl_sys
    lda __ovl_file
    sta __ovl_n
    lda __ovl_file+1        ; the first record: after the name
    clc
    adc #2
    sta __ovl_rec
@file:
    ; the file's name: its own last character
    ldy __ovl_rec
    ldx __ovl_file+1
    lda __ovl_file,y
    sta __ovl_file+1,x
    ; SETBNK: A = the bank of the data, X = the bank of the file name
    lda #$6B
    sta ___cbm_target
    lda #$FF
    sta ___cbm_target+1
    lda __ovl_file+1,y
    and #$0F
    ldx #0
    jsr __rom_call
    ; SETNAM: A = length, X/Y = the name
    lda #$BD
    sta ___cbm_target
    lda __ovl_file+1
    ldx #<(__ovl_file+2)
    ldy #>(__ovl_file+2)
    jsr __rom_call
    ; SETLFS 0, the program's device (8 when none is known), 1: load to
    ; the address the file starts with
    lda #$BA
    sta ___cbm_target
    ldx $00BA
    cpx #8
    bcs @dev
    ldx #8
@dev:
    lda #0
    ldy #1
    jsr __rom_call
    ; LOAD (to the file's own address, in the bank SETBNK set)
    lda #$D5
    sta ___cbm_target
    lda #0
    ldx #0
    ldy #0
    jsr __rom_call
    bcs @fail
    ; attic RAM's: copied up from the staging bank, to the same address in
    ; its bank
    ldy __ovl_rec
    lda __ovl_file+2,y
    beq @next
    sta __ovl_job+4         ; destination megabyte
    lda #0
    sta __ovl_job+2         ; source megabyte: chip RAM
    lda __ovl_file+1,y
    and #$0F
    sta __ovl_job+11
    lda __ovl_file+3,y
    sta __ovl_job+14
    lda __ovl_file+4,y
    sta __ovl_job+9
    sta __ovl_job+12
    lda __ovl_file+5,y
    sta __ovl_job+10
    sta __ovl_job+13
    lda __ovl_file+6,y
    sta __ovl_job+7
    lda __ovl_file+7,y
    sta __ovl_job+8
    lda #0
    php
    sei
    sta $D702
    sta $D704
    lda #>__ovl_job
    sta $D701
    lda #<__ovl_job
    sta $D705
    plp
@next:
    lda __ovl_rec
    clc
    adc #8
    sta __ovl_rec
    dec __ovl_n
    bne @file
    rts
@fail:
    ldx #0
@msg:
    lda #$D2                ; CHROUT the message
    sta ___cbm_target
    lda __ovl_msg,x
    phx
    jsr __rom_call
    plx
    inx
    cpx #__ovl_msg_end - __ovl_msg
    bne @msg
    jmp _abort
endproc
