__bas_errtxt:
    .text " error"
    .byte 0
__bas_intxt:
    .text " in "
    .byte 0
; 88.0296919: EXP's largest argument
__bas_explim:
    .byte $87, $30, $0F, $33, $C7

.segment "bss"
.global __bas_n
__bas_n: .res 2
.global __bas_m
__bas_m: .res 2
.global __bas_sa
__bas_sa: .res 2
.global __bas_sb
__bas_sb: .res 2
.global __bas_sr
__bas_sr: .res 2
.global __bas_line
__bas_line: .res 2
__bas_savcol: .res 1
__bas_fx: .res 5
.global __bas_fa
__bas_fa: .res 4
; TRAP / RESUME: the trap on, its line (basic45's code), on again at RESUME,
; an error to resume from, ER, EL, the CPU stack, the code going on at the
; TRAP's line, the statement running and the next (__bas_spc / __bas_snext:
; programs with RESUME), those of the error
.global __bas_trapon
__bas_trapon: .res 1
.global __bas_trapln
__bas_trapln: .res 2
.global __bas_trapre
__bas_trapre: .res 1
.global __bas_pend
__bas_pend: .res 1
.global __bas_er
__bas_er: .res 2
.global __bas_el
__bas_el: .res 2
__bas_sp0: .res 2
.global __bas_trapv
__bas_trapv: .res 2
.global __bas_spc
__bas_spc: .res 2
.global __bas_snext
__bas_snext: .res 2
.global __bas_tron
__bas_tron: .res 1         ; TRON: bit 7 set (TROFF, at the start: clear)
.global __bas_rpc
__bas_rpc: .res 2
.global __bas_rnext
__bas_rnext: .res 2
.global __bas_bankx
__bas_bankx: .res 1
; the channel PRINT# / CMD / INPUT# / GET# use (0: the screen, keyboard);
; the routines for it
.global __bas_chan
__bas_chan: .res 1
__bas_outv: .res 2
__bas_relv: .res 2
__bas_fy: .res 5
