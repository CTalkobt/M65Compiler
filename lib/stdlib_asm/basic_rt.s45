; basic_rt.s45 — the runtime of BASIC 65 programs compiled by basic45 --compile (#369)
;
; The compiled code passes values in these variables (no parameters):
;   __float_a, __float_b  floats (float_rom.s45's: the float routines' own)
;   __bas_n, __bas_m      16-bit integers (a count, a column, an error number)
;   __bas_sa, __bas_sb    strings: a pointer to a length byte and the characters
;   __bas_sr              where a string result goes (a buffer), or the
;                         variable a string is assigned to (basic_str.c)
;   __bas_line            the BASIC line running (for the error message)
;
; Output goes through the KERNAL's BSOUT ($FFD2), as BASIC's PRINT does.
; An error prints BASIC's message ("?DIVISION BY ZERO ERROR IN 30") and ends
; the program: its exit status is the error number.

; no calls through pointers here (ln45's call graph) but __bas_out's and
; __bas_error's to the channel routines (asm, no SAC storage)
.weak cc45.icallinfo
cc45.icallinfo = 1

    .cpu 45gs02

.extern __bp_rom
.extern __rom_calli
.extern __bp_prog
.extern __exit
.extern __irqhook_exit
.extern __float_a
.extern __float_b
.extern __float_str
.extern __float_fout
.extern __float_utof
.extern __float_ltof
.extern __float_cmp
.extern __float_div
.extern __ffast_div
.extern __float_mul
.extern __float_sqr
.extern __float_log
.extern __float_exp
.extern __float_load_fac
.extern __float_load_arg
.extern __float_store_fac
.extern __jsrfar_basic

BSOUT       = $FFD2
PLOT        = $FFF0
BJT_LOG     = $7F2A
BJT_INT     = $7F2D
BJT_FPWRT   = $7F39
BJT_RND     = $7F57

; ---------------------------------------------------------------------------
; Output
; ---------------------------------------------------------------------------

; A character (A) through BSOUT. Keeps X, Y, Z.
    .split "__bas_out"
.global __bas_out
__bas_out:
    pha
    lda __bas_chan
    bne @file
    pla
    phx
    phy
    phz
    jsr __bp_rom
    jsr BSOUT
    jsr __bp_prog
    plz
    ply
    plx
    rts
@file:
    pla
    jmp (__bas_outv)        ; (PRINT# / CMD: __bas_fout, linked with them)

; BASIC's outspc: a cursor right, a space to a file
.global __bas_outspc
__bas_outspc:
    lda __bas_chan
    bne @sp
    lda #29
    bra __bas_out
@sp:
    lda #' '
    bra __bas_out

; PRINT of a string: __bas_sa (through $F6/$F7, library temps of the
; program's base page); __bas_prsa: the string in A/X (#486)
    .split "__bas_prs"
.global __bas_prs
.global __bas_prsa
__bas_prsa:
    sta __bas_sa
    stx __bas_sa+1
__bas_prs:
    lda __bas_sa
    sta $F6
    lda __bas_sa+1
    sta $F7
    ldy #0
    lda ($F6),y
    beq @done
    tax                 ; X = characters left
@loop:
    iny
    lda ($F6),y
    jsr __bas_out
    lda ($F6),y
    cmp #13
    bne @next
    bit __bas_chan          ; (a carriage return to a channel 128-255: and a line feed)
    bpl @next
    lda #10
    jsr __bas_out
@next:
    dex
    bne @loop
@done:
    rts

; PRINT of a number: __float_a as BASIC prints it, then a cursor right
    .split "__bas_prn"
.global __bas_prn
__bas_prn:
    jsr __float_fout
    ldx #0
@loop:
    lda __float_str,x
    beq @done
    jsr __bas_out
    inx
    bra @loop
@done:
    jmp __bas_outspc

; The end of a PRINT without ; or , (a carriage return; to a channel 128-255
; a line feed after it, as BASIC's crfin)
    .split "__bas_prcr"
.global __bas_prcr
__bas_prcr:
    lda #13
    jsr __bas_out
    bit __bas_chan
    bpl @done
    lda #10
    jmp __bas_out
@done:
    rts

; PEEK / WPEEK (__bas_m: 1, 2 bytes) of the address in __bas_fa (32 bits)
; into __bas_n; POKE / WPOKE __bas_n there. As BASIC 65's: above 65535 a
; 28-bit address; below it the bank BANK set (__bas_bankx: the bank XOR
; 128), 128 the CPU's map ((zp),y), another bank its 64 KB ([zp],z)
    .split "__bas_peek"
.global __bas_peek
.global __bas_poke
__bas_peek:
    jsr __bas_where
    bcs @far
    ldy #0
    lda ($F6),y
    sta __bas_n
    lda __bas_m
    lsr a
    bcs @n1
    iny
    lda ($F6),y
    sta __bas_n+1
    rts
@far:
    ldz #0
    lda [$F6],z
    sta __bas_n
    lda __bas_m
    lsr a
    bcs @n1
    inz
    lda [$F6],z
    sta __bas_n+1
    ldz #0
    rts
@n1:
    lda #0
    sta __bas_n+1
    ldz #0
    rts
__bas_poke:
    jsr __bas_where
    bcs @farw
    ldy #0
    lda __bas_n
    sta ($F6),y
    lda __bas_m
    lsr a
    bcs @done
    iny
    lda __bas_n+1
    sta ($F6),y
@done:
    rts
@farw:
    ldz #0
    lda __bas_n
    sta [$F6],z
    lda __bas_m
    lsr a
    bcs @fdone
    inz
    lda __bas_n+1
    sta [$F6],z
@fdone:
    ldz #0
    rts
; $F6-$F9: the address; C: a 28-bit one ([$F6],z), else 16 bits (($F6),y)
__bas_where:
    lda __bas_fa
    sta $F6
    lda __bas_fa+1
    sta $F7
    lda __bas_fa+2
    ora __bas_fa+3
    bne @w32
    lda __bas_bankx
    beq @w16                ; BANK 128: the CPU's map
    eor #$80
    sta $F8                 ; the bank's 64 KB
    lda #0
    sta $F9
    sec
    rts
@w32:
    lda __bas_fa+2
    sta $F8
    lda __bas_fa+3
    sta $F9
    sec
    rts
@w16:
    clc
    rts

; POS(x): the cursor's column into __bas_n
    .split "__bas_pos"
.global __bas_pos
__bas_pos:
    jsr __bas_column
    sta __bas_n
    lda #0
    sta __bas_n+1
    rts

; The cursor's column in A (KERNAL PLOT)
    .split "__bas_column"
__bas_column:
    phz
    jsr __bp_rom
    sec
    jsr PLOT
    jsr __bp_prog
    plz
    tya
    rts

; PRINT's comma: cursor rights to the next column of ten
    .split "__bas_prcomma"
.global __bas_prcomma
__bas_prcomma:
    jsr __bas_column
    sec
@mod:
    sbc #10
    bcs @mod
    eor #$FF
    adc #1
    tax
    jmp __bas_rights        ; (a jmp: a branch would tie the sections together)

; SPC(__bas_n): that many cursor rights
    .split "__bas_prspc"
.global __bas_prspc
__bas_prspc:
    ldx __bas_n
    jmp __bas_rights

; TAB(__bas_n): cursor rights to that column (none if past it)
    .split "__bas_prtab"
.global __bas_prtab
__bas_prtab:
    jsr __bas_column
    sta __bas_m
    lda __bas_n
    sec
    sbc __bas_m
    bcc @past
    tax
    jmp __bas_rights
@past:
    rts
    .split "__bas_rights"
__bas_rights:
    cpx #0
    beq __bas_rights_done
@loop:
    jsr __bas_outspc
    dex
    bne @loop
__bas_rights_done:
    rts

; ---------------------------------------------------------------------------
; Channels (PRINT#, CMD, INPUT#, GET#): the KERNAL's CHKOUT / CHKIN / CLRCH /
; BSOUT through __rom_call (the page-1 stack the disk code needs). The
; channel (BASIC's channl) in __bas_chan; __bas_out and __bas_error reach
; these through __bas_outv / __bas_relv, so programs without files link
; none of it.
; ---------------------------------------------------------------------------

    .split "__bas_chkout"
.global __bas_chkout
.global __bas_chkin
.global __bas_clrch
.global __bas_kerr
; CHKOUT / CHKIN of the logical file __bas_n
__bas_chkout:
    jsr __bas_setch
    jsr __rom_calli
    .word $FFC9
    bcs __bas_kerr
    rts
__bas_chkin:
    jsr __bas_setch
    jsr __rom_calli
    .word $FFC6
    bcs __bas_kerr
    rts
__bas_setch:
    lda #<__bas_fout
    sta __bas_outv
    lda #>__bas_fout
    sta __bas_outv+1
    lda #<__bas_clrch
    sta __bas_relv
    lda #>__bas_clrch
    sta __bas_relv+1
    ldx __bas_n
    stx __bas_chan
    rts
; CLRCH: the screen and keyboard again (channel 0)
__bas_clrch:
    jsr __rom_calli
    .word $FFCC
    lda #0
    sta __bas_chan
    rts
; A character (A) to the channel; X, Y, Z kept
__bas_fout:
    phx
    phy
    phz
    jsr __rom_calli
    .word $FFD2
    plz
    ply
    plx
    bcs __bas_kerr
    rts
; A KERNAL error (A, carry set): its error (0: BREAK), as BASIC's erexit
__bas_kerr:
    cmp #0
    bne @n
    lda #30
@n:
    sta __bas_n
    lda #0
    sta __bas_n+1
    jmp __bas_error

; DLOAD / LOAD in a running program (#369): the next program loaded and run,
; as BASIC 65's load_it / cld70. The load overwrites this program, so a stub
; does it from BASIC's input buffer ($0200; the name at $0280, set by
; basic_io.c's _bas_chainprep with __bas_clen / __bas_cdev / __bas_csa): on
; the caller's page-1 stack and base page 0 (as __exit), SETBNK 0, SETNAM,
; SETLFS, LOAD at $2001 (or, a secondary address given, the file's own);
; then text_top, BASIC's text pointer at the program's start ($2000) and
; the DATA pointer, and back through the SYS: BASIC runs the new program
; from its first line. A load error (the program still here): back to this
; program's stack and base page and its error (__bas_kerr).
    .split "__bas_chain"
.global __bas_chain
.extern __bas_clen
.extern __bas_cdev
.extern __bas_csa
.extern __saved_spl
.extern __saved_sph
.extern __saved_p
.extern __zp_page
__bas_chain:
    jsr __irqhook_exit      ; (the sprites' interrupt hook out: the next program's own)
    lda __saved_spl+1
    sta @spl+1
    lda __saved_sph+1
    sta @sph+1
    lda __saved_p+1
    sta @p+1
    lda __bas_clen
    sta @len+1
    lda __bas_cdev
    sta @dev+1
    lda __bas_csa
    sta @sa+1
    sei
    tsx
    stx @pspl+1
    tsy
    sty @psph+1
    ldx #127                ; (the stub, under 128 bytes)
@copy:
    lda @stub,x
    sta $0200,x
    dex
    bpl @copy
    jmp $0200
@stub:
    lda #0
    tab
    see
@spl:
    ldx #$FF
    txs
@sph:
    ldy #$01
    tys
    cli
    lda #0
    tax
    jsr $FF6B               ; SETBNK 0, 0
@len:
    lda #0
    ldx #$80
    ldy #$02
    jsr $FFBD               ; SETNAM $0280
    lda #0
@dev:
    ldx #8
@sa:
    ldy #0
    jsr $FFBA               ; SETLFS 0, device, secondary
    lda #0
    ldx #$01
    ldy #$20
    jsr $FFD5               ; LOAD at $2001
    bcs @fail
    stx $82                 ; text_top
    sty $83
    lda #0
    sta $3B                 ; txtptr: $2000
    sta $3D
    sta $3E
    sta $43                 ; datptr: $2000
    lda #$20
    sta $3C
    sta $44
@p:
    lda #0
    pha
    plp
    rts                     ; (to the SYS: BASIC goes on at txtptr)
@fail:
    taz                     ; (the KERNAL's error)
    sei
    cle
@pspl:
    ldx #0
    txs
@psph:
    ldy #0
    tys
    lda #>__zp_page
    tab
    cli
    tza
    jmp __bas_kerr

; (a JSR through __bas_relv)
    .split "__bas_jrel"
__bas_jrel:
    jmp (__bas_relv)

; ---------------------------------------------------------------------------
; Errors
; ---------------------------------------------------------------------------

; The error __bas_n in line __bas_line: BASIC's message, then the program
; ends (exit status: the error number); the READY. after it is BASIC's
    .split "__bas_error"
.global __bas_error
__bas_error:
    ; a channel in use (PRINT#, CMD, INPUT#, GET#): released, as BASIC's
    ; release_channels
    lda __bas_chan
    beq @nochan
    jsr __bas_jrel
@nochan:
    ; TRAP set: the error noted (ER, EL, the statement for RESUME), the trap
    ; off until RESUME, the CPU stack as at the start, on at the TRAP's line
    lda __bas_trapon
    beq @show
    lda __bas_n
    cmp #30                 ; (BREAK: STOP is not trapped, as BASIC 65's)
    beq @show
    lda #0
    sta __bas_trapon
    lda #1
    sta __bas_trapre
    sta __bas_pend
    lda __bas_n
    sta __bas_er
    lda #0
    sta __bas_er+1
    lda __bas_line
    sta __bas_el
    lda __bas_line+1
    sta __bas_el+1
    lda __bas_spc
    sta __bas_rpc
    lda __bas_spc+1
    sta __bas_rpc+1
    lda __bas_snext
    sta __bas_rnext
    lda __bas_snext+1
    sta __bas_rnext+1
    jsr __bp_prog
    sei
    ldx __bas_sp0
    ldy __bas_sp0+1
    txs
    tys
    cli
    jmp (__bas_trapv)
@show:
    jsr __bas_gtext         ; (a graphics screen viewed: the text screen, as BASIC's RestoreTextScreen)
    lda #13
    jsr __bas_out
    ; the message in the highlight colour (HIGHLIGHT's errcolor, $02A7), the
    ; text colour ($F1) back after it, as BASIC's highlight_text / _done
    jsr __bp_rom
    lda $F1
    sta __bas_savcol
    lda $02A7
    sta $F1
    jsr __bp_prog
    lda __bas_n
    cmp #30                 ; BREAK: no "?"
    beq @nomark
    lda #'?'
    jsr __bas_out
@nomark:
    lda __bas_n
    jsr __bas_msgptr
    bcs @print              ; (none: "ERROR" alone)
    ldy #0
@msg:
    lda ($F6),y
    and #$7F
    jsr __bas_out
    lda ($F6),y             ; (bit 7: the last character)
    bmi @print
    iny
    bne @msg
@print:
    lda __bas_n
    cmp #30                 ; BREAK: no " ERROR"
    beq @in
    ldx #0
@err:
    lda __bas_errtxt,x
    beq @in
    jsr __bas_out
    inx
    bra @err
@in:
    lda __bas_line          ; (65535: no line recorded, basic45 without
    and __bas_line+1        ; --line-numbers: no " IN line")
    cmp #$FF
    beq @end
    ldx #0
@intxt:
    lda __bas_intxt,x
    beq @num
    jsr __bas_out
    inx
    bra @intxt
@num:
    lda __bas_line
    ldx __bas_line+1
    jsr __float_utof
    jsr __float_fout
    ldx #1                  ; (no leading space)
@digits:
    lda __float_str,x
    beq @end
    jsr __bas_out
    inx
    bra @digits
@end:
    jsr __bp_rom
    lda __bas_savcol
    sta $F1
    jsr __bp_prog
    lda __bas_n
    ldx #0
    jmp __exit

; $F6/$F7 := message A's text in __bas_msgs (C clear), C set for none; its last
; character has bit 7 set (the ROM's form: no number, no terminator)
; the graphics run time's (basic_gfx.c); none linked: nothing to do
    .split "__bas_gtext"
.weak __bas_gtext
__bas_gtext:
    rts

    .split "__bas_msgptr"
.global __bas_msgptr
__bas_msgptr:
    cmp #44+1               ; (1-44)
    bcs @none
    tax
    beq @none
    lda #<__bas_msgs
    sta $F6
    lda #>__bas_msgs
    sta $F7
    ldy #0
@next:
    dex
    beq @found
@skip:
    lda ($F6),y             ; (a message's last character has bit 7 set)
    inw $F6
    ora #0
    bpl @skip
    bra @next
@found:
    clc
    rts
@none:
    sec
    rts

; ERR$(__bas_n) into __bas_sr's buffer: the message, "OK" for none (as BASIC 65's)
    .split "__bas_errs"
.global __bas_errs
__bas_errs:
    lda __bas_sr
    sta $F8
    lda __bas_sr+1
    sta $F9
    lda __bas_n+1
    bne @ok
    lda __bas_n
    beq @ok
    jsr __bas_msgptr
    bcs @ok
    ldy #0
@copy:
    lda ($F6),y
    pha
    and #$7F
    iny
    sta ($F8),y
    pla
    bpl @copy               ; (bit 7: the last character)
    tya
    ldy #0
    sta ($F8),y
    rts
@ok:
    ldy #0
    lda #2
    sta ($F8),y
    iny
    lda #$4F                ; (PETSCII "OK")
    sta ($F8),y
    iny
    lda #$4B
    sta ($F8),y
    rts

; TRAP: the CPU stack the program has after this call (an error goes on there)
    .split "__bas_trapinit"
.global __bas_trapinit
__bas_trapinit:
    tsx
    tsy
    txa
    clc
    adc #2
    sta __bas_sp0
    tya
    adc #0
    sta __bas_sp0+1
    rts

; The error A
    .split "__bas_raise"
.global __bas_raise
__bas_raise:
    sta __bas_n
    lda #0
    sta __bas_n+1
    jmp __bas_error

; ---------------------------------------------------------------------------
; Numbers
; ---------------------------------------------------------------------------

; RND(__float_a) by the ROM's (its seed is the interpreter's). The jump
; table's entry is rnd_arg, which takes the argument's sign (SIGN: $FF, 0, 1)
; in A and its flags (and SIGN's carry): JSRFAR's A ($06) and status ($05: N, Z, C)
    .split "__bas_rnd"
.global __bas_rnd
__bas_rnd:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    lda $05
    and #%01111100          ; N, Z, C clear (C: SIGN's, its rol of the sign bit)
    ldx __float_a
    beq @zero
    ldx #1
    bit __float_a+1
    bpl @set
    ldx #$FF
    ora #%10000001          ; N, C
    bra @set
@zero:
    ora #%00000010          ; Z
@set:
    sta $05
    stx $06
    lda #<BJT_RND
    ldx #>BJT_RND
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

; --speed: the same by the RAM routine (float_fast.s45)
    .split "__bas_fdivx"
.global __bas_fdivx
__bas_fdivx:
    lda __float_b
    beq @zero
    jmp __ffast_div
@zero:
    lda #20
    jmp __bas_raise

; __float_a / __float_b, ?DIVISION BY ZERO when __float_b is 0
    .split "__bas_fdiv"
.global __bas_fdiv
__bas_fdiv:
    lda __float_b
    beq @zero
    jmp __float_div
@zero:
    lda #20
    jmp __bas_raise

; INT(__float_a), the ROM's
    .split "__bas_int"
.global __bas_int
__bas_int:
    lda #<BJT_INT
    ldx #>BJT_INT
    .split "__bas_rom1"
; __float_a := ROM routine A/X (FAC in, FAC out)
__bas_rom1:
    pha
    phx
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_fac
    plx
    pla
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog

; SQR, ?ILLEGAL QUANTITY for a negative number
    .split "__bas_sqr"
.global __bas_sqr
__bas_sqr:
    lda __float_a
    beq @ok
    lda __float_a+1
    bmi @ill
@ok:
    jmp __float_sqr
@ill:
    jmp __bas_illegal

    .split "__bas_illegal"
.global __bas_illegal
__bas_illegal:
    lda #14
    jmp __bas_raise

; LOG, ?ILLEGAL QUANTITY for 0 or a negative number
    .split "__bas_log"
.global __bas_log
__bas_log:
    lda __float_a
    beq @ill
    lda __float_a+1
    bmi @ill
    jmp __float_log
@ill:
    jmp __bas_illegal

; EXP, ?OVERFLOW above 88.0296919 (the ROM's limit)
    .split "__bas_exp"
.global __bas_exp
__bas_exp:
    ldx #4
@b:
    lda __bas_explim,x
    sta __float_b,x
    dex
    bpl @b
    jsr __float_cmp
    cmp #1
    beq @ovf
    jmp __float_exp
@ovf:
    jmp __bas_overflow

    .split "__bas_overflow"
.global __bas_overflow
__bas_overflow:
    lda #15
    jmp __bas_raise

; __float_a ^ __float_b (the ROM's FPWRT: ARG ^ FAC). 0 ^ negative is
; ?DIVISION BY ZERO, a negative number to a power that is not a whole
; number ?ILLEGAL QUANTITY, a result past the float range ?OVERFLOW.
    .split "__bas_pow"
.global __bas_pow
__bas_pow:
    lda __float_b
    beq @rom                ; x ^ 0 = 1
    lda __float_a
    bne @nonzero
    lda __float_b+1
    bmi @divzero
    bra @rom                ; 0 ^ positive = 0
@divzero:
    lda #20
    jmp __bas_raise
@nonzero:
    ; keep a and b
    ldx #4
@keep:
    lda __float_a,x
    sta __bas_fx,x
    lda __float_b,x
    sta __bas_fy,x
    dex
    bpl @keep
    lda __float_a+1
    bpl @range
    ; a < 0: b must be a whole number (INT(b) = b)
    ldx #4
@tb:
    lda __bas_fy,x
    sta __float_a,x
    dex
    bpl @tb
    jsr __bas_int
    ldx #4
@cb:
    lda __bas_fy,x
    sta __float_b,x
    dex
    bpl @cb
    jsr __float_cmp
    cmp #0
    bne @ill
@range:
    ; LOG(|a|) * b above 88: ?OVERFLOW (EXP's limit)
    ldx #4
@la:
    lda __bas_fx,x
    sta __float_a,x
    dex
    bpl @la
    lda __float_a+1
    and #$7F
    sta __float_a+1
    jsr __float_log
    ldx #4
@lb:
    lda __bas_fy,x
    sta __float_b,x
    dex
    bpl @lb
    jsr __float_mul
    ldx #4
@lim:
    lda __bas_explim,x
    sta __float_b,x
    dex
    bpl @lim
    jsr __float_cmp
    cmp #1
    beq @ovf
    ldx #4
@back:
    lda __bas_fx,x
    sta __float_a,x
    lda __bas_fy,x
    sta __float_b,x
    dex
    bpl @back
@rom:
    jsr __bp_rom
    lda #<__float_a
    ldx #>__float_a
    jsr __float_load_arg
    lda #<__float_b
    ldx #>__float_b
    jsr __float_load_fac
    lda #<BJT_FPWRT
    ldx #>BJT_FPWRT
    jsr __jsrfar_basic
    lda #<__float_a
    ldx #>__float_a
    jsr __float_store_fac
    jmp __bp_prog
@ill:
    jmp __bas_illegal
@ovf:
    jmp __bas_overflow

; __float_a to a 16-bit integer in __bas_n, as BASIC's AYINT: rounded down
; (INT), ?ILLEGAL QUANTITY outside -32768..32767
    .split "__bas_ayint"
.global __bas_ayint
__bas_ayint:
    jsr __bas_int
    lda __float_a
    beq @zero
    cmp #$91
    bcs @ill                ; |x| >= 65536
    cmp #$90
    bcc @fits               ; |x| < 32768
    ; |x| in 32768..65535: only -32768
    lda __float_a+1
    cmp #$80
    bne @ill
    lda __float_a+2
    ora __float_a+3
    ora __float_a+4
    bne @ill
    lda #0
    sta __bas_n
    lda #$80
    sta __bas_n+1
    rts
@zero:
    sta __bas_n
    sta __bas_n+1
    rts
@fits:
    ; a whole number now: the mantissa shifted right by 144 - exponent
    lda __float_a+1
    ora #$80
    sta __bas_n+1
    lda __float_a+2
    sta __bas_n
    lda #$90
    sec
    sbc __float_a
    tax
    beq @sign
@shift:
    lsr __bas_n+1
    ror __bas_n
    dex
    bne @shift
@sign:
    lda __float_a+1
    bpl @done
    sec
    lda #0
    sbc __bas_n
    sta __bas_n
    lda #0
    sbc __bas_n+1
    sta __bas_n+1
@done:
    rts
@ill:
    jmp __bas_illegal

; __bas_ayint without the range checks (compiled without --checks, #489):
; INT(__float_a)'s 16 bits in __bas_n for -32768..65535 (AYINT, ayintw,
; GETADR's 0..65535, GETBYT's byte the low one); outside, any value
    .split "__bas_ayintu"
.global __bas_ayintu
__bas_ayintu:
    jsr __bas_int
    lda __float_a
    beq ayu_zero
    cmp #$91
    bcs ayu_zero               ; |x| >= 65536: undefined
    lda __float_a+1
    ora #$80
    sta __bas_n+1
    lda __float_a+2
    sta __bas_n
    lda #$90
    sec
    sbc __float_a
    tax
    beq ayu_sign
ayu_shift:
    lsr __bas_n+1
    ror __bas_n
    dex
    bne ayu_shift
ayu_sign:
    lda __float_a+1
    bpl ayu_done
    sec
    lda #0
    sbc __bas_n
    sta __bas_n
    lda #0
    sbc __bas_n+1
    sta __bas_n+1
ayu_done:
    rts
ayu_zero:
    lda #0
    sta __bas_n
    sta __bas_n+1
    rts

; __bas_getadr32 without the range checks (without --checks, #489): a
; negative address or one of 2^32 or more any value
    .split "__bas_getadr32u"
.global __bas_getadr32u
__bas_getadr32u:
    jsr __bas_int
    lda __float_a
    beq ga32u_zero
    cmp #$A1
    bcs ga32u_zero               ; undefined
    lda __float_a+4
    sta __bas_fa
    lda __float_a+3
    sta __bas_fa+1
    lda __float_a+2
    sta __bas_fa+2
    lda __float_a+1
    ora #$80
    sta __bas_fa+3
    lda #$A0
    sec
    sbc __float_a
    tax
    beq ga32u_done
ga32u_shift:
    lsrq __bas_fa
    dex
    bne ga32u_shift
ga32u_done:
    rts
ga32u_zero:
    lda #0
    sta __bas_fa
    sta __bas_fa+1
    sta __bas_fa+2
    sta __bas_fa+3
    rts

; A whole number 0..65535 for POKE's address, PEEK, WAIT (as GETADR):
; INT(__float_a) into __bas_n, ?ILLEGAL QUANTITY outside it
    .split "__bas_getadr"
.global __bas_getadr
__bas_getadr:
    lda __float_a
    beq @n0
    lda __float_a+1
    bmi @ill
    jsr __bas_int
    lda __float_a
    beq @n0
    cmp #$91
    bcs @ill      ; >= 65536
    lda __float_a+1
    ora #$80
    sta __bas_n+1
    lda __float_a+2
    sta __bas_n
    lda #$90
    sec
    sbc __float_a
    tax
    beq @done
@shift:
    lsr __bas_n+1
    ror __bas_n
    dex
    bne @shift
@done:
    rts
@n0:
    sta __bas_n
    sta __bas_n+1
    rts
@ill:
    jmp __bas_illegal
; __float_a rounded down as a 32-bit address (PEEK / POKE: BASIC 65's getadr,
; 0..2^32-1) into __bas_fa; ?ILLEGAL QUANTITY outside
    .split "__bas_getadr32"
.global __bas_getadr32
__bas_getadr32:
    lda __float_a
    beq @zero
    lda __float_a+1
    bmi @ill
    jsr __bas_int
    lda __float_a
    beq @zero
    cmp #$A1
    bcs @ill      ; >= 2^32
    lda __float_a+4
    sta __bas_fa
    lda __float_a+3
    sta __bas_fa+1
    lda __float_a+2
    sta __bas_fa+2
    lda __float_a+1
    ora #$80
    sta __bas_fa+3
    lda #$A0
    sec
    sbc __float_a
    tax
    beq @done
@shift:
    lsrq __bas_fa
    dex
    bne @shift
@done:
    rts
@zero:
    lda #0
    sta __bas_fa
    sta __bas_fa+1
    sta __bas_fa+2
    sta __bas_fa+3
    rts
@ill:
    jmp __bas_illegal

; A byte 0..255 (POKE's value, CHR$, TAB, SPC): __bas_ayint, then the range
    .split "__bas_getbyt"
.global __bas_getbyt
__bas_getbyt:
    jsr __bas_ayint
    lda __bas_n+1
    bne @ill
    rts
@ill:
    jmp __bas_illegal

; A statement's first code when the program has RESUME: jsr __bas_stmt /
; .word <the next statement> (#369). __bas_spc := the jsr's address (RESUME
; runs the statement again from it), __bas_snext := the word (RESUME NEXT);
; returns past the word. A, X, Y clobbered; $F6/$F7 (library temps)
    .split "__bas_stmt"
.global __bas_stmt
__bas_stmt:
    pla
    sta $F6
    pla
    sta $F7                 ; ($F6): the jsr's last byte
    ldy #1
    lda ($F6),y
    sta __bas_snext
    iny
    lda ($F6),y
    sta __bas_snext+1
    clc                     ; back past the word: ($F6) + 2
    lda $F6
    adc #2
    tax
    lda $F7
    adc #0
    pha
    phx
    sec                     ; the jsr's address: ($F6) - 2
    lda $F6
    sbc #2
    sta __bas_spc
    lda $F7
    sbc #0
    sta __bas_spc+1
    rts

;   jsr __bas_trace / .word line   (a statement's first code with TRON in
; the program, #369): with the trace on (__bas_tron bit 7, TRON / TROFF),
; "[line]" before the statement, as BASIC's token_dispatch (curprt: the
; number without a space). A, X, Y clobbered; $F6-$FB (library temps)
    .split "__bas_trace"
.global __bas_trace
__bas_trace:
    pla
    sta $F6
    pla
    sta $F7                 ; ($F6): the jsr's last byte
    clc                     ; back past the word
    lda $F6
    adc #2
    tax
    lda $F7
    adc #0
    pha
    phx
    bit __bas_tron
    bmi @on
    rts
@on:
    ldy #1
    lda ($F6),y
    sta $F8
    iny
    lda ($F6),y
    sta $F9                 ; the line number
    lda #'['
    jsr __bas_out
    lda #0
    sta $FA                 ; (a digit printed: no more zeros left out)
    ldx #0
@pow:
    ldy #'0'
@sub:
    lda $F8                 ; the number - 10^(4-x), while it does not borrow
    sec
    sbc trace_lo,x
    sta $FB
    lda $F9
    sbc trace_hi,x
    bcc @digit
    sta $F9
    lda $FB
    sta $F8
    iny
    bra @sub
@digit:
    cpy #'0'
    bne @print
    lda $FA
    bne @print
    cpx #4
    bne @next               ; a leading zero (not the last digit)
@print:
    sty $FA
    tya
    jsr __bas_out           ; (keeps X and Y)
@next:
    inx
    cpx #5
    bne @pow
    lda #']'
    jmp __bas_out
trace_lo: .byte <10000, <1000, <100, <10, <1
trace_hi: .byte >10000, >1000, >100, >10, >1

