; basic_call.s45 — __basic_call: run a C function from a BASIC SYS (#322: a
; library member of its own, linked only by programs that have such
; functions -- basic45 --link's thunks name __basic_call and ___bc_target --
; instead of in every program's crt0)

; ln45's call graph: calls through pointers only from __basic_call (cc45.icall.<f>)
.weak cc45.icallinfo
cc45.icallinfo = 1
.weak cc45.icall.__basic_call
cc45.icall.__basic_call = 1

.global __basic_call, ___bc_target, __bc_run
.extern __start, __bc_mode, __bc_done, __saved_spl, __saved_sph, __saved_p
.extern _init_features, __ovl_init

.segment "code"
; __basic_call — run a C function from a BASIC SYS (basic45 --link makes
; a thunk per function: it sets ___bc_target and jumps here). The SYS's
; A, X and Y are the first three parameters ($10, $12, $14 of the program's
; base page, high bytes 0; they also stay in A, X, Y): f(unsigned char a,
; unsigned char x, unsigned char y), or unsigned int. The function runs with the program's
; base page and stack, as main would; its A, X, Y come back to BASIC
; (RREG). The first call fills BSS and calls _init_features, later calls
; keep the globals.
__basic_call:
    sta __bc_a
    stx __bc_x
    sty __bc_y
    lda #1
    sta __bc_mode
    jmp __start

__bc_run:
    lda __bc_done
    bne @ready
    lda #1
    sta __bc_done
    jsr _init_features
    jsr __ovl_init      ; code overlays: load their file (weak: none)
@ready:
    ; the first three parameter slots (2 bytes each, as for a char or int
    ; parameter): A, X, Y with high bytes 0 (base-page stores: the
    ; parameter block is in __zp_page)
    lda #0
    sta $11
    sta $13
    sta $15
    lda __bc_a
    sta $10
    lda __bc_x
    sta $12
    lda __bc_y
    sta $14
    lda ___bc_target
    sta __bc_jsr + 1
    lda ___bc_target + 1
    sta __bc_jsr + 2
    lda __bc_a
    ldx __bc_x
    ldy __bc_y
__bc_jsr:
    jsr $FFFF           ; (patched above)
    sta __bc_a
    stx __bc_x
    sty __bc_y
    ; back to BASIC: base page 0, its 8-bit stack and flags
    lda #0
    tab
    sei
    see
    ldx __saved_spl + 1
    txs
    ldy __saved_sph + 1
    tys
    lda __saved_p + 1
    pha
    lda __bc_a
    ldx __bc_x
    ldy __bc_y
    plp
    rts

; (in the data segment: written before crt0 fills BSS)
.segment "data"
__bc_a:     .byte 0
__bc_x:     .byte 0
__bc_y:     .byte 0
___bc_target: .word 0
