; abort.s — Abnormal program termination (zpCall version)
;
; _Noreturn void abort(void);
;   Weak function — can be overridden by user code for pre-abort hooks.
;   Default implementation calls __abort (BRK).

; no calls through pointers here (ln45's call graph)
.weak cc45.icallinfo
cc45.icallinfo = 1

.weak _abort
.global _abort
.extern __abort

.segment "code"

_abort:
    jmp __abort
