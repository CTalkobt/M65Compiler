; exit.s — Normal program termination (ZP calling convention)
;
; _Noreturn void exit(int status);
;   Weak function — can be overridden for pre-exit hooks.
;
; _Noreturn void _exit(int status);
;   Strong function — always calls __exit directly.

.weak _exit
.global _exit
.global __exit_
.extern __exit

.segment "code"

proc _exit
    .zp_uses $10, $11
    .zp_clobbers $10, $11
    .zp_release $10, $11
    .reg_clobbers A, X

    lda $10
    ldx $11
    jmp __exit
    .func_flags zp_call
    endproc

proc __exit_
    .zp_uses $10, $11
    .zp_clobbers $10, $11
    .zp_release $10, $11
    .reg_clobbers A, X

    lda $10
    ldx $11
    jmp __exit
    .func_flags zp_call
    endproc
