; memcpy.s — Copy memory area (ZP calling convention)
;
; void *memcpy(void *dest, void *src, int n);
;   Copies n bytes from src to dest. Returns dest.

.global _memcpy

.segment "code"

proc _memcpy
    .zp_uses $10, $11, $12, $13, $14, $15
    .zp_clobbers $10, $11, $12, $13, $14, $15
    .zp_release $12, $13, $14, $15
    .reg_clobbers A, X, Y
    .flag_clobbers C, N, Z

    ; dest=$10/$11, src=$12/$13, n=$14/$15
    ldy #0
@loop:
    lda $14
    ora $15
    beq @done
    lda ($12),y
    sta ($10),y
    iny
    bne @no_inc
    inc $11
    inc $13
@no_inc:
    lda $14
    bne @dec_lo
    dec $15
@dec_lo:
    dec $14
    bra @loop
@done:
    lda $10
    ldx $11
    rts
    endproc
