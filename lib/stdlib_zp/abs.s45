; abs.s — Integer absolute value (ZP calling convention)
;
; int abs(int value);
;   Returns the absolute value of a 16-bit signed integer.

.global _abs

.segment "code"

proc _abs
    .zp_uses $10, $11
    .zp_clobbers $10, $11
    .zp_release $10, $11
    .reg_clobbers A, X
    .flag_clobbers C, N, Z

    lda $11             ; check sign (high byte)
    bpl @positive
    ; Negate: complement and add 1
    lda $10
    eor #$FF
    clc
    adc #1
    pha
    lda $11
    eor #$FF
    adc #0
    tax
    pla
    rts
@positive:
    lda $10
    ldx $11
    rts
    endproc
