; setjmp.s — Non-local jumps (ZP calling convention)
;
; int setjmp(jmp_buf env);
;   env pointer in $10/$11.
;   Saves return address and stack pointer into env[0..3].
;   Returns 0.
;
; void longjmp(jmp_buf env, int val);
;   env pointer in $10/$11, val in $12/$13.
;   Restores SP and jumps to saved return address.
;   setjmp appears to return val (or 1 if val==0).
;
; jmp_buf layout: [0] PCL, [1] PCH, [2] SPL, [3] SPH

.global _setjmp
.global _longjmp

.segment "code"

; --- setjmp ---

proc _setjmp
    .zp_uses $10, $11
    .zp_clobbers $10, $11
    .zp_release $10, $11
    .reg_clobbers A, X, Y
    .flag_clobbers C, N, Z

    ; Save return address from hardware stack
    tsx
    lda $0101, x            ; PCL
    ldy #0
    sta ($10), y
    lda $0102, x            ; PCH
    iny
    sta ($10), y

    ; Save SP (16-bit)
    txa
    ldy #2
    sta ($10), y            ; SPL
    tsy
    tya
    iny
    sta ($10), y            ; SPH

    ; Return 0
    lda #0
    tax
    rts
    .func_flags zp_call
    endproc

; --- longjmp ---

proc _longjmp
    .zp_uses $10, $11, $12, $13
    .zp_clobbers $10, $11, $12, $13
    .zp_release $10, $11, $12, $13
    .reg_clobbers A, X, Y, Z
    .flag_clobbers C, N, Z, V

    ; Check val == 0, force to 1
    lda $12
    ora $13
    bne @nonzero
    lda #1
    sta $12
    stz $13
@nonzero:

    ; Restore SPH
    ldy #3
    lda ($10), y
    tay
    tys

    ; Restore SPL
    ldy #2
    lda ($10), y
    tax
    txs

    ; Push saved return address onto hardware stack
    ldy #1
    lda ($10), y            ; PCH
    pha
    dey
    lda ($10), y            ; PCL
    pha

    ; Return val in AX
    lda $12
    ldx $13

    rts
    .func_flags zp_call
    endproc
