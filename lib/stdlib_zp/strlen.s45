; strlen.s — Return length of a NUL-terminated string (ZP calling convention)
;
; int strlen(char *s);
;   Returns the number of bytes before the NUL terminator.
;   Limited to 255 (single-byte Y counter).

.global _strlen

.segment "code"

proc _strlen
    .zp_uses $10, $11
    .zp_clobbers $10, $11
    .zp_release $10, $11
    .reg_clobbers A, X, Y
    .flag_clobbers C, N, Z

    ; s is already at $10/$11
    ldy #0
@loop:
    lda ($10),y
    beq @done
    iny
    bne @loop
@done:
    tya
    ldx #0
    rts
    .func_flags zp_call
    endproc
