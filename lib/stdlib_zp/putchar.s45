; putchar.s — Write a character to screen via KERNAL CHROUT (ZP calling convention)
;
; int putchar(int c);
;   Writes the low byte of c to the screen using KERNAL $FFD2.
;   Returns c.

.global _putchar

.segment "code"

proc _putchar
    .zp_uses $10, $11
    .zp_clobbers $10, $11
    .zp_release $10, $11
    .reg_clobbers A, X, Y, Z
    .flag_clobbers C, N, Z, V

    lda $10
    phz
    jsr $FFD2
    plz
    lda $10
    ldx $11
    rts
    .func_flags zp_call
    endproc
