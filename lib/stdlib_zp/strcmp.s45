; strcmp.s — Compare two strings (ZP calling convention)
;
; int strcmp(char *s1, char *s2);
;   Returns 0 if equal, <0 if s1 < s2, >0 if s1 > s2.

.global _strcmp

.segment "code"

proc _strcmp
    .zp_uses $10, $11, $12, $13
    .zp_clobbers $10, $11, $12, $13
    .zp_release $10, $11, $12, $13
    .reg_clobbers A, X, Y
    .flag_clobbers C, N, Z

    ; s1=$10/$11, s2=$12/$13
    ldy #0
@loop:
    lda ($10),y
    cmp ($12),y
    bne @diff
    lda ($10),y
    beq @equal
    iny
    bne @loop
    inc $11
    inc $13
    bra @loop
@equal:
    lda #0
    tax
    rts
@diff:
    bcs @greater
    lda #$FF
    tax
    rts
@greater:
    lda #1
    ldx #0
    rts
    endproc
