; islower.s — Test if character is lowercase (PETSCII, ZP calling convention)
;
; int islower(int c);
;   Returns 1 if c is lowercase a-z ($41-$5A), 0 otherwise.

.global _islower

.segment "code"

proc _islower
    .zp_uses $10, $11
    .zp_clobbers $10, $11
    .zp_release $10, $11
    .reg_clobbers A, X
    .flag_clobbers C, N, Z

    lda $10
    cmp #$41
    bcc @no
    cmp #$5b
    bcs @no
    lda #1
    ldx #0
    rts
@no:
    lda #0
    ldx #0
    rts
    endproc
