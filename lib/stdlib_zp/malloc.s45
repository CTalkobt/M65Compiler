; malloc.s — Dynamic memory allocation for cc45 / MEGA65 (ZP calling convention)
; Design: Singly-linked sorted free list with coalescing.
;
; Block Header:
;   [Size] (2 bytes) — bit 0 is 1 if allocated, 0 if free.
;   [Next] (2 bytes) — pointer to next free block (only if free).
;
; Internal ZP usage: $10-$0B (after reading params from ZP block)

.global _malloc
.global _free
.global _calloc
.global _realloc
.global _heap_init
.global __heap_ptr
.weak __bss_end
.weak __bss_start
.extern _memcpy
.extern _memset

.segment "bss"
__heap_ptr: .res 2       ; Head of the sorted free list

; Default weak values for BSS if not provided by the compiler
__bss_start = 0
__bss_end = 0

.segment "code"

; -----------------------------------------------------------------------------
; void *malloc(size_t size)
;   size in $10/$11
; -----------------------------------------------------------------------------
proc _malloc
    .zp_uses $10, $11
    .zp_clobbers $10, $11, $12, $13, $14, $15, $16, $17
    .zp_release $10, $11
    .reg_clobbers A, X, Y
    .flag_clobbers C, N, Z

    ; Read size param and move to $16/$17 for working storage
    lda $10
    sta $16
    lda $11
    sta $17

    ; 1. Check for malloc(0)
    lda $16
    ora $17
    bne @non_zero
    jmp @fail

@non_zero:
    ; Adjust: add 2-byte header, align to 2 bytes, min 4
    lda $16
    clc
    adc #2
    tax
    lda $17
    adc #0
    tay
    txa
    and #$FE
    tax
    tya
    bne @size_ok
    cpx #4
    bcs @size_ok
    ldx #4
@size_ok:
    stx $16             ; Req size low
    sty $17             ; Req size high

    ; 2. Ensure initialized
    lda __heap_ptr
    ora __heap_ptr+1
    bne @search
    jsr _heap_init
    lda __heap_ptr
    ora __heap_ptr+1
    beq @fail

@search:
    stz $12             ; prev = 0
    stz $13
    lda __heap_ptr
    sta $10             ; curr = head
    lda __heap_ptr+1
    sta $11

@loop:
    ldy #0
    lda ($10),y
    tax                 ; block size low
    iny
    lda ($10),y
    tay                 ; block size high

    ; Compare (Y:X) with req ($17:$16)
    tya
    cmp $17
    bcc @next
    bne @found
    txa
    cmp $16
    bcc @next

@found:
    ; Found! (Y:X) = current size, ($17:$16) = req size
    ; Check for split: remainder >= 4?
    txa
    sec
    sbc $16
    sta $0B             ; remainder low (using extra ZP)
    tya
    sbc $17
    pha                 ; remainder high (on stack temporarily)

    ora $0B
    beq @exact_match_pop

    pla                 ; remainder high
    pha
    bne @do_split_pop
    lda $0B
    cmp #4
    bcc @exact_match_pop

@do_split_pop:
    pla                 ; remainder high -> use in split
    sta $02             ; stash remainder high in scratch

    ; Split: new free block at curr + req_size
    lda $10
    clc
    adc $16
    sta $14
    lda $11
    adc $17
    sta $15

    ; new_free->size = remainder
    ldy #0
    lda $0B
    sta ($14),y
    iny
    lda $02             ; remainder high
    sta ($14),y

    ; new_free->next = curr->next
    ldy #2
    lda ($10),y
    sta ($14),y
    iny
    lda ($10),y
    sta ($14),y

    ; Update link: prev->next = new_free (or __heap_ptr = new_free)
    lda $12
    ora $13
    bne @update_prev
    lda $14
    sta __heap_ptr
    lda $15
    sta __heap_ptr+1
    bra @mark_used
@update_prev:
    ldy #2
    lda $14
    sta ($12),y
    iny
    lda $15
    sta ($12),y
    bra @mark_used

@exact_match_pop:
    pla                 ; discard remainder high from stack
    ; Remove curr from free list
    ldy #2
    lda ($10),y
    tax
    iny
    lda ($10),y
    tay                 ; Y:X = curr->next

    lda $12
    ora $13
    bne @update_prev_exact
    stx __heap_ptr
    sty __heap_ptr+1
    bra @mark_used
@update_prev_exact:
    ldy #2
    txa
    sta ($12),y
    iny
    tya
    sta ($12),y

@mark_used:
    ; curr->size = req_size | 1
    ldy #0
    lda $16
    ora #1
    sta ($10),y
    iny
    lda $17
    sta ($10),y

    ; Return curr + 2
    lda $10
    clc
    adc #2
    tax
    lda $11
    adc #0
    rts

@next:
    ; prev = curr
    lda $10
    sta $12
    lda $11
    sta $13
    ; curr = curr->next
    ldy #2
    lda ($10),y
    tax
    iny
    lda ($10),y
    stx $10
    sta $11
    ora $10
    bne @loop

@fail:
    lda #0
    tax
    rts
    endproc

; -----------------------------------------------------------------------------
; void free(void *ptr)
;   ptr in $10/$11
; -----------------------------------------------------------------------------
proc _free
    .zp_uses $10, $11
    .zp_clobbers $10, $11, $12, $13, $14, $15, $16, $17
    .zp_release $10, $11
    .reg_clobbers A, X, Y
    .flag_clobbers C, N, Z

    lda $10
    ora $11
    beq @done

    ; curr = ptr - 2
    lda $10
    sec
    sbc #2
    sta $10
    lda $11
    sbc #0
    sta $11

    ; Mark free: curr->size &= ~1
    ldy #0
    lda ($10),y
    and #$FE
    sta ($10),y
    tax                 ; block size low
    iny
    lda ($10),y
    tay                 ; block size high
    stx $16             ; block size low
    sty $17             ; block size high

    ; Find insertion point in sorted list
    stz $12             ; prev = 0
    stz $13
    lda __heap_ptr
    sta $14             ; next_p = head
    lda __heap_ptr+1
    sta $15

@search:
    lda $14
    ora $15
    beq @insert

    ; if (curr < next_p) break
    lda $11
    cmp $15
    bcc @insert
    bne @search_next
    lda $10
    cmp $14
    bcc @insert

@search_next:
    lda $14
    sta $12             ; prev = next_p
    lda $15
    sta $13
    ldy #2
    lda ($14),y
    tax
    iny
    lda ($14),y
    stx $14
    sta $15
    bra @search

@insert:
    ; curr->next = next_p
    ldy #2
    lda $14
    sta ($10),y
    iny
    lda $15
    sta ($10),y

    lda $12
    ora $13
    bne @link_prev
    lda $10
    sta __heap_ptr
    lda $11
    sta __heap_ptr+1
    bra @coalesce_next
@link_prev:
    ldy #2
    lda $10
    sta ($12),y
    iny
    lda $11
    sta ($12),y

@coalesce_next:
    ; if (curr + curr->size == next_p)
    lda $14
    ora $15
    beq @coalesce_prev

    lda $10
    clc
    adc $16
    cmp $14
    bne @coalesce_prev
    lda $11
    adc $17
    cmp $15
    bne @coalesce_prev

    ; curr->size += next_p->size
    ldy #0
    lda ($14),y
    clc
    adc $16
    sta ($10),y
    iny
    lda ($14),y
    adc $17
    sta ($10),y
    ; curr->next = next_p->next
    ldy #2
    lda ($14),y
    sta ($10),y
    iny
    lda ($14),y
    sta ($10),y
    ; Update local size
    ldy #0
    lda ($10),y
    sta $16
    iny
    lda ($10),y
    sta $17

@coalesce_prev:
    ; if (prev + prev->size == curr)
    lda $12
    ora $13
    beq @done

    ldy #0
    lda ($12),y
    tax                 ; prev->size low
    iny
    lda ($12),y
    tay                 ; prev->size high

    txa
    clc
    adc $12
    cmp $10
    bne @done
    tya
    adc $13
    cmp $11
    bne @done

    ; prev->size += curr->size
    ldy #0
    lda ($10),y
    clc
    adc ($12),y
    sta ($12),y
    iny
    lda ($10),y
    adc ($12),y
    sta ($12),y

    ; prev->next = curr->next
    ldy #2
    lda ($10),y
    sta ($12),y
    iny
    lda ($10),y
    sta ($12),y

@done:
    rts
    endproc

; -----------------------------------------------------------------------------
; void *calloc(size_t nmemb, size_t size)
;   nmemb=$10/$11, size=$12/$13
; -----------------------------------------------------------------------------
proc _calloc
    .zp_uses $10, $11, $12, $13
    .zp_clobbers $10, $11, $12, $13, $14, $15, $16, $17
    .zp_release $10, $11, $12, $13
    .reg_clobbers A, X, Y
    .flag_clobbers C, N, Z

    ; total = nmemb * size
    ldax $10
    mul.16 .ax, $12
    stax $16            ; save total in $16/$17

    ; malloc(total)
    sta $10
    stx $11
    jsr _malloc
    sta $14             ; save result lo
    stx $15             ; save result hi
    ora $15
    beq @fail

    ; memset(result, 0, total)
    lda $14
    sta $10
    lda $15
    sta $11             ; dest = result
    stz $12             ; c = 0
    stz $13
    lda $16
    sta $14
    lda $17
    sta $15             ; n = total
    jsr _memset

    lda $10             ; memset returns dest
    ldx $11
    rts
@fail:
    lda #0
    tax
    rts
    endproc

; -----------------------------------------------------------------------------
; void *realloc(void *ptr, size_t size)
;   ptr=$10/$11, size=$12/$13
; -----------------------------------------------------------------------------
proc _realloc
    .zp_uses $10, $11, $12, $13
    .zp_clobbers $10, $11, $12, $13, $14, $15, $16, $17
    .zp_release $10, $11, $12, $13
    .reg_clobbers A, X, Y
    .flag_clobbers C, N, Z

    ; Save params
    lda $10
    sta $16             ; ptr lo
    lda $11
    sta $17             ; ptr hi
    lda $12
    sta $14             ; size lo
    lda $13
    sta $15             ; size hi

    ; If ptr is NULL, realloc is malloc
    lda $16
    ora $17
    bne @not_null
    lda $14
    sta $10
    lda $15
    sta $11
    jmp _malloc

@not_null:
    ; If size is 0, realloc is free
    lda $14
    ora $15
    bne @do_realloc
    lda $16
    sta $10
    lda $17
    sta $11
    jmp _free

@do_realloc:
    ; malloc(size)
    lda $14
    sta $10
    lda $15
    sta $11
    jsr _malloc
    sta $12             ; new_ptr lo (reuse $12/$13 for new ptr)
    stx $13
    ora $13
    beq @fail

    ; Get old block size: read header at (ptr - 2)
    lda $16
    sec
    sbc #2
    sta $10
    lda $17
    sbc #0
    sta $11
    ldy #0
    lda ($10),y
    and #$FE
    sec
    sbc #2              ; old_data_size low
    tax
    iny
    lda ($10),y
    sbc #0              ; old_data_size high
    tay                 ; Y:X = old_data_size

    ; count = min(old_data_size, new_size)
    tya
    cmp $15
    bcc @use_old
    bne @use_new
    txa
    cmp $14
    bcc @use_old
@use_new:
    lda $14
    sta $10             ; count lo (reuse $10/$11 for count... wait)
    lda $15
    bra @do_copy_setup
@use_old:
    txa
    sta $10
    tya
@do_copy_setup:
    sta $11             ; count hi in $11, count lo in $10
    ; Now: new_ptr=$12/$13, old_ptr=$16/$17, count=$10/$11
    ; Set up memcpy(new_ptr, old_ptr, count): dest=$10/$11, src=$12/$13, n=$14/$15
    lda $10
    pha                 ; save count lo
    lda $11
    pha                 ; save count hi
    lda $12
    sta $10             ; dest = new_ptr
    lda $13
    sta $11
    lda $16
    sta $12             ; src = old_ptr
    lda $17
    sta $13
    pla
    sta $15             ; n hi
    pla
    sta $14             ; n lo
    ; Save new_ptr before memcpy clobbers $10/$11
    lda $10
    pha
    lda $11
    pha
    jsr _memcpy

    ; free(old_ptr)
    lda $16
    sta $10
    lda $17
    sta $11
    jsr _free

    ; Return new_ptr
    pla
    tax                 ; hi
    pla                 ; lo
    rts
@fail:
    lda #0
    tax
    rts
    endproc

; -----------------------------------------------------------------------------
; Internal: heap initialization
; -----------------------------------------------------------------------------
.weak __heap_start
.weak __heap_end

_heap_init:
    lda #<__heap_start
    sta $10
    lda #>__heap_start
    sta $11

    lda $10
    ora $11
    bne @check_end
    lda #<__bss_end
    sta $10
    lda #>__bss_end
    sta $11

@check_end:
    lda $10
    and #1
    beq @aligned
    inc $10
    bne @aligned
    inc $11
@aligned:

    lda #<__heap_end
    sta $12
    lda #>__heap_end
    sta $13

    lda $12
    ora $13
    bne @calc_size
    lda #$00
    sta $12
    lda #$D0
    sta $13

@calc_size:
    lda $12
    sec
    sbc $10
    tax             ; size low
    lda $13
    sbc $11
    tay             ; size high

    ; Ensure size >= 4
    tya
    bne @init_ok
    cpx #4
    bcs @init_ok
    rts             ; Fail to init

@init_ok:
    ; head = __heap_start
    lda $10
    sta __heap_ptr
    lda $11
    sta __heap_ptr+1

    ; head->size = (Y:X)
    ldy #0
    txa
    sta ($10),y
    iny
    tya
    sta ($10),y

    ; head->next = 0
    lda #0
    ldy #2
    sta ($10),y
    iny
    sta ($10),y

    rts

; Default weak values
__heap_start = 0
__heap_end = 0
