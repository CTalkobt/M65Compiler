; div.s — Integer division with quotient and remainder (ZP calling convention)
;
; div_t div(int numer, int denom);
;   Returns div_t { int quot; int rem; } via hidden return pointer in $10/$11.
;   numer in $12/$13, denom in $14/$15.

.global _div

.segment "code"

proc _div
    .zp_uses $10, $11, $12, $13, $14, $15
    .zp_clobbers $10, $11, $12, $13, $14, $15
    .zp_release $10, $11, $12, $13, $14, $15
    .reg_clobbers A, X, Y
    .flag_clobbers C, N, Z

    ; Save ZP temps
    lda $02
    pha
    lda $16
    pha

    stz $02                 ; numer_neg
    stz $16                 ; quot sign XOR

    ; Absolute value of numerator
    lda $13                 ; high byte
    bpl @numer_pos
    inc $02
    inc $16
    ; Negate
    lda $12
    eor #$FF
    clc
    adc #1
    sta $12
    lda $13
    eor #$FF
    adc #0
    sta $13
@numer_pos:
    ; Save abs(numer) for remainder calculation
    lda $12
    pha
    lda $13
    pha
    ; Store to dividend ($D770)
    lda $12
    sta $D770
    lda $13
    sta $D771
    stz $D772
    stz $D773

    ; Absolute value of denominator
    lda $15                 ; high byte
    bpl @denom_pos
    lda $16
    eor #1
    sta $16
    lda $14
    eor #$FF
    clc
    adc #1
    sta $14
    lda $15
    eor #$FF
    adc #0
    sta $15
@denom_pos:
    lda $14
    sta $D774
    lda $15
    sta $D775
    stz $D776
    stz $D777

@wait:
    bit $D70F
    bne @wait

    ; Quotient
    lda $D76C
    ldx $D76D
    ldy $16
    beq @quot_pos
    eor #$FF
    clc
    adc #1
    pha
    txa
    eor #$FF
    adc #0
    tax
    pla
@quot_pos:
    ldy #0
    sta ($10), y
    iny
    txa
    sta ($10), y

    ; Remainder = abs(numer) - quotient * abs(denom)
    ; Write quotient to $D770 (mult arg1), denom still in $D774
    lda $D76C
    sta $D770
    lda $D76D
    sta $D771
    stz $D772
    stz $D773
    ; Product = quotient * denom at $D778 (combinational)
    ; Remainder = saved_numer - product
    pla                     ; numer hi (pushed second)
    sec
    sbc $D779
    tax
    pla                     ; numer lo (pushed first)
    sbc $D778
    ldy $02
    beq @rem_pos
    eor #$FF
    clc
    adc #1
    pha
    txa
    eor #$FF
    adc #0
    tax
    pla
@rem_pos:
    ldy #2
    sta ($10), y
    iny
    txa
    sta ($10), y

    ; Return pointer in AX
    lda $10
    ldx $11

    ; Restore temps
    pla
    sta $16
    pla
    sta $02
    rts
    .func_flags zp_call
    endproc
