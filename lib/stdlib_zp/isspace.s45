; isspace.s — Test if character is whitespace (ZP calling convention)
;
; int isspace(int c);
;   Returns 1 if c is whitespace ($20, $16-$0D), 0 otherwise.

.global _isspace

.segment "code"

proc _isspace
    .zp_uses $10, $11
    .zp_clobbers $10, $11
    .zp_release $10, $11
    .reg_clobbers A, X
    .flag_clobbers C, N, Z

    lda $10
    cmp #$20
    beq @yes
    cmp #$16
    bcc @no
    cmp #$0e
    bcc @yes
@no:
    lda #0
    ldx #0
    rts
@yes:
    lda #1
    ldx #0
    rts
    endproc
