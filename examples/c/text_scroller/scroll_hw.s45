; scroll_hw.s45 — hardware-level screen helpers for the text scroller
;
; MEGA65 80x25 text screen: screen RAM at $0800, colour RAM at $D800 (rows
; 0-11 lie below $DC00, where the CIAs start unless CRAM2K is set).
;
;   _scroll_line_left  — shift the row at _scroll_ptr left by one character
;   _set_text_color    — fill the colour RAM row at _color_ptr with _fill_color
;   _wait_vsync        — wait for the start of the next frame (raster line 0)
;
; The C side passes arguments through the variables below (as <cbm.h> does),
; so these routines work in both calling conventions.

.cpu _45gs02
.segmentOrder code, data, bss

.global _scroll_line_left
.global _set_text_color
.global _wait_vsync
.global _scroll_ptr
.global _color_ptr
.global _fill_color

COLS = 80
ptr  = $02                  ; base-page pointer (the program's private base page)

.data
_scroll_ptr: .word 0        ; screen RAM address of the row to scroll
_color_ptr:  .word 0        ; colour RAM address of the row to colour
_fill_color: .byte 0

.code

; void scroll_line_left(void)
;   columns 1..79 move to 0..78, column 79 becomes a space
proc _scroll_line_left
    lda _scroll_ptr
    sta ptr
    lda _scroll_ptr+1
    sta ptr+1
    ldy #1
@copy:
    lda (ptr),y
    dey
    sta (ptr),y
    iny
    iny
    cpy #COLS
    bne @copy
    ldy #COLS-1
    lda #$20
    sta (ptr),y
    rts
    endproc

; void set_text_color(void)
;   colour RAM row at _color_ptr := _fill_color
proc _set_text_color
    lda _color_ptr
    sta ptr
    lda _color_ptr+1
    sta ptr+1
    lda _fill_color
    ldy #0
@fill:
    sta (ptr),y
    iny
    cpy #COLS
    bne @fill
    rts
    endproc

; void wait_vsync(void)
;   leave raster line 0 first (at 40 MHz a scroll step can finish within it),
;   then wait for line 0 (bit 8 of the raster, $D011 bit 7, clear)
proc _wait_vsync
@leave:
    lda $d012
    beq @leave
@wait:
    lda $d012
    bne @wait
    lda $d011
    and #$80
    bne @wait
    rts
    endproc
