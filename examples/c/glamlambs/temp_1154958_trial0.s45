    .segment "data"
__str_10:
    .text "#How to play"
    .byte 0
__str_11:
    .byte 0
__str_12:
    .text "*Catch a sheep: walk up, press fire"
    .byte 0
__str_13:
    .text "*Carry it to the salon door"
    .byte 0
__str_14:
    .text " in the right-hand fence"
    .byte 0
__str_15:
    .text "*Style it: wool, lipstick, lashes,"
    .byte 0
__str_16:
    .text " eyeshadow, hats, pearls and more"
    .byte 0
__str_17:
    .text "*Let it go: its lambs inherit"
    .byte 0
__str_18:
    .text " the look"
    .byte 0
__str_19:
    .text "*Farmer Fergus shears full fleeces"
    .byte 0
__str_20:
    .text " (the makeup goes too)."
    .byte 0
__str_21:
    .text " Fire beside him: shoo!"
    .byte 0
__str_22:
    .text "#Scoring"
    .byte 0
__str_23:
    .byte 0
__str_24:
    .text "*Glam lamb: 5 a trait x generation"
    .byte 0
__str_25:
    .text "*On the trend: double points"
    .byte 0
__str_26:
    .text "*All four traits: +50"
    .byte 0
__str_27:
    .text "*Wool sold: 10 a bag, dyed 25"
    .byte 0
__str_28:
    .text "#Styling studio"
    .byte 0
__str_29:
    .text "*No clock, no score: style any"
    .byte 0
__str_30:
    .text " sheep you like, as long as you like"
    .byte 0
__str_31:
    .text "#Controls"
    .byte 0
__str_32:
    .text "*Joystick, cursor keys or WASD"
    .byte 0
__str_33:
    .text "*Fire, Space or Return"
    .byte 0
__str_71:
    .text "A sheep makeover game for the MEGA65"
    .byte 0
__str_72:
    .text "by Kimberly Taylor"
    .byte 0
__str_99:
    .text "Play a season"
    .byte 0
__str_107:
    .text "Styling studio"
    .byte 0
__str_114:
    .text "<> pick  Fire: go  M: music  Stop: quit"
    .byte 0
__str_208:
    .screencode "season"
    .byte 0
__str_215:
    .screencode "is over!"
    .byte 0
__str_216:
    .screencode "lambs born"
    .byte 0
__str_217:
    .screencode "glam lambs"
    .byte 0
__str_218:
    .screencode "lamb points"
    .byte 0
__str_219:
    .screencode "wool bags"
    .byte 0
__str_220:
    .screencode "wool income"
    .byte 0
__str_221:
    .screencode "score"
    .byte 0
__str_222:
    .screencode "high score"
    .byte 0
__str_226:
    .screencode "a new high score!"
    .byte 0
__str_227:
    .screencode "your flock goes to market."
    .byte 0
__str_228:
    .screencode "next season starts afresh"
    .byte 0
__str_229:
    .screencode "with a plain, unstyled flock."
