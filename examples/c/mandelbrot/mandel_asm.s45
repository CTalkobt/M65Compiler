; mandel_asm.s45 — the Mandelbrot iteration in 45GS02 assembly
;
; Fixed point 4.28 in 32 bits (1.0 = $10000000), Q register arithmetic
; (ldq/stq/adcq/sbcq/aslq/lsrq/negq) and the MEGA65 hardware multiplier
; ($D770 x $D774 -> 64-bit product at $D778, unsigned).
;
;   unsigned char mandel_iter(void)
;     z = c; repeat z = z^2 + c until |z|^2 > 4 or mb_maxit iterations;
;     returns the iteration count (mb_maxit: inside the set)
;
; Points in the main cardioid or the period-2 bulb never escape: they are
; recognised before iterating (most of the black area of the whole set,
; which otherwise costs the full limit). With q = (x - 1/4)^2 + y^2:
;   cardioid  q * (q + x - 1/4) <= y^2 / 4
;   bulb      (x + 1)^2 + y^2 <= 1/16
; each tested only inside its bounding box, where every operand of the
; multiplier stays below 2.0.
;
; The C side passes c and the limit in the variables below, so the routine
; works in both calling conventions.

.cpu _45gs02
.segmentOrder code, data, bss

.global _mandel_iter
.global _mb_cr
.global _mb_ci
.global _mb_maxit

MULA = $D770
MULB = $D774
MULP = $D778
MATHBUSY = $D70F

.data
_mb_cr:    .dword 0
_mb_ci:    .dword 0
_mb_maxit: .byte 32

zr:   .dword 0
zi:   .dword 0
zr2:  .dword 0
zi2:  .dword 0
prod: .dword 0
sgn:  .byte 0
n:    .byte 0
ay:   .dword 0            ; |ci|
y2:   .dword 0            ; ci^2
p:    .dword 0            ; cr - 1/4
q:    .dword 0
lhs:  .dword 0

K_ONE:   .dword $10000000 ; 1.0
K_Q:     .dword $04000000 ; 0.25
K_X0:    .dword $F4000000 ; -0.75
K_X1:    .dword $06000000 ; 0.375
K_Y:     .dword $0A900000 ; 0.66
K_BX0:   .dword $EC000000 ; -1.25
K_R2:    .dword $01000000 ; 1/16

.code

; Q := (|Q| * |mul_b|) >> 28 (both below 2.0, so the product is below 2^58)
; the caller stores the other operand's absolute value at MULB first
proc fmul_abs
    stq MULA
@busy:
    bit MATHBUSY          ; bit 6 -> V: the multiplier is busy
    bvs @busy
    ldq MULP+3            ; product bits 24-55
    lsrq
    lsrq
    lsrq
    lsrq                  ; bits 28-59, the top nibble still empty
    stq prod
    lda MULP+7            ; bits 56-59 into the top nibble
    asl
    asl
    asl
    asl
    ora prod+3
    sta prod+3
    ldq prod
    rts
    endproc

proc _mandel_iter
    ldq _mb_ci
    jsr absval
    stq ay
    ; the main cardioid: -0.75 <= x <= 0.375, |y| <= 0.66 first
    sec
    sbcq K_Y
    cpz #$80
    bcc @bulb             ; |y| - 0.66 >= 0
    ldq _mb_cr
    sec
    sbcq K_X0
    cpz #$80
    bcs @iterate          ; x < -0.75: not the cardioid, nor the bulb's box
    ldq K_X1
    sec
    sbcq _mb_cr
    cpz #$80
    bcs @iterate          ; x > 0.375
    ldq ay
    stq MULB
    jsr fmul_abs
    stq y2                ; y^2
    ldq _mb_cr
    sec
    sbcq K_Q
    stq p                 ; x - 1/4
    jsr absval
    stq MULB
    jsr fmul_abs
    clc
    adcq y2
    stq q                 ; q = p^2 + y^2
    clc
    adcq p                ; q + p: negative, so q * (q + p) <= y^2 / 4
    cpz #$80
    bcs @inside
    stq MULB
    ldq q
    jsr fmul_abs
    stq lhs               ; q * (q + p)
    ldq y2
    lsrq
    lsrq                  ; y^2 / 4
    sec
    sbcq lhs
    cpz #$80
    bcc @inside           ; y^2 / 4 - q * (q + p) >= 0
    bra @iterate
@bulb:
    ; the period-2 bulb: -1.25 <= x <= -0.75, |y| <= 0.25
    ldq ay
    sec
    sbcq K_Q
    cpz #$80
    bcc @iterate
    ldq _mb_cr
    sec
    sbcq K_BX0
    cpz #$80
    bcs @iterate
    ldq K_X0
    sec
    sbcq _mb_cr
    cpz #$80
    bcs @iterate
    ldq _mb_cr
    clc
    adcq K_ONE
    jsr absval
    stq MULB
    jsr fmul_abs
    stq lhs               ; (x + 1)^2
    ldq ay
    stq MULB
    jsr fmul_abs
    clc
    adcq lhs
    stq lhs               ; + y^2
    ldq K_R2
    sec
    sbcq lhs
    cpz #$80
    bcc @inside           ; 1/16 - ... >= 0
    bra @iterate
@inside:
    lda _mb_maxit
    ldx #0
    rts
@iterate:
    ldq _mb_cr
    stq zr
    ldq _mb_ci
    stq zi
    lda #0
    sta n
@loop:
    ; |zr| and |zi| below 2.0 ($20000000), else it escaped
    lda zr+3
    bpl @zrpos
    eor #$FF
@zrpos:
    cmp #$20
    bcs @escape
    lda zi+3
    bpl @zipos
    eor #$FF
@zipos:
    cmp #$20
    bcs @escape

    ; zr2 = zr^2
    ldq zr
    jsr absval
    stq MULB
    jsr fmul_abs
    stq zr2
    ; zi2 = zi^2
    ldq zi
    jsr absval
    stq MULB
    jsr fmul_abs
    stq zi2
    ; zr2 + zi2 > 4.0 ($40000000): escaped
    ldq zr2
    clc
    adcq zi2
    cpz #$40
    bcs @escape
    ; t = zr * zi (signed)
    lda #0
    sta sgn
    ldq zi
    jsr absval_sgn
    stq MULB
    ldq zr
    jsr absval_sgn
    jsr fmul_abs
    bit sgn
    bpl @tpos
    negq
@tpos:
    ; zi = 2t + ci
    aslq
    clc
    adcq _mb_ci
    stq zi
    ; zr = zr2 - zi2 + cr
    ldq zr2
    sec
    sbcq zi2
    clc
    adcq _mb_cr
    stq zr
    inc n
    lda n
    cmp _mb_maxit
    bcc @loop
    lda _mb_maxit
    ldx #0
    rts
@escape:
    lda n
    ldx #0
    rts
    endproc

; Q := |Q|
proc absval
    cpz #$80
    bcc @done
    negq
@done:
    rts
    endproc

; Q := |Q|, sgn ^= $80 when it was negative
proc absval_sgn
    cpz #$80
    bcc @done
    negq
    pha
    lda sgn
    eor #$80
    sta sgn
    pla
@done:
    rts
    endproc
