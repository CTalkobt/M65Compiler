; test_fileio_heap_xemu.s45 — heap bounds for test_fileio_xemu.c
;
; Three open files need about 800 bytes of heap (a FILE and a 256-byte
; buffer each). With the stack convention the program ends near $AF00,
; which leaves 256 bytes below the default heap end ($B000, 4 KB under the
; stack top): end the heap 2 KB under the stack top instead.
.global __heap_start
.global __heap_end
__heap_start = 0        ; automatic: __bss_end
__heap_end   = $B800
