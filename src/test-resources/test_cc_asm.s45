; Test: hand-written functions with .func_flags directives
; (a .func_flags record attaches to the global symbol named by `proc name`)
; test_cc_interop.sh assembles this with -c and checks the function
; attribute records nm45 -f shows: zp_add zp_call, zp_mul zp_call + leaf,
; stack_answer stack_call.
;
; ZP convention: parameters in the ZP block from $10 (a at $10/$11, b at
; $12/$13), result in A (low) / X (high).

.cpu _45gs02

    .global zp_add
    .global zp_mul
    .global stack_answer

; int zp_add(int a, int b)
    proc zp_add
    .func_flags zp_call
    lda $10
    clc
    adc $12
    pha
    lda $11
    adc $13
    tax
    pla
    rts
    endproc

; char zp_mul(char a, char b): shift-and-add
    proc zp_mul
    .func_flags zp_call, leaf
    lda #0
    ldx $10
    beq @done
@loop:
    clc
    adc $12
    dex
    bne @loop
@done:
    rts
    endproc

; int stack_answer(void): no parameters, so nothing on the stack to read
    proc stack_answer
    .func_flags stack_call
    lda #42
    ldx #0
    rts
    endproc
