{
  "name": "@m65/cc45-lsp-server",
  "version": "0.2.0",
  "description": "Language Server Protocol server for MEGA65 C compiler (cc45) and assembler (ca45)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc --noEmit -p . && esbuild src/server.ts --bundle --platform=node --target=node18 --format=cjs --sourcemap --outfile=dist/server.js && node -e \"require('fs').cpSync('data','dist/data',{recursive:true})\"",
    "gen-data": "node scripts/gen-data.mjs",
    "watch": "esbuild src/server.ts --bundle --platform=node --target=node18 --format=cjs --sourcemap --outfile=dist/server.js --watch",
    "lint": "eslint src/**/*.ts",
    "test": "node scripts/test.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "lsp",
    "language-server",
    "cc45",
    "ca45",
    "mega65",
    "6502"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "m65-lsp": "dist/server.js"
  }
}
