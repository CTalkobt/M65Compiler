{
  "name": "mega65-cc45-ca45",
  "displayName": "MEGA65 CC45/CA45 Compiler",
  "description": "Language support and a debugger for the MEGA65 C compiler (cc45) and assembler (ca45)",
  "version": "0.1.0",
  "type": "module",
  "publisher": "m65",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CTalkobt/M65Compiler"
  },
  "homepage": "https://github.com/CTalkobt/M65Compiler/tree/main/tools/ide",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Debuggers"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc && esbuild src/extension.ts --bundle --platform=node --target=es2020 --external:vscode --outfile=dist/extension.js",
    "watch": "tsc --watch",
    "lint": "eslint src/**/*.ts",
    "package": "npx @vscode/vsce package"
  },
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:h",
    "onLanguage:m65-asm",
    "onDebugResolve:cc45",
    "onDebugDynamicConfigurations:cc45"
  ],
  "contributes": {
    "languages": [
      {
        "id": "c",
        "extensions": [
          ".c"
        ],
        "aliases": [
          "C"
        ]
      },
      {
        "id": "h",
        "extensions": [
          ".h"
        ],
        "aliases": [
          "C Header"
        ]
      },
      {
        "id": "m65-asm",
        "extensions": [
          ".s45",
          ".asm"
        ],
        "aliases": [
          "MEGA65 Assembly",
          "45GS02 Assembly"
        ],
        "configuration": "./language-configuration/m65-asm.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "m65-asm",
        "scopeName": "source.m65-asm",
        "path": "./syntaxes/m65-asm.tmLanguage.json"
      }
    ],
    "configuration": [
      {
        "title": "MEGA65 Compiler Settings",
        "properties": {
          "m65.cc45Path": {
            "type": "string",
            "default": "${workspaceFolder}/bin/cc45",
            "description": "Path to the cc45 compiler binary"
          },
          "m65.ca45Path": {
            "type": "string",
            "default": "${workspaceFolder}/bin/ca45",
            "description": "Path to the ca45 assembler binary"
          },
          "m65.diagnostics.debounceMs": {
            "type": "number",
            "default": 500,
            "description": "Debounce delay in milliseconds for diagnostic runs on file changes"
          },
          "m65.indexer.exclude": {
            "type": "array",
            "default": [
              "node_modules",
              ".git",
              "bin",
              "obj",
              "build"
            ],
            "description": "Glob patterns to exclude from workspace indexing"
          },
          "m65.dbg45Path": {
            "type": "string",
            "default": "${workspaceFolder}/bin/dbg45",
            "description": "Path to dbg45, the debugger (it runs the program in xemu)"
          }
        }
      }
    ],
    "breakpoints": [
      {
        "language": "c"
      },
      {
        "language": "m65-asm"
      }
    ],
    "debuggers": [
      {
        "type": "cc45",
        "label": "MEGA65 (cc45 in xemu)",
        "languages": [
          "c",
          "m65-asm"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The program (.prg) to debug; its debug file (.dbg) next to it: build with cc45 -g / ln45 -g",
                "default": "${workspaceFolder}/program.prg"
              },
              "xemu": {
                "type": "string",
                "description": "The xemu to run (it needs the monitor's breakpoint list: CTalkobt/xemu, branch monitor-breakpoints); default xemu-xmega65"
              },
              "xemuArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "More of xemu's options (a disk: [\"-8\", \"disk.d81\"])",
                "default": []
              },
              "headless": {
                "type": "boolean",
                "description": "Run xemu without a window",
                "default": false
              },
              "fast": {
                "type": "boolean",
                "description": "Run xemu as fast as it can (-sleepless)",
                "default": false
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at main",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "cc45",
            "request": "launch",
            "name": "Debug in xemu",
            "program": "${workspaceFolder}/program.prg",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "MEGA65: debug a cc45 program in xemu",
            "description": "dbg45 runs the program in xemu",
            "body": {
              "type": "cc45",
              "request": "launch",
              "name": "Debug in xemu",
              "program": "^\"\\${workspaceFolder}/${1:program}.prg\"",
              "stopOnEntry": true
            }
          }
        ]
      }
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.7.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  }
}
